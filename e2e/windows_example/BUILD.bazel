load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_dart//dart:defs.bzl", "dart_analysis_options", "dart_analyze_test", "dart_format_test", "dart_test")
load("@rules_flutter//flutter:defs.bzl", "flutter_application", "flutter_library")
load(
    "@rules_flutter//flutter:windows.bzl",
    "flutter_windows_app",
    "flutter_windows_bundle",
    "flutter_windows_engine",
    "flutter_windows_registrant_gen",
    "flutter_windows_runner_lib_gen",
)

exports_files(["pubspec.lock"])

flutter_application(
    name = "app_flutter",
    package_name = "windows_example",
    main = "lib/main.dart",
    deps = [
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",
    ],
)

# =============================================================================
# Shared Tier 2 targets (used by approaches 2 & 3)
# =============================================================================

# Marked Windows-only like every other target here: on a non-Windows host the
# resolved toolchain has no flutter_windows.dll and the rule hard-fails during
# analysis, which makes `bazel test //...` on macOS an error rather than a
# skip.
flutter_windows_engine(
    name = "flutter_engine",
    target_compatible_with = ["@platforms//os:windows"],
)

flutter_windows_registrant_gen(
    name = "app_registrant",
    application = ":app_flutter",
)

# =============================================================================
# Approach 1: Flutter-generated runner (flutter_windows_app)
#
# Recommended for most users. Requires windows/runner/ from `flutter create`.
# =============================================================================

flutter_windows_app(
    name = "app",
    application = ":app_flutter",
    target_compatible_with = ["@platforms//os:windows"],
)

# =============================================================================
# Approach 2: Bazel-generated runner (flutter_windows_runner_lib_gen)
# =============================================================================

flutter_windows_runner_lib_gen(
    name = "bazel_runner",
    engine = ":flutter_engine",
    registrant = ":app_registrant",
)

flutter_windows_bundle(
    name = "app_bazel_runner",
    application = ":app_flutter",
    runner = ":bazel_runner",
    tags = ["manual"],
)

# =============================================================================
# Approach 3: Custom runner (cc_binary from rules_cc)
#
# flutter_windows_engine provides CcInfo so cc_binary can depend on it.
# System libs (user32.lib, ole32.lib) come from the CC toolchain (MSVC).
# =============================================================================

cc_binary(
    name = "custom_runner_bin",
    srcs = [
        "custom_runner/custom_runner.cc",
        ":app_registrant",
    ],
    linkopts = [
        "/SUBSYSTEM:WINDOWS",
        "user32.lib",
        "ole32.lib",
    ],
    tags = ["manual"],
    deps = [":flutter_engine"],
)

flutter_windows_bundle(
    name = "app_custom_runner",
    application = ":app_flutter",
    runner = ":custom_runner_bin",
    tags = ["manual"],
)

# =============================================================================
# Tests
# =============================================================================

build_test(
    name = "windows_app_build_test",
    target_compatible_with = ["@platforms//os:windows"],
    targets = [":app"],
)

build_test(
    name = "windows_bazel_runner_build_test",
    target_compatible_with = ["@platforms//os:windows"],
    targets = [":app_bazel_runner"],
)

build_test(
    name = "windows_custom_runner_build_test",
    target_compatible_with = ["@platforms//os:windows"],
    targets = [":app_custom_runner"],
)

dart_test(
    name = "verify_windows_bundle_test",
    data = [":app"],
    main = "test/verify_windows_bundle_test.dart",
    target_compatible_with = ["@platforms//os:windows"],
)

# The workspace's lint ruleset, bundled with the pub package whose YAML its
# `include:` resolves against. Named here rather than in a library's `deps`: a
# lint ruleset is not a dependency of the code it lints, and listing it there
# carries it into the `DartInfo` of every binary and test downstream.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@deps//:very_good_analysis"],
)

# Static analysis over this example's Dart. The app rule is a bundle and
# carries no DartInfo, so the sources are declared once more as a library for
# the analyzer to stage. sky_engine supplies lib/_embedder.yaml, the only way
# `dart:ui` resolves.
flutter_library(
    name = "app_lib",
    package_name = "windows_example",
    srcs = glob(["lib/**/*.dart"]),
    deps = [
        "@deps//:flutter",
        "@flutter_sky_engine//:sky_engine",
        "@rules_flutter//flutter:material_icons",
    ],
)

dart_analyze_test(
    name = "app_analyze_test",
    size = "small",
    lib = ":app_lib",
    options = ":options",
)

# Static analysis of the test sources beside the app's Dart.
# `app_analyze_test` above covers `:app_lib` and its whole
# first-party closure — dependency packages included — but a test's `main`
# belongs to no package's `lib/`, so nothing in that closure can name it.
#
# Compiling a test's `main` to a kernel rejects broken code but is indifferent
# to everything `dart analyze --fatal-infos` reports.
#
# `options`: these hold to the same very_good_analysis bar as the app code,
# rather than the SDK default. The one rule that does not fit a diagnostic
# script is `avoid_print` — writing what it found to the test log is the
# script's product, not a stray debug statement — and the scripts that print
# disable exactly that rule per-file, with the reason above the
# `ignore_for_file` (which `document_ignores` requires).
[dart_analyze_test(
    name = "%s_analyze" % t,
    size = "small",
    options = ":options",
    target = ":%s" % t,
) for t in [
    "verify_windows_bundle_test",
]]

# All of this workspace's Dart, checked against the same `:options` the
# analyze tests above use.
dart_format_test(
    name = "format_test",
    size = "small",
    srcs = glob([
        "lib/**/*.dart",
        "test/**/*.dart",
    ]),
    # Matches this workspace's `pubspec.yaml` (`sdk: ^3.12.0`); the rule's
    # `latest` default would enforce a style `dart format` here cannot
    # produce. See docs/TESTING.md.
    language_version = "3.12",
    options = ":options",
)

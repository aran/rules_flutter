load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_apple//apple:versioning.bzl", "apple_bundle_version")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("@rules_dart//dart:defs.bzl", "dart_analysis_options", "dart_analyze_test", "dart_format_test", "dart_test")
load("@rules_flutter//flutter:defs.bzl", "flutter_application", "flutter_library")
load(
    "@rules_flutter//flutter:macos.bzl",
    "MACOS_MINIMUM_OS_VERSION",
    "flutter_macos_app",
    "flutter_macos_engine",
    "flutter_macos_framework_gen",
    "flutter_macos_info_plist_gen",
    "flutter_macos_menu_xib_gen",
    "flutter_macos_native_libs_gen",
    "flutter_macos_registrant_gen",
    "flutter_macos_runner_lib_gen",
)
load("@rules_swift//swift:swift.bzl", "swift_library")

exports_files(["pubspec.lock"])

# =============================================================================
# Shared: Flutter application + native plugin
# =============================================================================

cc_library(
    name = "add_cc",
    srcs = ["native/add.c"],
    hdrs = ["native/add.h"],
)

cc_shared_library(
    name = "add",
    visibility = ["//packages/add_plugin:__pkg__"],
    deps = [":add_cc"],
)

_APP_DEPS = [
    "//packages/add_plugin",
    "@deps//:flutter",
    "@rules_flutter//flutter:material_icons",
]

# The workspace's lint ruleset, bundled with the pub package whose YAML its
# `include:` resolves against. Named here rather than in a library's `deps`: a
# lint ruleset is not a dependency of the code it lints, and listing it there
# carries it into the `DartInfo` of every binary and test downstream.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    visibility = ["//packages/add_plugin:__pkg__"],
    deps = ["@deps//:very_good_analysis"],
)

# The app's Dart, as a library, so the analyzer has something to stage.
# `flutter_application` is a bundle rather than a Dart package and carries no
# DartInfo, so it cannot be analyzed directly.
flutter_library(
    name = "app_lib",
    package_name = "macos_example",
    srcs = glob(["lib/**/*.dart"]),
    deps = _APP_DEPS + [
        # Supplies `lib/_embedder.yaml`, the only way the analyzer resolves
        # `dart:ui`. Without it every Flutter import fails to resolve.
        "@flutter_sky_engine//:sky_engine",
    ],
)

dart_analyze_test(
    name = "app_analyze_test",
    size = "small",
    lib = ":app_lib",
    options = ":options",
)

flutter_application(
    name = "app_flutter",
    package_name = "macos_example",
    # A first-party asset, so the dev loop's asset reload has something real to
    # deliver. asset_reload_e2e_test edits assets/message.txt while the app
    # runs and asserts the change reaches the UI.
    assets = glob(["assets/**"]),
    main = "lib/main.dart",
    deps = _APP_DEPS,
)

# =============================================================================
# Shared macOS targets (used by approaches 2 & 3)
# =============================================================================

flutter_macos_framework_gen(
    name = "app_framework",
    application = ":app_flutter",
)

flutter_macos_registrant_gen(
    name = "app_registrant",
    application = ":app_flutter",
)

flutter_macos_native_libs_gen(
    name = "app_native_libs",
    application = ":app_flutter",
)

flutter_macos_engine(
    name = "flutter_engine",
)

# Shared version and Info.plist for approaches 2 & 3.
apple_bundle_version(
    name = "app_version",
    build_version = "1.0",
    short_version_string = "1.0",
    tags = ["manual"],
)

flutter_macos_info_plist_gen(
    name = "app_info_plist",
    app_name = "Flutter App",
)

# =============================================================================
# Approach 1: Flutter-generated runner (flutter_macos_app)
#
# Recommended for most users. Requires macos/Runner/ from `flutter create`.
# The macro auto-discovers Swift files, processes XIB (strips
# customModuleProvider="target"), resolves Xcode plist variables, and wires
# everything automatically. Fully self-contained — does NOT reuse shared targets.
# =============================================================================

flutter_macos_app(
    name = "app",
    # Capabilities the app needs in *both* configurations. The macro picks
    # DebugProfile.entitlements for `-c dbg` and Release.entitlements
    # otherwise, and `flutter create` only writes the network keys into the
    # debug one — so without this the release bundle is sandboxed with no
    # network access, silently. Verified from the built bundle's codesign
    # blob by :verify_macos_entitlements_test.
    additional_entitlements = ["entitlements/Network.entitlements"],
    app_name = "Flutter App",
    application = ":app_flutter",
    bundle_id = "com.example.flutterapp",
    target_compatible_with = ["@platforms//os:macos"],
)

# A second app in the same package. Regression guard: each app's runner
# compiles into its own Swift module, so two of them can be built in one
# invocation. Sharing module_name = "Runner" would make both write
# <pkg>/Runner.swiftmodule and fail analysis with an action conflict.
flutter_macos_app(
    name = "app_second",
    app_name = "Flutter App Second",
    application = ":app_flutter",
    bundle_id = "com.example.flutterapp.second",
    target_compatible_with = ["@platforms//os:macos"],
)

# =============================================================================
# Approach 2: Bazel-generated runner (flutter_macos_runner_lib_gen)
#
# For users without `flutter create` output. Uses template files from
# rules_flutter. Only needs app_name. User manually wires macos_application.
# =============================================================================

flutter_macos_menu_xib_gen(
    name = "bazel_runner_menu_xib",
    app_name = "Flutter App",
)

flutter_macos_runner_lib_gen(
    name = "bazel_runner_lib",
    engine = ":flutter_engine",
    module_name = "BazelRunner",
    registrant = ":app_registrant",
)

macos_application(
    name = "app_bazel_runner",
    additional_contents = {
        ":app_framework": "Frameworks",
        ":app_native_libs": "Frameworks",
    },
    bundle_id = "com.example.flutterapp.bazelrunner",
    infoplists = [":app_info_plist"],
    minimum_os_version = MACOS_MINIMUM_OS_VERSION,
    resources = [":bazel_runner_menu_xib"],
    tags = ["manual"],
    version = ":app_version",
    deps = [":bazel_runner_lib"],
)

# =============================================================================
# Approach 3: Custom runner (manual swift_library)
#
# For advanced users who want full control. User writes their own
# AppDelegate/MainFlutterWindow, creates a swift_library with the registrant
# from flutter_macos_registrant_gen, and wires into macos_application.
# =============================================================================

flutter_macos_menu_xib_gen(
    name = "custom_runner_menu_xib",
    app_name = "Custom Runner Example",
)

swift_library(
    name = "custom_runner_lib",
    srcs = [
        "custom_runner/AppDelegate.swift",
        "custom_runner/MainFlutterWindow.swift",
        ":app_registrant",
    ],
    # Free to be anything: the @objc annotations on AppDelegate and
    # MainFlutterWindow give them unmangled ObjC class names, so the XIB
    # resolves them regardless of Swift module.
    module_name = "CustomRunner",
    tags = ["manual"],
    deps = [":flutter_engine"],
)

macos_application(
    name = "app_custom_runner",
    additional_contents = {
        ":app_framework": "Frameworks",
        ":app_native_libs": "Frameworks",
    },
    bundle_id = "com.example.flutterapp.customrunner",
    infoplists = [":app_info_plist"],
    minimum_os_version = MACOS_MINIMUM_OS_VERSION,
    resources = [":custom_runner_menu_xib"],
    tags = ["manual"],
    version = ":app_version",
    deps = [":custom_runner_lib"],
)

# =============================================================================
# Tests
# =============================================================================

build_test(
    name = "macos_app_build_test",
    target_compatible_with = ["@platforms//os:macos"],
    targets = [":app"],
)

# Both apps in one build_test: a per-package module-name collision is an
# analysis-time action conflict, so it fails here rather than at runtime.
build_test(
    name = "macos_two_apps_one_package_build_test",
    target_compatible_with = ["@platforms//os:macos"],
    targets = [
        ":app",
        ":app_second",
    ],
)

build_test(
    name = "macos_bazel_runner_build_test",
    target_compatible_with = ["@platforms//os:macos"],
    targets = [":app_bazel_runner"],
)

build_test(
    name = "macos_custom_runner_build_test",
    target_compatible_with = ["@platforms//os:macos"],
    targets = [":app_custom_runner"],
)

dart_test(
    name = "verify_macos_bundle_test",
    data = [":app"],
    main = "test/verify_macos_bundle_test.dart",
    target_compatible_with = ["@platforms//os:macos"],
)

# Reads the entitlements blob codesign embedded in the built bundle. Bazel's
# default fastbuild is not `-c dbg`, so this bundle carries the *release*
# entitlements — finding the network keys proves additional_entitlements
# survived into the arm where flutter create grants nothing.
dart_test(
    name = "verify_macos_entitlements_test",
    data = [":app"],
    main = "test/verify_macos_entitlements_test.dart",
    target_compatible_with = ["@platforms//os:macos"],
)

dart_test(
    name = "verify_macos_app_test",
    data = [":app"],
    main = "test/verify_macos_app_test.dart",
    tags = [
        "exclusive",
        "manual",
    ],
    target_compatible_with = ["@platforms//os:macos"],
)

# Static analysis of the test sources beside the app's Dart.
# `app_analyze_test` above covers `:app_lib` and its whole
# first-party closure — dependency packages included — but a test's `main`
# belongs to no package's `lib/`, so nothing in that closure can name it.
#
# Compiling a test's `main` to a kernel rejects broken code but is indifferent
# to everything `dart analyze --fatal-infos` reports.
#
# `options`: these hold to the same very_good_analysis bar as the app code,
# rather than the SDK default. The one rule that does not fit a diagnostic
# script is `avoid_print` — writing what it found to the test log is the
# script's product, not a stray debug statement — and the scripts that print
# disable exactly that rule per-file, with the reason above the
# `ignore_for_file` (which `document_ignores` requires).
[dart_analyze_test(
    name = "%s_analyze" % t,
    size = "small",
    options = ":options",
    target = ":%s" % t,
) for t in [
    "verify_macos_app_test",
    "verify_macos_bundle_test",
    "verify_macos_entitlements_test",
]]

# Every `.dart` file directly in this package — `packages/add_plugin` carries
# its own `format_test`.
dart_format_test(
    name = "format_test",
    size = "small",
    srcs = glob([
        "lib/**/*.dart",
        "test/**/*.dart",
    ]),
    # Matches this workspace's `pubspec.yaml` (`sdk: ^3.12.0`); the rule's
    # `latest` default would enforce a style `dart format` here cannot
    # produce. See docs/TESTING.md.
    language_version = "3.12",
    options = ":options",
)

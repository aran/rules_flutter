# How native code reaches a Flutter app, each way in a package of its own:
#
#   //add_plugin        a Native Assets code asset, bound with `@Native`
#   //mul_plugin        `native_deps` alone, opened by its per-platform path
#   //multiply_plugin   `native_deps` and a `dart_plugin_class`, statically
#                       linked on iOS (the app is `//plugin_class`)
#   //sub_asset, //prebuilt_asset, //count_a, //count_b
#                       code assets from a wrapper rule, a prebuilt file and one
#                       library bound under two ids
#   //chain_asset       two code assets, one linking the other
#   //pick              code assets and the link hook that drops one
#
# The app below uses all of them but `//multiply_plugin`, and this file builds
# its bundles on every platform, with the runtime tests that load the libraries.
# Hot patching of `mul`, `sub` and `counter` is further down.

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_apple//apple:ios.bzl", "ios_application")
load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("@rules_dart//dart:defs.bzl", "dart_analysis_config", "dart_analysis_options", "dart_analysis_test", "dart_binary", "dart_code_asset", "dart_test")
load("@rules_flutter//flutter:defs.bzl", "dart_package_metadata", "flutter_application", "flutter_library", "flutter_native_library")
load(
    "@rules_flutter//flutter:ios.bzl",
    "IOS_DEFAULT_LAUNCH_STORYBOARD",
    "IOS_MINIMUM_OS_VERSION",
    "flutter_ios_app_framework_gen",
    "flutter_ios_dropped_frameworks_gen",
    "flutter_ios_engine",
    "flutter_ios_info_plist_gen",
    "flutter_ios_native_frameworks_gen",
    "flutter_ios_registrant_gen",
    "flutter_ios_runner_lib_gen",
    "flutter_ios_simulator_build",
)
load("@rules_flutter//flutter:linux.bzl", "flutter_linux_app")
load(
    "@rules_flutter//flutter:macos.bzl",
    "MACOS_MINIMUM_OS_VERSION",
    "flutter_apple_bundle_version",
    "flutter_macos_app_framework_gen",
    "flutter_macos_engine",
    "flutter_macos_info_plist_gen",
    "flutter_macos_menu_xib_gen",
    "flutter_macos_native_libs_gen",
    "flutter_macos_registrant_gen",
    "flutter_macos_runner_lib_gen",
    "flutter_macos_xcframeworks",
)
load("@rules_flutter//flutter:windows.bzl", "flutter_windows_app")
load("@rules_flutter//tools/e2e_testing:apple_release_build.bzl", "apple_release_build")
load(":c_hot_patch.bzl", "c_hot_patch")
load(":code_asset.bzl", "stand_in_code_asset")
load(":ios_sim_debug.bzl", "ios_sim_debug_app")
load(":prebuilt_library.bzl", "prebuilt_library")

exports_files(["pubspec.lock"])

cc_library(
    name = "add_cc",
    srcs = ["native/add.c"],
    hdrs = ["native/add.h"],
)

cc_shared_library(
    name = "add",
    visibility = ["//add_plugin:__pkg__"],
    deps = [":add_cc"],
)

# `multiply` belongs to `//multiply_plugin`, a plugin that also has a Dart
# plugin class; `//plugin_class` is the app that uses it, which on iOS links
# `:multiply_cc` statically.
cc_library(
    name = "multiply_cc",
    srcs = ["native/multiply.c"],
    hdrs = ["native/multiply.h"],
    visibility = ["//plugin_class:__pkg__"],
    # alwayslink ensures the linker keeps symbols even when only
    # referenced via dart:ffi (no static ObjC/Swift references).
    alwayslink = True,
)

cc_shared_library(
    name = "multiply",
    visibility = [
        "//multiply_plugin:__pkg__",
        "//plugin_class:__pkg__",
    ],
    deps = [":multiply_cc"],
)

# `mul` is patchable in a running app: `native/mul_hot_patch.c` routes every
# call through a pointer a patch can move, and `:mul_native` tells the dev tool
# how patches are built. An edit to `native/mul.c` then reaches a running app on
# a hot reload; an edit to `native/mul.h` answers that a restart is needed.
cc_library(
    name = "mul_body_cc",
    srcs = ["native/mul.c"],
    hdrs = [
        "native/mul.h",
        "native/mul_body.h",
    ],
)

cc_library(
    name = "mul_cc",
    srcs = ["native/mul_hot_patch.c"],
    # `dlopen` lives in libdl on glibc before 2.34; Apple, bionic and newer
    # glibc need nothing, and Windows loads through kernel32.
    linkopts = select({
        "@platforms//os:linux": ["-ldl"],
        "//conditions:default": [],
    }),
    textual_hdrs = ["native/hot_patch_router.h"],
    deps = [":mul_body_cc"],
)

cc_shared_library(
    name = "mul",
    deps = [":mul_cc"],
)

# The patch: `native/mul.c` built on its own, beside the library the app runs.
cc_shared_library(
    name = "mul_patch",
    deps = [":mul_body_cc"],
)

dart_binary(
    name = "c_patch_tool",
    main = "tools/c_patch_tool.dart",
)

c_hot_patch(
    name = "mul_hot_patch",
    body = "native/mul.c",
    contract = "native/mul.h",
    function = "mul_body",
    library = ":mul",
    patch_library = ":mul_patch",
    sources = [
        "native/mul.c",
        "native/mul.h",
        "native/mul_body.h",
    ],
    tool = ":c_patch_tool",
)

flutter_native_library(
    name = "mul_native",
    binding_contract = ["native/mul.h"],
    hot_patch = ":mul_hot_patch",
    library = ":mul",
    visibility = ["//mul_plugin:__pkg__"],
)

# `sub` is patchable the same way, and reaches the app the way a bridge
# generator's library does: as a Dart code asset, from a rule that is not
# rules_dart's (`code_asset.bzl`), on a `dart_library` that owns its asset id
# (`//sub_asset`), and called through `@Native`. The wrapper goes in that
# package's `code_assets`, where the bare asset would have gone, and an edit to
# `native/sub.c` reaches a running app on a hot reload exactly as one to
# `native/mul.c` does.
cc_library(
    name = "sub_body_cc",
    srcs = ["native/sub.c"],
    hdrs = [
        "native/sub.h",
        "native/sub_body.h",
    ],
)

cc_library(
    name = "sub_cc",
    srcs = ["native/sub_hot_patch.c"],
    linkopts = select({
        "@platforms//os:linux": ["-ldl"],
        "//conditions:default": [],
    }),
    textual_hdrs = ["native/hot_patch_router.h"],
    deps = [":sub_body_cc"],
)

cc_shared_library(
    name = "sub",
    deps = [":sub_cc"],
)

cc_shared_library(
    name = "sub_patch",
    deps = [":sub_body_cc"],
)

stand_in_code_asset(
    name = "sub_code_asset",
    asset_id = "package:sub_asset/sub",
    library = ":sub",
)

c_hot_patch(
    name = "sub_hot_patch",
    body = "native/sub.c",
    contract = "native/sub.h",
    function = "sub_body",
    library = ":sub",
    patch_library = ":sub_patch",
    sources = [
        "native/sub.c",
        "native/sub.h",
        "native/sub_body.h",
    ],
    tool = ":c_patch_tool",
)

flutter_native_library(
    name = "sub_native",
    binding_contract = ["native/sub.h"],
    hot_patch = ":sub_hot_patch",
    library = ":sub_code_asset",
    visibility = ["//sub_asset:__pkg__"],
)

# A prebuilt library: a plain file with no `CcSharedLibraryInfo`, linked from
# nothing the build knows, as a vendored `.so`/`.dylib`/`.dll` or an
# `http_file` is (`prebuilt_library.bzl`). Taken from a `cc_shared_library` so
# it is built for whichever platform the app is, with no checked-in binary.
# It reaches the app as the code asset of `//prebuilt_asset`.
cc_library(
    name = "negate_cc",
    srcs = ["native/negate.c"],
)

cc_shared_library(
    name = "negate",
    deps = [":negate_cc"],
)

prebuilt_library(
    name = "negate_prebuilt",
    library = ":negate",
)

dart_code_asset(
    name = "negate_asset",
    asset_id = "package:prebuilt_asset/negate",
    file = ":negate_prebuilt",
    visibility = ["//prebuilt_asset:__pkg__"],
)

# One counter, bound by two packages under two asset ids. Each package declares
# a standalone library of its own (`counter_a`, `counter_b`); the app serves
# both ids from the combined `counter` instead, which it bundles once, so the
# process loads one image and a bump through either id moves one count.
#
# The combined `counter` is patchable too, as one library: `:counter_hot_patch`
# builds patches of `native/counter.c`, and each id's wrapper (`count_a_native`,
# `count_b_native`) names that one builder, so an edit reaches both ids on one
# patch. The count lives in the launched image (`native/counter_hot_patch.c`),
# which hands it to the body on every call, so a patch carries on from the
# count the launched code left; `state_layout` names the header that shapes it.
cc_library(
    name = "counter_body_cc",
    srcs = ["native/counter.c"],
    hdrs = [
        "native/counter.h",
        "native/counter_body.h",
        "native/counter_state.h",
    ],
)

cc_library(
    name = "counter_cc",
    srcs = ["native/counter_hot_patch.c"],
    linkopts = select({
        "@platforms//os:linux": ["-ldl"],
        "//conditions:default": [],
    }),
    textual_hdrs = ["native/hot_patch_router.h"],
    deps = [":counter_body_cc"],
)

[
    cc_shared_library(
        name = name,
        deps = [":counter_cc"],
    )
    for name in [
        "counter",
        "counter_a",
        "counter_b",
    ]
]

cc_shared_library(
    name = "counter_patch",
    deps = [":counter_body_cc"],
)

c_hot_patch(
    name = "counter_hot_patch",
    body = "native/counter.c",
    contract = "native/counter.h",
    function = "counter_bump_body",
    library = ":counter",
    patch_library = ":counter_patch",
    sources = [
        "native/counter.c",
        "native/counter.h",
        "native/counter_body.h",
        "native/counter_state.h",
    ],
    state_layout = "native/counter_state.h",
    tool = ":c_patch_tool",
)

[
    dart_code_asset(
        name = "count_%s_%s" % (package, which),
        asset_id = "package:count_%s/count_%s" % (package, package),
        file = library,
        visibility = ["//count_%s:__pkg__" % package],
    )
    for package in [
        "a",
        "b",
    ]
    for which, library in [
        (
            "own",
            ":counter_" + package,
        ),
        ("combined", ":counter"),
    ]
]

# One wrapper per asset id over the combined library, each with that id's
# contract and all naming the one builder: the app loads one image, so one patch
# serves both ids.
[
    flutter_native_library(
        name = "count_%s_native" % package,
        binding_contract = ["native/counter.h"],
        hot_patch = ":counter_hot_patch",
        library = ":count_%s_combined" % package,
    )
    for package in [
        "a",
        "b",
    ]
]

# Two code assets, one linking the other, as a package whose libraries share a
# runtime ships them: `chain_top` records `chain_base` by the install name it
# was linked against, and calls it.
cc_library(
    name = "chain_base_cc",
    srcs = ["native/chain_base.c"],
    hdrs = ["native/chain.h"],
)

cc_shared_library(
    name = "chain_base",
    deps = [":chain_base_cc"],
)

cc_library(
    name = "chain_top_cc",
    srcs = ["native/chain_top.c"],
    deps = [":chain_base_cc"],
)

cc_shared_library(
    name = "chain_top",
    dynamic_deps = [":chain_base"],
    deps = [":chain_top_cc"],
)

[
    dart_code_asset(
        name = "chain_%s_asset" % which,
        asset_id = "package:chain_asset/" + which,
        file = ":chain_" + which,
        visibility = ["//chain_asset:__pkg__"],
    )
    for which in [
        "base",
        "top",
    ]
]

# Two libraries, one linking the other through `dynamic_deps`. The app names
# only `linked_top`: the bundle carries `linked_base` beside it, as a native
# build that links them installs both, and `linked_top` must find
# `linked_base` there, not in the build tree's `_solib_<cpu>/`.
cc_library(
    name = "linked_base_cc",
    srcs = ["native/linked_base.c"],
    hdrs = ["native/linked_pair.h"],
)

cc_shared_library(
    name = "linked_base",
    deps = [":linked_base_cc"],
)

cc_library(
    name = "linked_top_cc",
    srcs = ["native/linked_top.c"],
    deps = [":linked_base_cc"],
)

cc_shared_library(
    name = "linked_top",
    dynamic_deps = [":linked_base"],
    deps = [":linked_top_cc"],
)

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "ffi_example",
)

flutter_application(
    name = "ffi_app",
    code_assets = [
        ":count_a_native",
        ":count_b_native",
    ],
    main = "lib/main.dart",
    native_deps = [":linked_top"],
    package = ":pubspec-metadata",
    deps = [
        "//add_plugin",
        "//chain_asset",
        "//count_a",
        "//count_b",
        "//mul_plugin",
        "//pick",
        "//prebuilt_asset",
        "//sub_asset",
        # No code asset is named anywhere in this workspace. drift pulls
        # package:sqlite3, and the curated registry attaches sqlite3's
        # Bazel-built library to that package, so it arrives here the way pub's
        # own hook output would.
        "@deps//:drift",
        "@deps//:material_ui",
        "@rules_flutter//flutter:material_icons",
    ],
)

flutter_macos_app_framework_gen(
    name = "ffi_macos_framework",
    application = ":ffi_app",

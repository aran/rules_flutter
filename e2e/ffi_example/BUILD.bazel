# Add-to-app: the xcframeworks of the code assets that ship, with their dSYMs,
# in release, where `pick`'s link hook drops `pick_dropped`; `chain_top` links
# `chain_base` by its install name there. macOS only: an iOS one builds its
# simulator slice in debug, as `flutter build ios-framework` does, where no
# link hook runs, so it ships `pick_dropped` too, and the device build, which
# does not, is the source of truth (upstream's `verifyCodeAssetConsistency`).
flutter_macos_xcframeworks(
    name = "ffi_macos_xcframeworks",
    application = ":ffi_app",
    plugins = False,
    tags = ["manual"],
)

apple_release_build(
    name = "macos_xcframeworks_release",
    compilation_mode = "fastbuild",
    sign = False,
    tags = ["manual"],
    targets = [":ffi_macos_xcframeworks"],
)

dart_test(
    name = "verify_macos_add_to_app_code_assets_test",
    args = [
        "ffi_macos_xcframeworks",
        "libpick_kept",
        "libpick_dropped",
        "libchain_top",
        "libchain_base",
    ],
    data = [":macos_xcframeworks_release"],
    main = "test/verify_add_to_app_code_assets_test.dart",
    target_compatible_with = ["@platforms//os:macos"],
    deps = ["@rules_flutter//tools/e2e_testing"],
)

# `:ffi_ios` as a simulator bundle, which is always a debug build.
flutter_ios_simulator_build(
    name = "ffi_ios_simulator",
    testonly = True,
    target_compatible_with = ["@platforms//os:macos"],
    targets = [":ffi_ios"],
)

dart_test(
    name = "verify_ios_bundle_test",
    data = [":ffi_ios_simulator"],
    main = "test/verify_ios_bundle_test.dart",
    target_compatible_with = ["@platforms//os:macos"],
    deps = ["@rules_flutter//tools/e2e_testing"],
)

build_test(
    name = "ffi_build_test",
    targets = [
        ":ffi_app",
        ":add",
        ":mul",
        "//add_plugin",
        "//mul_plugin",
    ],
)

build_test(
    name = "macos_bundle_build_test",
    target_compatible_with = ["@platforms//os:macos"],
    targets = [":ffi_macos"],
)

build_test(
    name = "linux_bundle_build_test",
    target_compatible_with = ["@platforms//os:linux"],
    targets = [":ffi_linux"],
)

build_test(
    name = "windows_bundle_build_test",
    target_compatible_with = ["@platforms//os:windows"],
    targets = [":ffi_windows"],
)

# The workspace's lint ruleset, bundled with the pub package whose YAML its
# `include:` resolves against. Named here rather than in a library's `deps`: a
# lint ruleset is not a dependency of the code it lints, and listing it there
# carries it into the `DartInfo` of every binary and test downstream.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@deps//:very_good_analysis"],
)

# Every `analysis_options.yaml` in this workspace, for the `dart_analyze`
# aspect `.bazelrc` enables: each Dart file is checked against the nearest
# listed one above it.
dart_analysis_config(
    name = "analysis_config",
    options = [":options"],
)

# Static analysis over this example's Dart. The app rule is a bundle and
# carries no DartInfo, so the sources are declared once more as a library for
# the analyzer to stage.
flutter_library(
    name = "app_lib",
    srcs = glob(["lib/**/*.dart"]),
    package = ":pubspec-metadata",
    deps = [
        "//add_plugin",
        "//chain_asset",
        "//count_a",
        "//count_b",
        "//mul_plugin",
        "//pick",
        "//prebuilt_asset",
        "//sub_asset",
        "@deps//:drift",
        "@deps//:material_ui",
        "@rules_flutter//flutter:material_icons",
    ],
)

exports_files(["pubspec.lock"])

cc_library(
    name = "add_cc",
    srcs = ["native/add.c"],
    hdrs = ["native/add.h"],
)

cc_shared_library(
    name = "add",
    visibility = ["//add_plugin:__pkg__"],
    deps = [":add_cc"],
)

# `mul` is patchable in a running app: `native/mul_hot_patch.c` routes every
# call through a pointer a patch can move, and `:mul_native` tells the dev tool
# how patches are built. An edit to `native/mul.c` then reaches a running app on
# a hot reload; an edit to `native/mul.h` answers that a restart is needed.
cc_library(
    name = "mul_body_cc",
    srcs = ["native/mul.c"],
    hdrs = [
        "native/mul.h",
        "native/mul_body.h",
    ],
)

cc_library(
    name = "mul_cc",
    srcs = ["native/mul_hot_patch.c"],
    # `dlopen` lives in libdl on glibc before 2.34; Apple, bionic and newer
    # glibc need nothing, and Windows loads through kernel32.
    linkopts = select({
        "@platforms//os:linux": ["-ldl"],
        "//conditions:default": [],
    }),
    deps = [":mul_body_cc"],
)

cc_shared_library(
    name = "mul",
    deps = [":mul_cc"],
)

# The patch: `native/mul.c` built on its own, beside the library the app runs.
cc_shared_library(
    name = "mul_patch",
    deps = [":mul_body_cc"],
)

dart_binary(
    name = "c_patch_tool",
    main = "tools/c_patch_tool.dart",
)

c_hot_patch(
    name = "mul_hot_patch",
    contract = "native/mul.h",
    library = ":mul",
    patch_library = ":mul_patch",
    sources = [
        "native/mul.c",
        "native/mul.h",
        "native/mul_body.h",
    ],
    tool = ":c_patch_tool",
)

flutter_native_library(
    name = "mul_native",
    binding_contract = ["native/mul.h"],
    hot_patch = ":mul_hot_patch",
    library = ":mul",
    visibility = ["//mul_plugin:__pkg__"],
)


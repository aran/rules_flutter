cc_library(
    name = "add_cc",
    srcs = ["native/add.c"],
    hdrs = ["native/add.h"],
)

cc_shared_library(
    name = "add",
    visibility = ["//add_plugin:__pkg__"],
    deps = [":add_cc"],
)

cc_library(
    name = "mul_cc",
    srcs = ["native/mul.c"],
    hdrs = ["native/mul.h"],
)

cc_shared_library(
    name = "mul",
    visibility = ["//mul_plugin:__pkg__"],
    deps = [":mul_cc"],
)

flutter_application(
    name = "ffi_app",
    package_name = "ffi_example",
    main = "lib/main.dart",
    deps = [
        "//add_plugin",
        "//mul_plugin",
        # No code asset is named anywhere in this workspace. drift pulls
        # package:sqlite3, and the curated registry attaches sqlite3's
        # Bazel-built library to that package, so it arrives here the way pub's
        # own hook output would.
        "@deps//:drift",
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",

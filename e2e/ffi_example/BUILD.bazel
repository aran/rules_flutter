# The app for the simulator, and the same for a device: rules_apple wants a
# profile for every device build, and this one, a plain property list in the
# shape of one, lets the unsigned release build below be read on any machine.
[
    ios_application(
        name = name,
        bundle_id = "com.example.ffi",
        families = ["iphone"],
        infoplists = [":ffi_ios_info_plist"],
        ipa_post_processor = select({
            "@rules_flutter//flutter/private:dbg": None,
            "//conditions:default": "@rules_flutter//flutter:ios_code_asset_post_processor",
        }),
        launch_storyboard = IOS_DEFAULT_LAUNCH_STORYBOARD,
        minimum_os_version = IOS_MINIMUM_OS_VERSION,
        provisioning_profile = profile,
        resources = select({
            "@rules_flutter//flutter/private:dbg": [],
            "//conditions:default": [":ffi_ios_dropped_frameworks"],
        }),
        tags = ["manual"],
        version = ":ffi_macos_version",
        deps = [
            ":ffi_ios_framework",
            ":ffi_ios_native_frameworks",
            ":ffi_ios_runner_lib",
        ],
    )
    for name, profile in [
        ("ffi_ios", None),
        ("ffi_ios_device", "profiles/unsigned.mobileprovision"),
    ]
]


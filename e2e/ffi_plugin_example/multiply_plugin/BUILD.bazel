load("@rules_dart//dart:defs.bzl", "dart_format_test")
load("@rules_flutter//flutter:defs.bzl", "flutter_plugin")

# Demonstrate flutter_plugin with both dart_plugin_class and native_deps.
# The generated registrant calls MultiplyPlugin.registerWith(null) at startup,
# and the native shared library is bundled into the application.
flutter_plugin(
    name = "multiply_plugin",
    srcs = ["lib/multiply_plugin.dart"],
    dart_plugin_class = "MultiplyPlugin",
    native_deps = ["//:multiply"],
    platforms = [
        "macos",
        "linux",
        "windows",
        "ios",
    ],
    visibility = ["//visibility:public"],
)

dart_format_test(
    name = "format_test",
    size = "small",
    srcs = glob(["lib/**/*.dart"]),
    # Matches this workspace's `pubspec.yaml` (`sdk: ^3.12.0`); the rule's
    # `latest` default would enforce a style `dart format` here cannot
    # produce. See docs/TESTING.md.
    language_version = "3.12",
    options = "//:options",
)

"E2e test: Flutter plugin with both dart_plugin_class and native_deps"

module(name = "rules_flutter_ffi_plugin_example")

bazel_dep(name = "rules_flutter", version = "0.0.0")
bazel_dep(name = "rules_dart", version = "0.6.4")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "apple_support", version = "2.8.1")
bazel_dep(name = "rules_apple", version = "5.1.0")
bazel_dep(name = "rules_swift", version = "4.1.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "platforms", version = "1.1.0")

local_path_override(
    module_name = "rules_flutter",
    path = "../..",
)

flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.toolchain(flutter_version = "3.47.2")
flutter.pub(
    name = "deps",
    lock = "//:pubspec.lock",
)
use_repo(flutter, "deps", "flutter_ios_engine", "flutter_macos_engine", "flutter_sky_engine", "flutter_toolchains")

register_toolchains("@flutter_toolchains//:all")

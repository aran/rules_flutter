# =============================================================================
# iOS build — FFI plugin with native code statically linked.
# On iOS, native plugin code is statically linked into the app binary
# (unlike macOS/Linux where it's a separate .dylib in Frameworks/).
# The Dart FFI code uses DynamicLibrary.process() to find the symbols.
# =============================================================================

flutter_ios_framework_gen(
    name = "ffi_plugin_ios_framework",
    application = ":ffi_plugin_app",
)

flutter_ios_registrant_gen(
    name = "ffi_plugin_ios_registrant",
    application = ":ffi_plugin_app",
)

flutter_ios_engine(
    name = "ffi_plugin_ios_engine",
)

flutter_ios_native_frameworks_gen(
    name = "ffi_plugin_ios_native_frameworks",
    application = ":ffi_plugin_app",
)

flutter_ios_info_plist_gen(
    name = "ios_runner_info_plist",
    app_name = "FFI Plugin Example",
)

flutter_ios_runner_lib_gen(
    name = "ios_runner_lib",
    engine = ":ffi_plugin_ios_engine",
    registrant = ":ffi_plugin_ios_registrant",
)

apple_bundle_version(
    name = "ffi_plugin_ios_version",
    build_version = "1.0",
    short_version_string = "1.0",
    tags = ["manual"],
)

_IOS_DEPS = [
    ":ffi_plugin_ios_framework",
    # Native-asset frameworks. Declared above but easy to leave
    # unwired: the app still builds and renders, then fails every
    # native-asset call at runtime because dyld cannot resolve the
    # framework-relative path the manifest records.
    ":ffi_plugin_ios_native_frameworks",
    ":ios_runner_lib",
    # FFI C library (dart:ffi). alwayslink keeps symbols referenced only
    # from Dart; on iOS the native code links statically into the app binary
    # and Dart reaches it through DynamicLibrary.process().
    ":multiply_cc",
]

ios_application(
    name = "ffi_plugin_ios",
    bundle_id = "com.example.ffiplugin",
    families = ["iphone"],
    infoplists = [":ios_runner_info_plist"],
    launch_storyboard = IOS_DEFAULT_LAUNCH_STORYBOARD,
    minimum_os_version = IOS_MINIMUM_OS_VERSION,
    tags = ["manual"],
    version = ":ffi_plugin_ios_version",
    deps = _IOS_DEPS,
)

# The same app, signed for a physical device: `provisioning_profile` is the
# only difference, so the device bundle shares every Tier-2 `_gen` target with
# the simulator's `:ffi_plugin_ios` above rather than re-deriving them.
#
# `//device` is git-ignored and absent from a fresh clone. That is fine: the
# target is tagged `manual`, so `bazel build //...` never expands it and
# therefore never loads the missing package. Create it from device.example/.
ios_application(
    name = "ffi_plugin_ios_device",
    bundle_id = "com.example.ffiplugin",
    families = ["iphone"],
    infoplists = [":ios_runner_info_plist"],
    launch_storyboard = IOS_DEFAULT_LAUNCH_STORYBOARD,
    minimum_os_version = IOS_MINIMUM_OS_VERSION,
    provisioning_profile = "//device:profile",
    tags = ["manual"],
    version = ":ffi_plugin_ios_version",
    deps = _IOS_DEPS,
)


load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_dart//dart:defs.bzl", "dart_analysis_config", "dart_analysis_options", "dart_test")
load("@rules_flutter//flutter:defs.bzl", "dart_package_metadata", "flutter_application", "flutter_library")
load("@rules_flutter//flutter:integration_test.bzl", "flutter_web_integration_test")
load("@rules_flutter//flutter:web.bzl", "flutter_web_app", "flutter_web_bundle", "flutter_web_manifest_gen")

exports_files(["pubspec.lock"])

# =============================================================================
# Approach 1: Tier 1 — flutter_web_app (auto-discovers web/ runner files)
# WASM build (dart2wasm + skwasm) — modern, recommended, with the dart2js build
# beside it (`js_fallback`, on by default) for browsers that cannot run WASM.
# =============================================================================

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "web_example",
)

# The program every web app here but the test-driver one is built from.
flutter_application(
    name = "app",
    # A first-party asset, so the web dev loop's asset reload has something
    # real to deliver.
    assets = glob(["assets/**"]),
    main = "lib/main.dart",
    package = ":pubspec-metadata",
    deps = [
        "@deps//:flutter",
        "@deps//:material_ui",
        "@rules_flutter//flutter:material_icons",
    ],
)

flutter_web_app(
    name = "app_wasm",
    app_name = "Web Example",
    application = ":app",
)

# A flavor is a target: the same app as a flavor's web app. `appFlavor` is
# `paid` in it, and stays so through the dev loop's reload and restart.
flutter_application(
    name = "app_paid",
    assets = glob(["assets/**"]),
    flavor = "paid",
    main = "lib/main.dart",
    package = ":pubspec-metadata",
    deps = [
        "@deps//:flutter",
        "@deps//:material_ui",
        "@rules_flutter//flutter:material_icons",
    ],
)

flutter_web_app(
    name = "web_example_paid",
    app_name = "Web Example Paid",
    application = ":app_paid",
)

# Variant with a non-default base_href, exercising substitution of the
# user-provided web/index.html.
flutter_application(
    name = "app_versioned",
    assets = glob(["assets/**"]),
    # Not the default, so :verify_version_json_test can see it arrive.
    build_name = "2.3.4",
    build_number = "42",
    main = "lib/main.dart",
    package = ":pubspec-metadata",
    deps = [
        "@deps//:flutter",
        "@deps//:material_ui",
        "@rules_flutter//flutter:material_icons",
    ],
)

flutter_web_app(
    name = "app_wasm_subpath",
    app_name = "Web Example (subpath)",
    application = ":app_versioned",
    base_href = "/web_example/",
)

# An app whose `main` sits outside the package's `lib/` — the shape
# `flutter run -t test_driver/app.dart` runs. The dev loop's generated
# entrypoint imports it by its app-scheme URI instead of a `package:` one, and a
# hot reload has to deliver edits to it and to the sibling it imports.
flutter_application(
    name = "test_driver_app",
    srcs = ["test_driver/banner.dart"],
    main = "test_driver/app.dart",
    package = ":pubspec-metadata",
    deps = [
        "@deps//:material_ui",
        "@rules_flutter//flutter:material_icons",
    ],
)

flutter_web_app(
    name = "app_test_driver",
    application = ":test_driver_app",
)

# =============================================================================
# Approach 2: Tier 2 — flutter_web_bundle (explicit control)
# JS build (dart2js + canvaskit) — legacy, wider browser support. Also what
# `js_fallback` adds beside a WASM build (every WASM target here, but the
# `js_fallback = False` ones).
# =============================================================================

flutter_web_manifest_gen(
    name = "app_js_manifest",
    app_name = "Web Example JS",
)

flutter_web_bundle(
    name = "app_js",
    application = ":app",
    base_href = "/web_example_js/",
    compiler = "dart2js",
    # Exercised here rather than on the unminified target: only minified
    # output has names to choose, so alongside `minify_js = "false"` this
    # setting reaches the command line and decides nothing.
    frequency_based_minification = False,
    manifest_json = ":app_js_manifest",
    renderer = "canvaskit",
    title = "Web Example JS",
    web_assets = glob(
        ["web/**"],
        exclude = [
            "web/index.html",
            "web/manifest.json",
        ],
    ),
)

# =============================================================================
# Approach 3: Tier 1 with pwa = False (no service worker)
# =============================================================================

flutter_web_app(
    name = "app_no_pwa",
    app_name = "Web Example No PWA",
    application = ":app",
    pwa = False,
)

# =============================================================================
# Approach 5: Tier 2 with a bootstrap template carrying a web_define
#
# The dev loop's boot path, end to end: `templates/dev_bootstrap.js` sets a
# global from `web_defines`, and `web_define_e2e_test.dart` reads that global
# off the live page of a `-d chrome` run. Nothing else here proves a define
# reaches the browser rather than only the built bundle.
#
# In the root package because it reuses this package's `lib/main.dart` and
# assets; a target beside `custom_boot`'s templates would have to carry copies
# of both. dart2js + canvaskit to keep the debug compile this adds as cheap as
# the sibling `:app_js`.
# =============================================================================

flutter_web_bundle(
    name = "app_dev_boot",
    application = ":app",
    bootstrap_js = "templates/dev_bootstrap.js",
    compiler = "dart2js",
    renderer = "canvaskit",
    title = "Web Example (dev boot)",
    web_defines = {"API_URL": "https://api.example.com"},
)

# =============================================================================
# Tests
# =============================================================================

build_test(
    name = "wasm_build_test",
    targets = [":app_wasm"],
)

build_test(
    name = "dev_boot_build_test",
    targets = [":app_dev_boot"],
)

build_test(
    name = "flavor_build_test",
    targets = [":web_example_paid"],
)

build_test(
    name = "wasm_subpath_build_test",
    targets = [":app_wasm_subpath"],
)

build_test(
    name = "js_build_test",
    targets = [":app_js"],
)

build_test(
    name = "no_pwa_build_test",
    targets = [":app_no_pwa"],
)

dart_test(
    name = "verify_index_html_test",
    data = [
        ":app_js",
        ":app_wasm",
        ":app_wasm_subpath",
    ],
    main = "test/verify_index_html_test.dart",
    deps = ["@rules_flutter//tools/e2e_testing"],
)

dart_test(
    name = "verify_version_json_test",
    data = [
        ":app_wasm",
        ":app_wasm_subpath",
    ],
    main = "test/verify_version_json_test.dart",
    deps = ["@rules_flutter//tools/e2e_testing"],
)

dart_test(
    name = "verify_service_worker_test",
    data = [
        ":app_js",
        ":app_no_pwa",
        ":app_wasm",
    ],
    main = "test/verify_service_worker_test.dart",
    deps = ["@rules_flutter//tools/e2e_testing"],
)

# The workspace's lint ruleset, bundled with the pub package whose YAML its
# `include:` resolves against. Named here rather than in a library's `deps`: a
# lint ruleset is not a dependency of the code it lints, and listing it there
# carries it into the `DartInfo` of every binary and test downstream.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@deps//:very_good_analysis"],
)

# Every `analysis_options.yaml` in this workspace, for the `dart_analyze`
# aspect `.bazelrc` enables: each Dart file is checked against the nearest
# listed one above it.
dart_analysis_config(
    name = "analysis_config",
    options = [":options"],
)

# Static analysis over this example's Dart.
#
# `flutter_web_app` provides `DartAnalyzableInfo`, so a bundle can be an
# analysis target directly — `//custom_boot:custom_boot_analyze` is one. This
# library covers strictly more: the bundles here name only
# `main = "lib/main.dart"`, while this globs all of `lib/`, so anything under it
# that no bundle reaches would otherwise be analyzed by nothing.
flutter_library(
    name = "app_lib",
    srcs = glob(["lib/**/*.dart"]),
    package = ":pubspec-metadata",
    deps = [
        "@deps//:flutter",
        "@deps//:material_ui",
        "@rules_flutter//flutter:material_icons",
    ],
)

# =============================================================================
# Approach 4: compiler settings on a real app
#
# Everything above builds with the defaults. This target turns on the flags a
# deployment actually reaches for, so they are exercised against a real
# Flutter app rather than only against a `void main() {}` fixture — several of
# them (csp, the experiments, dump-info) only do anything once there is a
# program with imports, interop and icons in it.
# =============================================================================

flutter_web_app(
    name = "app_tuned",
    app_name = "Web Example (tuned)",
    application = ":app",
    # The size report, produced as a named output rather than deployed. It
    # describes the dart2js build, so it needs the fallback to exist.
    dump_info = True,
    # Kept unminified and unstripped so the bundle can be read.
    minify_js = "false",
    minify_wasm = "false",
    strip_wasm = False,
    # Serves the renderer from the app itself, which is what lets this bundle
    # run under a `script-src 'self'` policy — the CDN copy is a script the
    # page may not fetch, and the app never boots without it.
    use_local_canvaskit = True,
)

# WebAssembly only: no dart2js compile runs and the bundle has no main.dart.js.
flutter_web_app(
    name = "app_wasm_only",
    app_name = "Web Example (WASM only)",
    application = ":app",
    js_fallback = False,
)

# WebAssembly for every browser engine flutter.js knows, instead of Flutter's
# default of Chromium only. A browser without WasmGC still gets the message the
# generated bootstrap shows, because it has no JavaScript build to run. Also
# serves its own skwasm renderer, the one e2e bundle where the local
# `canvaskit/` directory is there to be checked.
flutter_web_app(
    name = "app_all_browsers",
    app_name = "Web Example (all browsers)",
    application = ":app",
    js_fallback = False,
    use_local_canvaskit = True,
    wasm_browsers = [
        "blink",
        "gecko",
        "webkit",
    ],
)

# The opposite: Chromium is left out of the allow-list, so Chrome finds no build
# it may run and the page shows the generated bootstrap's message. Stands in for
# a browser the loader refuses.
flutter_web_app(
    name = "app_no_blink",
    app_name = "Web Example (no blink)",
    application = ":app",
    js_fallback = False,
    wasm_browsers = [
        "gecko",
        "webkit",
    ],
)

build_test(
    name = "wasm_browsers_build_test",
    targets = [
        ":app_all_browsers",
        ":app_no_blink",
    ],
)

build_test(
    name = "wasm_only_build_test",
    targets = [":app_wasm_only"],
)

build_test(
    name = "tuned_build_test",
    targets = [":app_tuned"],
)

# A profile build of the same app: release-shaped, but readable.
flutter_web_app(
    name = "app_profile",
    app_name = "Web Example (profile)",
    application = ":app",
    profile = True,
)

build_test(
    name = "profile_build_test",
    targets = [":app_profile"],
)

dart_test(
    name = "verify_compiler_flags_test",
    data = [
        # The negative half of the `useLocalCanvasKit` check: a build that
        # never asked for it must not carry it, or the positive assertion
        # would hold for every bundle and mean nothing.
        ":app_all_browsers",
        ":app_js",
        ":app_no_blink",
        ":app_tuned",
        ":app_wasm",
        ":app_wasm_only",
    ],
    main = "test/verify_compiler_flags_test.dart",
    deps = ["@rules_flutter//tools/e2e_testing"],
)

# =============================================================================
# The render check, as a test
#
# The app run in headless Chrome with an integration test as its program, which
# reads text back out of the widget tree and out of a widget fed by the asset
# bundle: a bundle that boots and paints nothing, or cannot resolve its assets,
# fails here. This is docs/TESTING.md § 5's render check. macOS and Linux run it
# (on Linux the browser loads the pinned runtime's libraries); Windows is not
# verified, and Bazel reports it skipped there.
# =============================================================================

flutter_web_integration_test(
    name = "render_test",
    src = "integration_test/render_test.dart",
    # Carries the first-party asset the second case reads.
    application = ":app",
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "@deps//:flutter_test",
        "@deps//:integration_test",
    ],
)

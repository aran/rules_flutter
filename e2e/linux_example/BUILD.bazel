load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_dart//dart:defs.bzl", "dart_analysis_config", "dart_analysis_options", "dart_test")
load("@rules_flutter//flutter:defs.bzl", "flutter_application", "flutter_library")
load(
    "@rules_flutter//flutter:linux.bzl",
    "flutter_linux_app",
    "flutter_linux_bundle",
    "flutter_linux_engine",
    "flutter_linux_registrant_gen",
    "flutter_linux_runner_lib_gen",
)

exports_files(["pubspec.lock"])

flutter_application(
    name = "app_flutter",
    package_name = "linux_example",
    main = "lib/main.dart",
    deps = [
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",
    ],
)

# =============================================================================
# Shared Tier 2 targets (used by approaches 2 & 3)
# =============================================================================

# Marked Linux-only like every other target here: on a non-Linux host the
# resolved toolchain has no libflutter_linux_gtk.so and the rule hard-fails
# during analysis, which makes `bazel test //...` on macOS an error rather
# than a skip.
flutter_linux_engine(
    name = "flutter_engine",
    target_compatible_with = ["@platforms//os:linux"],
)

flutter_linux_registrant_gen(
    name = "app_registrant",
    application = ":app_flutter",
)

# =============================================================================
# Approach 1: Flutter-generated runner (flutter_linux_app)
#
# Recommended for most users. Requires linux/runner/ from `flutter create`.
# The macro auto-discovers C++ runner files, uses the flutter create
# registrant, and assembles the bundle automatically.
# =============================================================================

flutter_linux_app(
    name = "app",
    application = ":app_flutter",
    gtk_app_id = "com.example.linuxexample",
    target_compatible_with = ["@platforms//os:linux"],
)

# =============================================================================
# Approach 2: Bazel-generated runner (flutter_linux_runner_lib_gen)
#
# For users without `flutter create` output. Uses template runner from
# rules_flutter. No C++ code needed. User wires runner + bundle manually.
# =============================================================================

flutter_linux_runner_lib_gen(
    name = "bazel_runner",
    engine = ":flutter_engine",
    gtk_app_id = "com.example.linuxexample",
    registrant = ":app_registrant",
    window_title = "Linux Example",
)

flutter_linux_bundle(
    name = "app_bazel_runner",
    application = ":app_flutter",
    runner = ":bazel_runner",
    tags = ["manual"],
)

# =============================================================================
# Tests
# =============================================================================

build_test(
    name = "linux_app_build_test",
    target_compatible_with = ["@platforms//os:linux"],
    targets = [":app"],
)

build_test(
    name = "linux_bazel_runner_build_test",
    target_compatible_with = ["@platforms//os:linux"],
    targets = [":app_bazel_runner"],
)

dart_test(
    name = "verify_linux_bundle_test",
    data = [":app"],
    main = "test/verify_linux_bundle_test.dart",
    target_compatible_with = ["@platforms//os:linux"],
)

dart_test(
    name = "verify_window_title_test",
    data = [":app_bazel_runner"],
    main = "test/verify_window_title_test.dart",
    target_compatible_with = ["@platforms//os:linux"],
)

# The workspace's lint ruleset, bundled with the pub package whose YAML its
# `include:` resolves against. Named here rather than in a library's `deps`: a
# lint ruleset is not a dependency of the code it lints, and listing it there
# carries it into the `DartInfo` of every binary and test downstream.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@deps//:very_good_analysis"],
)

# Every `analysis_options.yaml` in this workspace, for the `dart_analyze`
# aspect `.bazelrc` enables: each Dart file is checked against the nearest
# listed one above it.
dart_analysis_config(
    name = "analysis_config",
    options = [":options"],
)

# Static analysis over this example's Dart. The app rule is a bundle and
# carries no DartInfo, so the sources are declared once more as a library for
# the analyzer to stage.
flutter_library(
    name = "app_lib",
    package_name = "linux_example",
    srcs = glob(["lib/**/*.dart"]),
    deps = [
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",
    ],
)

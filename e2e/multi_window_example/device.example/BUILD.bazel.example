# Per-developer iOS signing configuration — NOT checked into version control.
#
# This whole `device/` directory is git-ignored so your Apple Team ID and
# provisioning profile never land in version control. It holds nothing but the
# credential: the device app itself is `//:app_ios_device` in the root
# BUILD.bazel, which is the simulator's `//:app_ios` — the same custom
# multi-scene runner (PlannerRunner + PlannerSceneDelegate) and the same
# `ios/Info.plist` — plus `provisioning_profile`.
#
# Setup:
#   1. cp -r device.example device
#   2. mv device/BUILD.bazel.example device/BUILD.bazel
#   3. Install a development provisioning profile covering com.example.planner
#      into ~/Library/Developer/Xcode/UserData/Provisioning Profiles/ — from
#      the Apple Developer portal, or with `xcodebuild
#      -allowProvisioningUpdates` against any Xcode project whose
#      PRODUCT_BUNDLE_IDENTIFIER is that id.
#   4. Set profile_name below to that profile's own name — see the note.
#   5. Build:  bazel build //:app_ios_device -c opt --ios_multi_cpus=arm64
#      Or run: flutter_bazel run -t //:app_ios_device -d ios
#
# Naming the profile: `profile_name` matches the profile's `Name` field, which
# is *not* always "iOS Team Provisioning Profile: <bundle id>". Xcode mints a
# per-bundle-id profile only for an App ID registered explicitly in the
# developer portal; for an unregistered id — which an example app's is —
# automatic signing issues the team **wildcard** profile instead, named
# "iOS Team Provisioning Profile: *" over App ID <TEAM>.*, and that is what
# covers this bundle id. List the ones you actually have with:
#
#   for f in ~/Library/Developer/Xcode/UserData/Provisioning\ Profiles/*.mobileprovision; do
#     security cms -D -i "$f" | plutil -extract Name raw -; done
#
# Entitlements your profile cannot grant. A device build is signed against the
# profile, and an entitlement it does not grant fails the build:
#
#   Target "//:..." uses entitlements with the "aps-environment" key, but the
#   profile does not have this key
#
# `aps-environment` is the usual one. Xcode writes it into
# ios/Runner/Runner.entitlements the moment Push Notifications is enabled, it
# outlives the code that used it, and a team wildcard profile can never grant
# it — push needs a registered App ID. The message names the profile, so the
# file is the last place you look. Pass `entitlements = False` on the device
# target to ship none; do not delete the file, which is the app's real answer
# for a profile that does grant push.

load("@rules_apple//apple:apple.bzl", "local_provisioning_profile")

package(default_visibility = ["//visibility:public"])

local_provisioning_profile(
    name = "profile",
    # The team wildcard, which covers any bundle id under your team. Replace
    # with "iOS Team Provisioning Profile: com.example.planner" if you
    # registered that App ID explicitly.
    profile_name = "iOS Team Provisioning Profile: *",
    tags = ["manual"],
)

load("@rules_flutter//flutter:defs.bzl", "flutter_library")

# A package shader SkSL cannot compile: shaders/indexed.frag indexes a
# uniform array in a loop. See ../BUILD.bazel.
flutter_library(
    name = "pkg",
    package_name = "impeller_shader",
    srcs = [],
    pkg_shaders = {"shaders/indexed.frag": "shaders/indexed.frag"},
    visibility = ["//impeller_shader:__pkg__"],
    deps = ["@deps//:flutter"],
)

# network: to the repository's own artifacts, the pinned engine POMs, or what
# `@rules_flutter_maven`'s lock pins.
dart_test(
    name = "verify_android_aar_resolves_test",
    data = [
        ":annotated_module_aar",
        ":plugin_module_repo_debug",
        ":plugin_module_repo_release",
        ":rules_flutter_maven_install.json",
        "//glass_app:glass_module_aar",
    ] + _FLUTTER_MAVEN_POMS,
    env = {"FLUTTER_MAVEN_POMS": " ".join(["$(rlocationpath %s)" % pom for pom in _FLUTTER_MAVEN_POMS])},
    main = "test/verify_android_aar_resolves_test.dart",
    tags = ["android"],
    deps = [
        "@rules_dart//dart/runfiles",
        "@rules_flutter//tools/e2e_testing",
    ],
)

# A native host app built by Gradle (add_to_app_host/android), taking the
# module from the repositories above as Flutter's add-to-app guide shows.
# The Gradle distribution, the JDK, the Android SDK and every Maven artifact
# the build resolves are pinned and downloaded by Bazel (MODULE.bazel), and
# Gradle runs offline.
_GRADLE_HOST_PROJECT = glob(
    ["add_to_app_host/android/**"],
    exclude = ["add_to_app_host/android/gradle_repository.json"],
)

_GRADLE_HOST_MODULE_REPOSITORIES = [
    ":plugin_module_repo_debug",
    ":plugin_module_repo_profile",
    ":plugin_module_repo_release",
]

gradle_host_config(
    name = "gradle_host_offline",
    maven_repository = "@gradle_host_maven//:files",
    module_repositories = _GRADLE_HOST_MODULE_REPOSITORIES,
    project = _GRADLE_HOST_PROJECT,
    settings = "add_to_app_host/android/settings.gradle",
    tags = [
        "android",
        "deep",
    ],
)

# Builds the host's debug, profile and release APKs and checks each one's
# native libraries per ABI, dexed classes and merged manifest. In the `deep`
# tier (.bazelrc): it downloads Gradle, the Android Gradle plugin and the
# engine's Maven artifacts, and takes minutes.
dart_test(
    name = "gradle_host_test",
    size = "medium",
    srcs = ["test/gradle_host.dart"],
    args = ["$(rlocationpath :gradle_host_offline)"],
    data = [
        ":gradle_host_offline",
        "@bazel_tools//tools/zip:zipper",
    ],
    env = {"ZIPPER_RUNFILE": "$(rlocationpath @bazel_tools//tools/zip:zipper)"},
    main = "test/gradle_host_test.dart",
    tags = [
        "android",
        "block-network",
        "deep",
    ],
    deps = [
        "@rules_dart//dart/runfiles",
        "@rules_flutter//tools/e2e_testing",
    ],
)

# The same build against the remote repositories, which records the lock of
# `@gradle_host_maven`: `bazel run --config=deep //:record_gradle_host_repository`.
gradle_host_config(
    name = "gradle_host_online",
    module_repositories = _GRADLE_HOST_MODULE_REPOSITORIES,
    project = _GRADLE_HOST_PROJECT,
    remote_repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
        "https://storage.googleapis.com/download.flutter.io",
    ],
    settings = "add_to_app_host/android/settings.gradle",
    tags = [
        "android",
        "deep",
    ],
)

dart_binary(
    name = "record_gradle_host_repository",
    srcs = ["test/gradle_host.dart"],
    args = ["$(rlocationpath :gradle_host_online)"],
    data = [":gradle_host_online"],
    main = "test/record_gradle_host_repository.dart",
    tags = [
        "android",
        "deep",
    ],
    deps = [
        "@deps//:crypto",
        "@rules_dart//dart/runfiles",
    ],
)

# Each package fetched from pub.dev says what it is, for any SBOM tool, whichever
# kind of repository holds it: a plugin's (`record_android`), an overlay's
# (`audio_session`) and a pure-Dart package's, by name, version and archive
# digest. A `path` package (`kotlin_only_plugin`) is the user's own and states
# none; nor does a package of the Flutter SDK.
package_metadata_files(
    name = "fetched_package_metadata",
    deps = [
        "@deps//:audio_session",
        "@deps//:kotlin_only_plugin",
        "@deps//:record_android",
    ],
)


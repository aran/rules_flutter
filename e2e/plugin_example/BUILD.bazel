_IOS_DEPS = [
    ":ios_runner_lib",
    ":plugin_ios_framework",
    # Native-asset frameworks (objective_c.framework, needed by modern
    # path_provider_foundation). Without this the manifest still records
    # `objective_c.framework/objective_c`, but nothing embeds it, so dyld's
    # rpath lookup falls through and every path_provider call fails at
    # runtime while the app otherwise renders normally.
    ":plugin_ios_native_frameworks",
]

ios_application(
    name = "plugin_ios",
    bundle_id = "com.example.plugin",
    families = ["iphone"],
    infoplists = [":ios_runner_info_plist"],
    launch_storyboard = IOS_DEFAULT_LAUNCH_STORYBOARD,
    minimum_os_version = IOS_MINIMUM_OS_VERSION,
    resources = [":plugin_ios_privacy_manifests"],
    tags = ["manual"],
    version = ":plugin_ios_version",
    deps = _IOS_DEPS,
)

# The same app, signed for a physical device: `provisioning_profile` is the
# only difference, so the device bundle shares every Tier-2 `_gen` target with
# the simulator's `:plugin_ios` above rather than re-deriving them.
#
# `//device` is git-ignored and absent from a fresh clone. That is fine: the
# target is tagged `manual`, so `bazel build //...` never expands it and
# therefore never loads the missing package. Create it from device.example/.
ios_application(
    name = "plugin_ios_device",
    bundle_id = "com.example.plugin",
    families = ["iphone"],
    infoplists = [":ios_runner_info_plist"],
    launch_storyboard = IOS_DEFAULT_LAUNCH_STORYBOARD,
    minimum_os_version = IOS_MINIMUM_OS_VERSION,
    provisioning_profile = "//device:profile",
    resources = [":plugin_ios_privacy_manifests"],
    tags = ["manual"],
    version = ":plugin_ios_version",
    deps = _IOS_DEPS,
)


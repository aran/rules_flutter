# The plugin_android APK rebuilt under -c dbg, so the default-configuration
# APK verifier can assert debug-only content (the merged debug variant
# manifest's INTERNET permission) without building the test under -c dbg.
debug_apk(
    name = "plugin_android_dbg",
    apk = ":plugin_android",
    tags = ["android"],
)

# APK content verifier: asserts every plugin's native pieces are packaged —
# including package:jni's libdartjni.so (jnigen plugins load it via
# System.loadLibrary), its shared Java support classes, and that every
# packaged .so is ELF for the declared ABI. Verifies both the ambient APK
# (release) and the -c dbg APK, asserting INTERNET is present iff debug.
dart_test(
    name = "verify_android_apk_test",
    data = [
        ":plugin_android",
        ":plugin_android_dbg",
    ],
    main = "test/verify_android_apk_test.dart",
    tags = ["android"],
)

# Runtime verifier for the Android APK. Installs on a connected emulator or
# device, waits for RESUMED, and asserts the plugin_example_results logcat
# line reports a real /data/user/0/... path from path_provider — proving
# jnigen plugin registration (libdartjni.so) end to end. Tagged "manual" +
# "exclusive" because it needs a live device; run explicitly per
# docs/TESTING.md § Plugin verification matrix.
dart_test(
    name = "verify_android_app_test",
    data = [":plugin_android"],
    main = "test/verify_android_app_test.dart",
    tags = [
        "android",
        "exclusive",
        "manual",
    ],
)

build_test(
    name = "web_build_test",
    targets = [":plugin_web"],
)

# Runtime verifier for the macOS bundle. Launches the .app, captures stdout,
# and asserts the four plugin-result strings appear. Tagged "manual" +
# "exclusive" because it requires a GUI session and exclusive control of the
# Dock; run explicitly per docs/TESTING.md § Plugin verification matrix.
dart_test(
    name = "verify_macos_app_test",
    data = [":plugin_macos"],
    main = "test/verify_macos_app_test.dart",
    tags = [
        "exclusive",
        "manual",
    ],
    target_compatible_with = ["@platforms//os:macos"],
)

# The workspace's lint ruleset, bundled with the pub package whose YAML its
# `include:` resolves against. Named here rather than in a library's `deps`: a
# lint ruleset is not a dependency of the code it lints, and listing it there
# carries it into the `DartInfo` of every binary and test downstream.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    visibility = ["//greeting_plugin:__pkg__"],
    deps = ["@deps//:very_good_analysis"],
)

# Static analysis over this example's Dart. The app rule is a bundle and
# carries no DartInfo, so the sources are declared once more as a library for
# the analyzer to stage. sky_engine supplies lib/_embedder.yaml, the only way
# `dart:ui` resolves.
flutter_library(
    name = "app_lib",
    package_name = "plugin_example",
    srcs = glob(["lib/**/*.dart"]),
    deps = [
        "//greeting_plugin",
        "@deps//:audio_session",
        "@deps//:flutter",
        "@deps//:package_info_plus",
        "@deps//:path_provider",
        "@deps//:record_android",
        "@deps//:url_launcher",
        "@flutter_sky_engine//:sky_engine",
    ],
)

dart_analyze_test(
    name = "app_analyze_test",
    size = "small",
    lib = ":app_lib",
    options = ":options",
)

# Static analysis of the test sources beside the app's Dart.
# `app_analyze_test` above covers `:app_lib` and its whole
# first-party closure — dependency packages included — but a test's `main`
# belongs to no package's `lib/`, so nothing in that closure can name it.
#
# Compiling a test's `main` to a kernel rejects broken code but is indifferent
# to everything `dart analyze --fatal-infos` reports.
#
# `options`: these hold to the same very_good_analysis bar as the app code,
# rather than the SDK default. The one rule that does not fit a diagnostic
# script is `avoid_print` — writing what it found to the test log is the
# script's product, not a stray debug statement — and the scripts that print
# disable exactly that rule per-file, with the reason above the
# `ignore_for_file` (which `document_ignores` requires).
[dart_analyze_test(
    name = "%s_analyze" % t,
    size = "small",
    options = ":options",
    target = ":%s" % t,
) for t in [
    "verify_android_apk_test",
    "verify_android_app_test",
    "verify_macos_app_test",
]]

# Every `.dart` file directly in this package — `greeting_plugin` carries its
# own `format_test`.
dart_format_test(
    name = "format_test",
    size = "small",
    srcs = glob([
        "lib/**/*.dart",
        "test/**/*.dart",
    ]),
    # Matches this workspace's `pubspec.yaml` (`sdk: ^3.12.0`); the rule's
    # `latest` default would enforce a style `dart format` here cannot
    # produce. See docs/TESTING.md.
    language_version = "3.12",
    options = ":options",
)

# There is deliberately no `flutter_test` target in this workspace. Under
# `flutter_tester` no plugin registrant runs, so a widget test here could only
# assert that every plugin is absent — `GreetingPlugin.greeting` reads back
# 'No greeting registered', and each platform-channel call lands in `_safe` as
# a MissingPluginException string — inverting the one property plugin_example
# exists to prove. The rule's own bootstrap is regression-covered by
# //e2e/hello_world:widget_test. Plugin registration is verified here against
# real artifacts instead: the APK and runtime verifiers above, and
# playwright/web.spec.js for web.

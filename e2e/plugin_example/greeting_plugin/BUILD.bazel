load("@rules_dart//dart:defs.bzl", "dart_format_test")
load("@rules_flutter//flutter:defs.bzl", "flutter_plugin")

# Demonstrate flutter_plugin with dart_plugin_class only (no native code).
# The generated registrant calls GreetingPlugin.registerWith(null) at startup,
# which sets up Dart-side state before main() runs.
flutter_plugin(
    name = "greeting_plugin",
    srcs = ["lib/greeting_plugin.dart"],
    dart_plugin_class = "GreetingPlugin",
    platforms = [
        "android",
        "ios",
        "linux",
        "macos",
        "web",
        "windows",
    ],
    visibility = ["//visibility:public"],
)

dart_format_test(
    name = "format_test",
    size = "small",
    srcs = glob(["lib/**/*.dart"]),
    # Matches this workspace's `pubspec.yaml` (`sdk: ^3.12.0`); the rule's
    # `latest` default would enforce a style `dart format` here cannot
    # produce. See docs/TESTING.md.
    language_version = "3.12",
    options = "//:options",
)

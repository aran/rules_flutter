+def go_context_for_exec_group(go, exec_group):
+    ctx = go._ctx
+    toolchains = ctx.exec_groups[exec_group].toolchains
+    toolchain = toolchains[GO_TOOLCHAIN]
+    if (toolchain.sdk.version != go.sdk.version or
+        toolchain.sdk.experiments != go.sdk.experiments):
+        fail(("{}: the Go SDK resolved for exec group {} ({}, GOEXPERIMENT={}) differs from the one " +
+              "that compiled its archives ({}, GOEXPERIMENT={}). Register Go toolchains of one " +
+              "version for every execution platform.").format(
+            ctx.label,
+            exec_group,
+            toolchain.sdk.version,
+            toolchain.sdk.experiments,
+            go.sdk.version,
+            go.sdk.experiments,
+        ))
+
+    cgo_context_info = None
+    if go.cgo_tools:
+        cc_toolchain = None
+        if CPP_TOOLCHAIN_TYPE in toolchains:
+            cc_toolchain = _cc_toolchain_info(toolchains[CPP_TOOLCHAIN_TYPE])
+        if cc_toolchain:
+            cgo_context_info = cgo_context_data_impl(ctx, cc_toolchain = cc_toolchain)
+        if not cgo_context_info:
+            fail(("{}: exec group {} resolved a Go toolchain but no C/C++ toolchain for the " +
+                  "target platform on the same execution platform.").format(ctx.label, exec_group))
+
+    env, cgo_tools, cc_toolchain_files = _toolchain_env(toolchain, go.mode, go.stdlib, cgo_context_info)
+    fields = structs.to_dict(go)
+    fields.update(
+        toolchain = toolchain,
+        sdk = toolchain.sdk,
+        cgo_tools = cgo_tools,
+        cc_toolchain_files = cc_toolchain_files,
+        env = env,
+        env_for_path_mapping = {k: v for k, v in env.items() if k != "GOROOT"},
+    )
+    return struct(**fields)
+
+def _cc_toolchain_info(toolchain_info):
+    if toolchain_info == None:
+        return None
+    if hasattr(toolchain_info, "cc_provider_in_toolchain") and hasattr(toolchain_info, "cc"):
+        return toolchain_info.cc
+    return toolchain_info
+
 def _go_context_data_impl(ctx):

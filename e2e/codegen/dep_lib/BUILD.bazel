load("@rules_dart//dart:defs.bzl", "dart_analyze_test", "dart_binary", "dart_codegen", "dart_format_test")
load("@rules_flutter//flutter:defs.bzl", "flutter_library")

# Dependency package whose hand-written source IMPORTS a generated standalone
# library (catalog.g.dart). Consumed by //:app — exercises the import-as-library
# codegen shape in a non-app package.

dart_codegen(
    name = "catalog_gen",
    package_name = "dep_lib",
    src = "lib/catalog.dart",
    generator = "tools/catalog_generator.dart",
    output_suffixes = [".g.dart"],
)

flutter_library(
    name = "dep_lib",
    package_name = "dep_lib",
    srcs = [
        "lib/catalog.dart",
        ":catalog_gen",
    ],
    visibility = ["//visibility:public"],
)

# Analysis handle for the generator script — see the comment on the same
# pattern in //:BUILD.bazel. `generator` takes a bare `.dart` file label, so
# `dart_analyze_test` has nothing to point at until a `dart_binary` over the
# same source gives it one. Not wired into `:catalog_gen`.
dart_binary(
    name = "catalog_generator",
    main = "tools/catalog_generator.dart",
)

dart_analyze_test(
    name = "catalog_generator_analyze",
    size = "small",
    options = "//:options",
    target = ":catalog_generator",
)

# `catalog.g.dart` is a build output, so `glob()` on the source tree never
# sees it — nothing to exclude the way the analyze `srcs` above have to.
dart_format_test(
    name = "format_test",
    size = "small",
    srcs = glob([
        "lib/**/*.dart",
        "tools/**/*.dart",
    ]),
    # Matches this workspace's `pubspec.yaml` (`sdk: ^3.12.0`); the rule's
    # `latest` default would enforce a style `dart format` here cannot
    # produce. See docs/TESTING.md.
    language_version = "3.12",
    options = "//:options",
)

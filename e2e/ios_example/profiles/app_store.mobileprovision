<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Not a real provisioning profile: an unsigned property list in the shape of an
  App Store distribution profile for one explicit App ID, with the entitlements
  such a profile grants: `beta-reports-active`, no `get-task-allow`, and a
  wildcard keychain group. No devices, as a distribution profile names none.
  For :verify_ios_signing_entitlements_test.
-->
<plist version="1.0">
<dict>
	<key>AppIDName</key>
	<string>App Store</string>
	<key>ApplicationIdentifierPrefix</key>
	<array>
		<string>UNSIGNED00</string>
	</array>
	<key>CreationDate</key>
	<date>2026-01-01T00:00:00Z</date>
	<key>Entitlements</key>
	<dict>
		<key>application-identifier</key>
		<string>UNSIGNED00.com.rulesflutter.ios.example.signing.store</string>
		<key>beta-reports-active</key>
		<true/>
		<key>com.apple.developer.team-identifier</key>
		<string>UNSIGNED00</string>
		<key>get-task-allow</key>
		<false/>
		<key>keychain-access-groups</key>
		<array>
			<string>UNSIGNED00.*</string>
			<string>com.apple.token</string>
		</array>
	</dict>
	<key>ExpirationDate</key>
	<date>2099-01-01T00:00:00Z</date>
	<key>Name</key>
	<string>App Store</string>
	<key>Platform</key>
	<array>
		<string>iOS</string>
	</array>
	<key>TeamIdentifier</key>
	<array>
		<string>UNSIGNED00</string>
	</array>
	<key>TeamName</key>
	<string>Unsigned</string>
	<key>TimeToLive</key>
	<integer>1000</integer>
	<key>UUID</key>
	<string>00000000-0000-0000-0000-000000000000</string>
	<key>Version</key>
	<integer>1</integer>
</dict>
</plist>

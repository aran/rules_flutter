load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_apple//apple:ios.bzl", "ios_application")
load("@rules_apple//apple:versioning.bzl", "apple_bundle_version")
load("@rules_dart//dart:defs.bzl", "dart_analysis_options", "dart_analyze_test", "dart_format_test", "dart_test")
load("@rules_flutter//flutter:defs.bzl", "flutter_application", "flutter_library")
load(
    "@rules_flutter//flutter:ios.bzl",
    "IOS_DEFAULT_LAUNCH_STORYBOARD",
    "IOS_DEFAULT_MAIN_STORYBOARD",
    "IOS_MINIMUM_OS_VERSION",
    "flutter_ios_app",
    "flutter_ios_engine",
    "flutter_ios_framework_gen",
    "flutter_ios_info_plist_gen",
    "flutter_ios_native_frameworks_gen",
    "flutter_ios_registrant_gen",
    "flutter_ios_runner_lib_gen",
)
load("@rules_swift//swift:swift.bzl", "swift_library")

exports_files(["pubspec.lock"])

# =============================================================================
# Shared: Flutter application (Dart compilation)
# =============================================================================

flutter_application(
    name = "app_flutter",
    package_name = "ios_example",
    # A first-party asset so the dev loop has something real to deliver here.
    # iOS is the platform where this mattered: the runner reaches this target
    # through a split transition, so the app's `flutter_assets` tree lives in a
    # configuration no bare build produces. asset_reload_e2e_test edits
    # assets/message.txt on the simulator and asserts the change arrives.
    assets = glob(["assets/**"]),
    main = "lib/main.dart",
    min_os_version = IOS_MINIMUM_OS_VERSION,
    deps = [
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",
    ],
)

# =============================================================================
# Shared iOS targets (used by approaches 2 & 3)
# =============================================================================

flutter_ios_framework_gen(
    name = "app_framework",
    application = ":app_flutter",
)

flutter_ios_registrant_gen(
    name = "app_registrant",
    application = ":app_flutter",
)

flutter_ios_engine(name = "app_engine")

flutter_ios_native_frameworks_gen(
    name = "app_native_frameworks",
    application = ":app_flutter",
)

# Shared version for approaches 2 & 3.
apple_bundle_version(
    name = "app_version",
    build_version = "1.0",
    short_version_string = "1.0",
    tags = ["manual"],
)

# =============================================================================
# Approach 1: Flutter-generated runner (flutter_ios_app)
#
# Recommended for most users. Requires ios/Runner/ from `flutter create`.
# The macro auto-discovers Swift files, processes Info.plist (resolves Xcode
# variables), and wires everything automatically.
# =============================================================================

flutter_ios_app(
    name = "app",
    application = ":app_flutter",
    bundle_id = "com.rulesflutter.ios.example",
)

# A second app in the same package. Regression guard: each app's runner
# compiles into its own Swift module, so two of them can be built in one
# invocation. Sharing module_name = "Runner" would make both write
# <pkg>/Runner.swiftmodule and fail analysis with an action conflict.
flutter_ios_app(
    name = "app_second",
    application = ":app_flutter",
    bundle_id = "com.rulesflutter.ios.example.second",
)

# The same app, signed for a physical device: `provisioning_profile` is the
# only difference, so the device bundle is the identical construction rather
# than a second one hand-assembled out of Tier-2 `_gen` rules.
#
# `//device` is git-ignored and absent from a fresh clone. That is fine:
# flutter_ios_app defaults to `tags = ["manual"]`, so `bazel build //...`
# never expands this target and therefore never loads the missing package.
# Create it from device.example/ — see README.md "Device builds".
flutter_ios_app(
    name = "app_device",
    application = ":app_flutter",
    bundle_id = "com.rulesflutter.ios.example",
    provisioning_profile = "//device:profile",
)

# =============================================================================
# Approach 2: Bazel-generated runner (flutter_ios_runner_lib_gen)
#
# For users without `flutter create` output. Uses template files from
# rules_flutter. Only needs app_name. User manually wires ios_application.
# =============================================================================

flutter_ios_info_plist_gen(
    name = "bazel_runner_info_plist",
    app_name = "Flutter App",
    module_name = "BazelRunner",
)

flutter_ios_runner_lib_gen(
    name = "bazel_runner_lib",
    engine = ":app_engine",
    module_name = "BazelRunner",
    registrant = ":app_registrant",
)

ios_application(
    name = "app_bazel_runner",
    bundle_id = "com.rulesflutter.ios.example.bazelrunner",
    families = ["iphone"],
    infoplists = [":bazel_runner_info_plist"],
    launch_storyboard = IOS_DEFAULT_LAUNCH_STORYBOARD,
    minimum_os_version = IOS_MINIMUM_OS_VERSION,
    tags = ["manual"],
    version = ":app_version",
    deps = [
        ":app_framework",
        # Native-asset frameworks. Declared above but easy to leave
        # unwired: the app still builds and renders, then fails every
        # native-asset call at runtime because dyld cannot resolve the
        # framework-relative path the manifest records.
        ":app_native_frameworks",
        ":bazel_runner_lib",
    ],
)

# =============================================================================
# Approach 3: Custom runner (manual swift_library)
#
# For advanced users who want full control. User writes their own
# AppDelegate/SceneDelegate, creates a swift_library with the registrant
# from flutter_ios_registrant_gen, and wires into ios_application.
# =============================================================================

# Custom Info.plist with CustomRunner module name for scene delegate lookup.
flutter_ios_info_plist_gen(
    name = "custom_runner_info_plist",
    app_name = "Custom Runner Example",
    module_name = "CustomRunner",
)

swift_library(
    name = "custom_runner_lib",
    srcs = [
        "custom_runner/AppDelegate.swift",
        "custom_runner/SceneDelegate.swift",
        ":app_registrant",
    ],
    data = [IOS_DEFAULT_MAIN_STORYBOARD],
    module_name = "CustomRunner",
    tags = ["manual"],
    deps = [":app_engine"],
)

ios_application(
    name = "app_custom_runner",
    bundle_id = "com.rulesflutter.ios.example.customrunner",
    families = ["iphone"],
    infoplists = [":custom_runner_info_plist"],
    launch_storyboard = IOS_DEFAULT_LAUNCH_STORYBOARD,
    minimum_os_version = IOS_MINIMUM_OS_VERSION,
    tags = ["manual"],
    version = ":app_version",
    deps = [
        ":app_framework",
        # Native-asset frameworks. Declared above but easy to leave
        # unwired: the app still builds and renders, then fails every
        # native-asset call at runtime because dyld cannot resolve the
        # framework-relative path the manifest records.
        ":app_native_frameworks",
        ":custom_runner_lib",
    ],
)

# =============================================================================
# Tests
# =============================================================================

build_test(
    name = "ios_app_build_test",
    target_compatible_with = ["@platforms//os:macos"],
    targets = [":app"],
)

# Both apps in one build_test: a per-package module-name collision is an
# analysis-time action conflict, so it fails here rather than at runtime.
build_test(
    name = "ios_two_apps_one_package_build_test",
    target_compatible_with = ["@platforms//os:macos"],
    targets = [
        ":app",
        ":app_second",
    ],
)

# Reads the Info.plist out of the built .ipa. Bazel's default fastbuild is
# not `-c opt`, so this bundle carries the Dart VM service keys *and* the
# app's own Local Network Privacy keys.
dart_test(
    name = "verify_ios_info_plist_test",
    data = [":app"],
    main = "test/verify_ios_info_plist_test.dart",
    target_compatible_with = ["@platforms//os:macos"],
)

# The app icon `flutter create` leaves in the tree, which this BUILD file
# never mentions — `flutter_ios_app` discovers it, and the bundle has to
# actually carry it.
dart_test(
    name = "verify_ios_app_icon_test",
    data = [":app"],
    main = "test/verify_ios_app_icon_test.dart",
    target_compatible_with = ["@platforms//os:macos"],
)

build_test(
    name = "ios_bazel_runner_build_test",
    target_compatible_with = ["@platforms//os:macos"],
    targets = [":app_bazel_runner"],
)

build_test(
    name = "ios_custom_runner_build_test",
    target_compatible_with = ["@platforms//os:macos"],
    targets = [":app_custom_runner"],
)

# The workspace's lint ruleset, bundled with the pub package whose YAML its
# `include:` resolves against. Named here rather than in a library's `deps`: a
# lint ruleset is not a dependency of the code it lints, and listing it there
# carries it into the `DartInfo` of every binary and test downstream.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@deps//:very_good_analysis"],
)

# Static analysis over this example's Dart. The app rule is a bundle and
# carries no DartInfo, so the sources are declared once more as a library for
# the analyzer to stage. sky_engine supplies lib/_embedder.yaml, the only way
# `dart:ui` resolves.
flutter_library(
    name = "app_lib",
    package_name = "ios_example",
    srcs = glob(["lib/**/*.dart"]),
    deps = [
        "@deps//:flutter",
        "@flutter_sky_engine//:sky_engine",
        "@rules_flutter//flutter:material_icons",
    ],
)

dart_analyze_test(
    name = "app_analyze_test",
    size = "small",
    lib = ":app_lib",
    options = ":options",
)

# Static analysis of the test sources beside the app's Dart.
# `app_analyze_test` above covers `:app_lib` and its whole
# first-party closure — dependency packages included — but a test's `main`
# belongs to no package's `lib/`, so nothing in that closure can name it.
#
# Compiling a test's `main` to a kernel rejects broken code but is indifferent
# to everything `dart analyze --fatal-infos` reports.
#
# `options`: these hold to the same very_good_analysis bar as the app code,
# rather than the SDK default. The one rule that does not fit a diagnostic
# script is `avoid_print` — writing what it found to the test log is the
# script's product, not a stray debug statement — and the scripts that print
# disable exactly that rule per-file, with the reason above the
# `ignore_for_file` (which `document_ignores` requires).
[dart_analyze_test(
    name = "%s_analyze" % t,
    size = "small",
    options = ":options",
    target = ":%s" % t,
) for t in [
    "verify_ios_app_icon_test",
    "verify_ios_info_plist_test",
]]

# All of this workspace's Dart, checked against the same `:options` the
# analyze tests above use.
dart_format_test(
    name = "format_test",
    size = "small",
    srcs = glob([
        "lib/**/*.dart",
        "test/**/*.dart",
    ]),
    # Matches this workspace's `pubspec.yaml` (`sdk: ^3.12.0`); the rule's
    # `latest` default would enforce a style `dart format` here cannot
    # produce. See docs/TESTING.md.
    language_version = "3.12",
    options = ":options",
)

"E2e test: full iOS app via rules_flutter + rules_apple composition"

module(name = "rules_flutter_ios_example")

bazel_dep(name = "rules_flutter", version = "0.0.0")
bazel_dep(name = "rules_dart", version = "0.10.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "apple_support", version = "2.12.0")
bazel_dep(name = "rules_apple", version = "5.4.0")
bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "rules_swift", version = "4.2.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_swift_package_manager", version = "1.25.0")

local_path_override(
    module_name = "rules_flutter",
    path = "../..",
)

flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.toolchain(flutter_version = "3.50.0")

flutter_pub = use_extension("@rules_flutter//flutter/pub:extensions.bzl", "pub")
flutter_pub.from_lock(
    name = "deps",
    # A path package with no Bazel build, built from its pubspec.
    build_from_pubspec = [
        "ffi_dynamic_plugin",
        "resource_plugin",
        "script_phase_plugin",
        "swift6_plugin",
    ],
    lock = "//:pubspec.lock",
    # The pins of the Swift packages the Apple plugins depend on
    # (firebase_core's firebase-ios-sdk), which swift_deps below declares.
    swift_package_resolved = "//:Package.resolved",
)

use_repo(flutter, "flutter_ios_engine")

use_repo(flutter_pub, "deps")

# The Swift packages the Apple plugins depend on, and the app's own Swift code
# (//native_firebase) too: one repository of each, declared from Package.swift
# and Package.resolved, which `bazel run @deps//swift:packages` prints the
# lines of. The plugins reach the repositories they name through
# `inject_repo`.
swift_deps = use_extension("@rules_swift_package_manager//:extensions.bzl", "swift_deps")
swift_deps.from_package(
    resolved = "//:Package.resolved",
    swift = "//:Package.swift",
)

# firebase-ios-sdk (checked at 13.1.1) under explicit Clang modules (.bazelrc).
# Its header-only `Firebase` target imports FirebaseCore, yet Package.swift has
# FirebaseCore depend on Firebase, so that `import Firebase` works for any user
# of FirebaseCore. Each module is precompiled with only its declared
# dependencies, so `Firebase`'s precompile fails with
# `'FirebaseCore/FirebaseCore.h' file not found`. These reverse the edge:
# `Firebase` depends on FirebaseCore, and FirebaseCore's library carries
# `Firebase` beside it. The `set` restates FirebaseCore's other dependencies
# as Package.swift declares them; another version may need them changed.
swift_deps.bazel_target_set_string_list(
    attr = "deps",
    target = "@swiftpkg_firebase_ios_sdk//:FirebaseCore.rspm_objc",
    value = [
        "@swiftpkg_firebase_ios_sdk//:FirebaseCoreInternal.rspm",
        "@swiftpkg_googleutilities//:GULEnvironment",
        "@swiftpkg_googleutilities//:GULLogger",
    ],
)
swift_deps.bazel_target_add(
    attr = "deps",
    target = "@swiftpkg_firebase_ios_sdk//:Firebase.rspm_objc",
    values = [":FirebaseCore.rspm_objc"],
)
swift_deps.bazel_target_add(
    attr = "deps",
    target = "@swiftpkg_firebase_ios_sdk//:FirebaseCore.rspm.__impl",
    values = [":Firebase.rspm_objc"],
)
use_repo(swift_deps, "swift_package", "swiftpkg_firebase_ios_sdk")

inject_repo(flutter_pub, "swiftpkg_firebase_ios_sdk")

# Hermetic C++ toolchain for Linux arm64 execution platforms, so a C++ tool
# built for the exec platform (zipper, xmllint) can be compiled when Bazel runs
# actions on a Linux arm64 worker. Only the Linux-exec, Linux-target toolchain
# exists: Mac and iOS builds keep apple_support's toolchain. It is registered
# only on request, with `--extra_toolchains=@llvm_toolchains//:all` (for
# example in .bazelrc.user, for builds that run on a Linux arm64 worker):
# registering it here would make every build fetch llvm-project's sources,
# which toolchain resolution loads the generated package from.
bazel_dep(name = "llvm", version = "0.8.26", dev_dependency = True)

llvm_tc = use_extension("@llvm//extensions:toolchain.bzl", "toolchain", dev_dependency = True)
llvm_tc.exec(
    arch = "aarch64",
    os = "linux",
)
llvm_tc.target(
    arch = "aarch64",
    os = "linux",
)
use_repo(llvm_tc, "llvm_toolchains")

# Explicit Clang modules (.bazelrc) precompile the SDK's system modules. Xcode
# 27.2's SDKs ship private modules whose Swift interfaces do not compile.
system_sdk = use_extension("@rules_swift//swift:extensions.bzl", "system_sdk", dev_dependency = True)
system_sdk.configure_sdks(exclude_modules = {
    "MacOSX": ["MobileGestaltPrivate"],
    "iPhoneOS": ["MobileGestaltPrivate"],
    "iPhoneSimulator": [
        "CoreAudio_Private",
        "MobileGestaltPrivate",
    ],
})

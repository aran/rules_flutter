# Verifies the asset bundle structure for pub-package fonts/assets:
# cupertino_icons (flutter.fonts), flutter_localized_locales (flutter.assets),
# and the toolchain-backed material_icons. Asserts files land at
# packages/<pkg>/<path>, FontManifest.json carries the prefixed family for
# pub fonts and a bare family for material_icons (the package_name = ""
# sentinel), and AssetManifest.bin.json references the prefixed asset path.
dart_test(
    name = "verify_pub_assets_test",
    data = [":hello_world_app"],
    main = "test/verify_pub_assets_test.dart",
    deps = [
        "@deps//:test",
        "@rules_dart//dart/runfiles",
    ],
)

# Verifies that the entitlements blob applied at codesign time on the
# macOS bundle declares the App Sandbox capability — proves
# flutter_macos_app threaded macos/Runner/{DebugProfile,Release}.entitlements
# through to macos_application(entitlements = ...).
#
# iOS doesn't have a counterpart runtime test: rules_apple's
# codesigning pipeline strips user entitlements down to a single
# get-task-allow=true entry for simulator builds (per
# external/rules_apple/.../codesigning_support.bzl), so a sim-build
# codesign blob can't reflect forwarded entitlements. Forwarding is
# verified by `bazel cquery 'deps(//:hello_world_ios)' | grep
# Runner.entitlements`, and the existing `ios_bundle_build_test`
# proves the bundle still analyzes with the auto-discovered file.
dart_test(
    name = "verify_macos_entitlements_test",
    data = [":hello_world_macos"],
    main = "test/verify_macos_entitlements_test.dart",
    target_compatible_with = ["@platforms//os:macos"],
)

# The app icon `flutter create` leaves in the tree, which this BUILD file
# never mentions — `flutter_macos_app` discovers it, and the bundle has to
# actually carry it. See the test's own docs for why the Info.plist assertion
# is the load-bearing half.
dart_test(
    name = "verify_macos_app_icon_test",
    data = [":hello_world_macos"],
    main = "test/verify_macos_app_icon_test.dart",
    target_compatible_with = ["@platforms//os:macos"],
)

# The workspace's lint ruleset, bundled with the pub package its `include:`
# resolves against. Named here rather than in any library's `deps`: a lint
# ruleset is not a dependency of the code it lints, and listing it there would
# carry it into the `DartInfo` of every binary and test downstream.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@deps//:very_good_analysis"],
)

# Static analysis over this example's Dart. The app rule is a bundle and
# carries no DartInfo, so the sources are declared once more as a library for
# the analyzer to stage. sky_engine supplies lib/_embedder.yaml, the only way
# `dart:ui` resolves.
flutter_library(
    name = "app_lib",
    package_name = "hello_world",
    srcs = glob(["lib/**/*.dart"]),
    deps = [
        "@deps//:cupertino_icons",
        "@deps//:flutter",
        "@deps//:flutter_localized_locales",
        "@flutter_sky_engine//:sky_engine",
        "@rules_flutter//flutter:material_icons",
    ],
)

dart_analyze_test(
    name = "app_analyze_test",
    size = "small",
    lib = ":app_lib",
    options = ":options",
)

# Static analysis of the test sources beside the app's Dart.
# `app_analyze_test` above covers `:app_lib` and its whole
# first-party closure — dependency packages included — but a test's `main`
# belongs to no package's `lib/`, so nothing in that closure can name it.
#
# Compiling a test's `main` to a kernel rejects broken code but is indifferent
# to everything `dart analyze --fatal-infos` reports.
#
# `options`: these hold to the same very_good_analysis bar as the app code,
# rather than the SDK default. The one rule that does not fit a diagnostic
# script is `avoid_print` — writing what it found to the test log is the
# script's product, not a stray debug statement — and the scripts that print
# disable exactly that rule per-file, with the reason above the
# `ignore_for_file` (which `document_ignores` requires).
[dart_analyze_test(
    name = "%s_analyze" % t,
    size = "small",
    options = ":options",
    target = ":%s" % t,
) for t in [
    "dart_defines_test",
    "hello_test",
    "verify_macos_app_icon_test",
    "verify_macos_entitlements_test",
    "verify_pub_assets_test",
    "widget_test",
]]

# All of this workspace's Dart, checked against the same `:options` the
# analyze tests above use. `hello_test.dart` sits at the package root (not
# under `lib/` or `test/`), hence the flat `*.dart` pattern alongside the two
# recursive ones.
dart_format_test(
    name = "format_test",
    size = "small",
    srcs = glob([
        "*.dart",
        "lib/**/*.dart",
        "test/**/*.dart",
    ]),
    # Matches this workspace's `pubspec.yaml` (`sdk: ^3.12.0`); the rule's
    # `latest` default would enforce a style `dart format` here cannot
    # produce. See docs/TESTING.md.
    language_version = "3.12",
    options = ":options",
)

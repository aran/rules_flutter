    application = ":hello_world_app",
    target_compatible_with = ["@platforms//os:windows"],
)

flutter_web_app(
    name = "hello_world_web",
    package_name = "hello_world",
    srcs = ["lib/common_widgets.dart"],
    # Matches `pubspec.yaml`'s `sdk: ^3.12.0`, so the app's own package_config
    # entry states the version pub would grant it rather than inheriting the
    # SDK's current one.
    language_version = "3.12",
    deps = [
        "@deps//:cupertino_icons",
        "@deps//:flutter",
        "@deps//:flutter_localized_locales",
        "@rules_flutter//flutter:material_icons",
    ],
)

# -- Tests ---------------------------------------------------------------------

# Widget test: drives the same MyApp counter-tap flow that the
# `flutter create` template ships, exercising
# TestWidgetsFlutterBinding.ensureInitialized() under flutter_tester so we
# regression-check the bootstrap + harness wired into //flutter/private:flutter_test.
flutter_test(
    name = "widget_test",
    package_name = "hello_world",
    srcs = [
        "lib/common_widgets.dart",
        "lib/main.dart",
    ],
    # Matches `pubspec.yaml`'s `sdk: ^3.12.0`, so the app's own package_config
    # entry states the version pub would grant it rather than inheriting the
    # SDK's current one.
    language_version = "3.12",
    main = "test/widget_test.dart",
    deps = [
        "@deps//:cupertino_icons",
        "@deps//:flutter",
        "@deps//:flutter_localized_locales",
        "@deps//:flutter_test",
        "@rules_flutter//flutter:material_icons",
    ],
)

# Verifies Dart environment defines: the `defines` attr, the
# --@rules_flutter//flutter:extra_dart_defines flag (set in .bazelrc, value
# contains a comma to prove repeatable-flag no-split semantics), and
# flag-beats-attr precedence.
flutter_test(
    name = "dart_defines_test",
    package_name = "hello_world",
    defines = [
        "E2E_ATTR=from_attr",
        "E2E_WINNER=attr",
    ],
    main = "test/dart_defines_test.dart",
    deps = [
        "@deps//:flutter_test",
    ],
)

# Smoke test: pure dart:ui resolution. Verifies the rule still produces a
# working bootstrap for tests that don't initialize any Flutter binding.
flutter_test(
    name = "hello_test",
    package_name = "hello_world",
    main = "hello_test.dart",
    deps = [
        "@deps//:flutter_test",
    ],
)

# Exercises: the coverage path through the runner, which `bazel test` alone
# never reaches. `bazel coverage` spawns flutter_tester `--start-paused`, so
# the runner has to resume the root isolate over the VM service before the
# suite can hand shake. `COVERAGE_OUTPUT_FILE` is the runner's own trigger for
# that path, so setting it exercises the real code under the canonical
# `bazel test //...` rather than simulating it.
#
# The `moderate` timeout is deliberately *longer* than the runner's own
# two-minute dial-back bound, so a hang is reported by the runner with a reason
# rather than killed by Bazel as a bare TIMEOUT. Do not drop it to `short`.
flutter_test(
    name = "hello_coverage_test",
    package_name = "hello_world",
    size = "small",
    timeout = "moderate",
    env = {"COVERAGE_OUTPUT_FILE": "coverage_probe.lcov"},
    main = "hello_test.dart",
    deps = [
        "@deps//:flutter_test",
    ],
)


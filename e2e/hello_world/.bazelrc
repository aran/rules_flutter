common --lockfile_mode=off

# Use a remote JDK so the build works without a local Java installation.
common --java_runtime_version=remotejdk_25
common --tool_java_language_version=25
common --tool_java_runtime_version=remotejdk_25

# Exercised by :dart_defines_test — repeatable flag, one define per
# occurrence. No commas: a flutter_test's dependencies are compiled by
# kernel_worker, which splits -D values on them (an app's compile keeps them,
# see //flutter/tests:app_defines_test).
common --@rules_flutter//flutter:extra_dart_defines=E2E_FLAG=from_flag
common --@rules_flutter//flutter:extra_dart_defines=E2E_WINNER=flag

# Start py_binary tools with their hermetic interpreter, not python3 from
# PATH, which a remote worker does not have. The canonical label needs no
# direct bazel_dep on rules_python.
common --@@rules_python+//python/config_settings:bootstrap_impl=script

try-import %workspace%/.bazelrc.user

# `dart analyze` and the `dart format` check run as an aspect over every Dart
# target a `bazel test` names. The config line is `common` because `bazel run`
# of `dart_fix`/`dart_format` reads it too.
test --aspects=@rules_dart//dart:analyze.bzl%dart_analyze
test --output_groups=+dart_analyze
test --output_groups=+dart_format
common --@rules_dart//dart:analysis_config=//:analysis_config

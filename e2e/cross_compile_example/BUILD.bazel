load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_dart//dart:defs.bzl", "dart_analysis_config", "dart_analysis_options")
load("@rules_flutter//flutter:defs.bzl", "dart_package_metadata", "flutter_application", "flutter_library")
load("@rules_flutter//flutter:linux.bzl", "flutter_linux_app")
load(":cross_build.bzl", "linux_x64_debug_build")

exports_files(["pubspec.lock"])

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "hello_world",
)

flutter_application(
    name = "cross_app",
    main = "lib/main.dart",
    package = ":pubspec-metadata",
    visibility = ["//stock_runner:__pkg__"],
    deps = [
        "@deps//:material_ui",
        "@rules_flutter//flutter:material_icons",
    ],
)

# The Linux bundle, built for Linux by the build_test below on any host.
# Compatible with Linux alone, so `//...` skips it in the host's own
# configuration on another host.
flutter_linux_app(
    name = "cross_linux",
    application = ":cross_app",
    application_id = "com.example.cross_compile.cross_linux",
    target_compatible_with = ["@platforms//os:linux"],
)

# Every Linux target of the workspace, built for linux_x64 in debug mode with
# the LLVM toolchains MODULE.bazel registers. The test runs on the host;
# only these are built for Linux.
linux_x64_debug_build(
    name = "linux_x64_debug",
    targets = [
        ":cross_linux",
        "//stock_runner:probe_engine_api",
        "//stock_runner:probe_gdk_x11",
        "//stock_runner:probe_generated_registrant",
        "//stock_runner:stock_runner_generated_registrant",
        "//stock_runner:stock_runner_linux",
    ],
)

build_test(
    name = "linux_x64_debug_test",
    targets = [":linux_x64_debug"],
)

# The workspace's lint ruleset, bundled with the pub package whose YAML its
# `include:` resolves against. Named here rather than in a library's `deps`: a
# lint ruleset is not a dependency of the code it lints, and listing it there
# carries it into the `DartInfo` of every binary and test downstream.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@deps//:very_good_analysis"],
)

# Every `analysis_options.yaml` in this workspace, for the `dart_analyze`
# aspect `.bazelrc` enables: each Dart file is checked against the nearest
# listed one above it.
dart_analysis_config(
    name = "analysis_config",
    options = [":options"],
)

# Static analysis over this example's Dart. The app rule is a bundle and
# carries no DartInfo, so the sources are declared once more as a library for
# the analyzer to stage.
flutter_library(
    name = "app_lib",
    srcs = glob(["lib/**/*.dart"]),
    package = ":pubspec-metadata",
    deps = [
        "@deps//:material_ui",
        "@rules_flutter//flutter:material_icons",
    ],
)

common --lockfile_mode=off

# This workspace always cross-compiles for Linux in debug mode.
# gen_snapshot can't cross-compile AOT between desktop OSes, so debug only.
build --platforms=@rules_flutter//flutter/platforms:linux_x64
build -c dbg

# Start py_binary tools with their hermetic interpreter, not python3 from
# PATH, which a remote worker does not have. The canonical label needs no
# direct bazel_dep on rules_python.
common --@@rules_python+//python/config_settings:bootstrap_impl=script

try-import %workspace%/.bazelrc.user

# `dart analyze` and the `dart format` check run as an aspect. Under `build`
# here, not `test` as elsewhere: this workspace has no test targets, and
# `bazel test //...` with none exits 4 however clean the checks are, so
# `bazel build //...` is what runs them. The config line is `common` because
# `bazel run` of `dart_fix`/`dart_format` reads it too.
build --aspects=@rules_dart//dart:analyze.bzl%dart_analyze
build --output_groups=+dart_analyze
build --output_groups=+dart_format
common --@rules_dart//dart:analysis_config=//:analysis_config

# bridge declares one for its own tests. `//:app_flutter` serves the id from
# the combined `//:counter` instead.
dart_library(
    name = "count_a",
    package_name = "count_a",
    srcs = ["lib/count_a.dart"],
    code_assets = ["//:count_a_own"],
    visibility = ["//visibility:public"],
)

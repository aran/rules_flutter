# Fail rather than rewrite or ignore a lock file that is stale or incomplete.
# `bazel run @overhead//locks:check`, from the repository root, checks every
# workspace's (see docs/TESTING.md, "Lock files"). A gitignored .bazelrc.user that overrides a
# module must switch this off, since the override no longer matches the lock.
common --lockfile_mode=error

# Use a remote JDK so the build works without a local Java installation.
common --java_runtime_version=remotejdk_25
common --tool_java_language_version=25
common --tool_java_runtime_version=remotejdk_25

# Share the results of identical actions between configurations (one
# Android ABI and the next, -c dbg and -c fastbuild, platform transitions).
# Bazel rewrites `bazel-out/<config>` only in actions that declare they
# support it, and only where it can sandbox them: on Windows it fails a
# path-mapped action rather than run it unsandboxed. See README.md, ".bazelrc".
common --enable_platform_specific_config
common:linux --experimental_output_paths=strip
common:macos --experimental_output_paths=strip

# This workspace, alone of the e2e workspaces, is set up for remote execution
# (README, "Remote execution"): the setting below, and the patch its
# MODULE.bazel applies.
#
# Start py_binary tools with their hermetic interpreter, not python3 from
# PATH, which a remote worker does not have. The canonical label needs no
# direct bazel_dep on rules_python.
common --@@rules_python+//python/config_settings:bootstrap_impl=script

# Accepts the licences of the Android SDK and NDK versions MODULE.bazel
# downloads (README, "Android"), as rules_kotlin's examples do for theirs.
common --repo_env=ACCEPTED_ANDROID_SDK_LICENSE_VERSION=35
common --repo_env=ACCEPTED_ANDROID_NDK_LICENSE_VERSION=r28c

# The ABIs of an Android APK are the platforms of --@rules_android//flags:android_platforms (README,
# "Android"). This workspace builds for a 64-bit ARM device unless a command
# says otherwise, as the dev tool does for the device it launches on.
common --@rules_android//flags:android_platforms=@rules_android//:arm64-v8a

# No core library desugaring, as a Flutter app built with Gradle has none
# (README, "Android"). rules_android turns it on by default and packs the
# whole, unshrunk desugar_jdk_libs runtime into every APK.
common --@rules_android//flags:desugar_java8_libs=false

# Builds tools without the target configuration's Starlark flags, as a
# downstream workspace may.
common --incompatible_exclude_starlark_flags_from_exec_config

# Bazel 10's default: another repository's source files are private unless it
# exports them, so the pinned Bazel tests the rules under it.
common --incompatible_no_implicit_file_export

# A future Bazel release will no longer let an external repository's source
# directory cross a package boundary, so the rules are tested with that on.
common --incompatible_check_external_repo_source_dir_package_boundary

# Three more of a coming Bazel release's defaults, so the rules are tested with
# them on: an output file is checked for `testonly` through the rule that
# makes it; `cfg = "host"` is refused; and the string keys of a `select()` in a
# `.bzl` file are labels relative to that file, not to the BUILD file that
# loads it.
common --incompatible_check_testonly_for_output_files
common --incompatible_disable_starlark_host_transitions
common --incompatible_resolve_select_keys_eagerly

# `dart analyze` and the `dart format` check run as an aspect over every Dart
# target a `bazel test` names. The config line is `common` because `bazel run`
# of `@rules_dart//dart/fix` and `@rules_dart//dart/format` reads it too.
test --aspects=@rules_dart//dart:analyze.bzl%dart_analyze
test --output_groups=+dart_analyze
test --output_groups=+dart_format
common --@rules_dart//dart:analysis_config=//:analysis_config

# Start a `dart_test`'s `package:test` runner from a snapshot cached on the
# machine (rules_dart README, "Faster tests and builds"). `build`, not `test`:
# see the root .bazelrc.
build --@rules_dart//dart:runner_snapshot

# Swift compiles use explicit Clang modules, each precompiled by an action of
# its own, rather than rules_swift's shared, undeclared module cache. See
# README.md, "Explicit Clang modules on macOS and iOS".
common --features=swift.emit_c_module --host_features=swift.emit_c_module
common --features=swift.use_c_modules --host_features=swift.use_c_modules

# Last, so a checkout's own settings override everything above.
try-import %workspace%/.bazelrc.user

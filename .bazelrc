########################
# Import bazelrc presets
import %workspace%/tools/preset.bazelrc

# Don't want to push a rules author to update their deps if not needed.
# https://bazel.build/reference/command-line-reference#flag--check_direct_dependencies
# https://bazelbuild.slack.com/archives/C014RARENH0/p1691158021917459?thread_ts=1691156601.420349&cid=C014RARENH0
common --config=ruleset

# `dart analyze` and the `dart format` check run as an aspect over every Dart
# target a `bazel test` names; any diagnostic, down to an info, fails the build.
# Tag a target `no-dart-analyze` or `no-dart-format` to opt it out of one.
# The config line is `common` because `bazel run` of `dart_fix`/`dart_format`
# reads it too.
test --aspects=@rules_dart//dart:analyze.bzl%dart_analyze
test --output_groups=+dart_analyze
test --output_groups=+dart_format
common --@rules_dart//dart:analysis_config=//:analysis_config

# Bazel settings that apply to this repository.
# Take care to document any settings that you expect users to apply.
#
# There is no CI-only bazelrc. Flags that CI adds and a developer does not are
# written inline on the `bazel` invocations in .github/workflows/ci.yaml.

# Ensure that the MODULE.bazel.lock file is complete and committed.
# This is an important security measure: it ensures that developers on the
# same rule set download dependencies at the same versions with the same bits.
# This setting does not affect modules that depend on this module.
#
# When updating dependencies:
#     bazel mod tidy --lockfile_mode=refresh
#     bazel build --nobuild --lockfile_mode=update //...
#     bazel build --nobuild --lockfile_mode=error //...
#
# All three, in that order. `mod tidy` settles the module graph but evaluates
# only the extensions it happens to need, so on its own it leaves a lock a
# build then rejects ("The module extension '...' does not exist in the
# lockfile"). The `update` pass is what forces the rest in; the `error` pass is
# what proves the result is self-consistent.
#
# In this repo there is a fourth step, first: move every gitignored
# `.bazelrc.user` aside — the root's plus one per `e2e/*` workspace. Enumerate
# them rather than counting from memory, because the set grows with the
# workspaces: `find . -name .bazelrc.user -not -path './bazel-*'`. Each puts
# `--override_module=rules_dart` on `common`, which applies to `mod tidy` too,
# and regenerating through one writes a lock that omits the very registry entry
# it is meant to pin.
#
# When testing different versions of Bazel, use --lockfile_mode=update or
# --lockfile_mode=off. The lock file format changes over time, and different
# versions of Bazel may expect different syntax. Bazel also implicitly requires
# some modules, and different versions have different dependencies, which
# also affects the contents of the lock file.
common --lockfile_mode=error

# rules_jvm_external 7+ and rules_android 0.7.2+ ship internal tool jars
# compiled at Java 21+. Bazel's `--tool_java_runtime_version` defaults to
# `remotejdk_11`, which produces UnsupportedClassVersionError at action
# execution time, and `--tool_java_language_version` defaults to 8/11
# (older than the Records syntax in those rulesets' source). Pin to the
# current LTS so the toolchain compiles and runs them cleanly.
common --tool_java_language_version=25
common --tool_java_runtime_version=remotejdk_25

# Share the results of identical actions between configurations (one
# Android ABI and the next, -c dbg and -c fastbuild, platform transitions).
# Bazel rewrites `bazel-out/<config>` only in actions that declare they
# support it, and only where it can sandbox them: on Windows it fails a
# path-mapped action rather than run it unsandboxed. See README.md, ".bazelrc".
common --enable_platform_specific_config
common:linux --experimental_output_paths=strip
common:macos --experimental_output_paths=strip

# Each action picks its execution platform from the toolchain it names, not
# from every toolchain its rule uses: an iOS AOT compile stays on a Mac while
# the same target's kernel compile can run elsewhere. rules_flutter's actions
# all name a toolchain or run in an exec group. See README.md, ".bazelrc".
common --incompatible_auto_exec_groups

# Start py_binary tools with their hermetic interpreter, not python3 from
# PATH, which a remote worker does not have. The canonical label needs no
# direct bazel_dep on rules_python.
common --@@rules_python+//python/config_settings:bootstrap_impl=script

# Load any settings specific to the current user.
# .bazelrc.user should appear in .gitignore so that settings are not shared with team members
# This needs to be last statement in this
# config, as the user configuration should be able to overwrite flags from this file.
# See https://docs.bazel.build/versions/master/best-practices.html#bazelrc
# (Note that we use .bazelrc.user so the file appears next to .bazelrc in directory listing,
# rather than user.bazelrc as suggested in the Bazel docs)
try-import %workspace%/.bazelrc.user

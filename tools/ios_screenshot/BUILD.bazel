load("@rules_dart//dart:defs.bzl", "dart_binary")

# iOS device screenshot helpers. These are `dart_binary` targets, not
# `py_binary`: each entrypoint is a thin driver (`lib/*.dart`, `dart:io`
# only) that resolves a host `python3` and runs its `pymobiledevice3`
# program through it. That keeps `rules_python` and the `pip` extension out
# of every consumer's module graph — the helpers need no Bazel-built Python
# toolchain or wheels, only the host interpreter and an installed
# `pymobiledevice3` (`python3 -m pip install pymobiledevice3`), a documented
# host prerequisite like the Android SDK or Xcode. The dev tool runs these
# from its runfiles (`//tools/dev_tool` data below), the same keys as before.

dart_binary(
    name = "screenshot",
    srcs = glob(["lib/**/*.dart"]),
    compile_mode = "exe",
    main = "lib/screenshot.dart",
    visibility = ["//tools/dev_tool:__pkg__"],
)

dart_binary(
    name = "tunneld",
    srcs = glob(["lib/**/*.dart"]),
    compile_mode = "exe",
    main = "lib/tunneld.dart",
    visibility = ["//tools/dev_tool:__pkg__"],
)

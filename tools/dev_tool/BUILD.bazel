# Static analysis, as a test — `bazel test //...` fails on an analysis
# regression rather than leaving it to whoever next runs `dart analyze` by hand.
# Plain Dart, so it needs nothing beyond the pinned rules_dart: the dev tool
# never imports `dart:ui`, and the analyzer resolves everything it does import
# from the ordinary package config.
#
# Pointed at the binary rather than at `:lib`, because `bin/flutter_bazel.dart`
# is a `main` that belongs to no package's `lib/` and so appears in no
# `DartInfo`. Analyzing `:lib` left the entrypoint uncovered; the binary's
# `DartAnalyzableInfo` carries it *and* the whole `:lib` closure, so this is one
# action for both.
dart_analyze_test(
    name = "flutter_bazel_analyze_test",
    size = "small",
    target = ":flutter_bazel",
)

# Every unit test under test/. Adding an entry here is the whole cost of a new
# test file, and the list is the reason a file cannot quietly go unrun: the
# `/logs` endpoint's tests shipped without a target and so were never covered
# by `bazel test //...`, the canonical runner.
#
#   fakes — the test includes test/fakes.dart, which imports multicast_dns and
#           vm_service whatever the test itself imports.
#   tls   — the test includes test/tls_fixture.dart, the self-signed
#           certificate the TLS serving cases need.
#   loopbacks — the test includes test/loopbacks.dart, which measures the
#           loopback families this host can assign. Any test asserting what a
#           server bound for `localhost` needs it: the answer differs per host.
#   lifetime — the test includes test/test_lifetime.dart, which binds a spawned
#           process to the test that started it. The e2e harness is the only
#           other user; it lives here so `bazel test //...` covers it.
#   harness — the test includes test/e2e/dev_tool_e2e_harness.dart, for the
#           same reason: the e2e files it serves are not Bazel targets (they
#           invoke `bazel` themselves), so its own behaviour would otherwise be
#           covered by nothing. Implies `lifetime`, which it imports.
#   deps  — packages the test imports directly, beyond :lib and test.
_TEST_DEPS = [
    ":lib",
    "@dev_tool_deps//:test",
]

_FAKES_DEPS = [
    "@dev_tool_deps//:multicast_dns",
    "@dev_tool_deps//:vm_service",

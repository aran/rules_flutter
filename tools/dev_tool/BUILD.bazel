[dart_test(
    name = name,
    srcs = (["test/fakes.dart"] if cfg.get("fakes") else []) +
           (["test/tls_fixture.dart"] if cfg.get("tls") else []) +
           (["test/loopbacks.dart"] if cfg.get("loopbacks") else []) +
           (["test/test_lifetime.dart"] if cfg.get("lifetime") else []) +
           (["test/e2e/dev_tool_e2e_harness.dart"] if cfg.get("harness") else []),
    data = cfg.get("data", []),
    main = "test/%s.dart" % name,
    deps = _TEST_DEPS +
           (_FAKES_DEPS if cfg.get("fakes") else []) +
           cfg.get("deps", []),
) for name, cfg in _UNIT_TESTS.items()]

# Outside `_UNIT_TESTS` because its `srcs` come from `tool/`, which the
# comprehension above cannot express — every flag there names a file under
# `test/`.
#
# `tool/e2e.dart` is the e2e suite's own runner: the thing that decides whether
# a run counts. It is not under `lib/`, so neither `:lib` nor the analyze test
# reaches it, and until this target existed the only check on its verdict was
# reading the sentence it printed. That is how it came to answer "nothing was
# selected to run" for a run whose one test had just failed.
dart_test(
    name = "e2e_runner_test",
    srcs = ["tool/e2e.dart"],
    main = "test/e2e_runner_test.dart",
    deps = _TEST_DEPS,
)

# Every test target on this package, however it was declared. The analysis
# targets below are generated from this rather than from `_UNIT_TESTS`, so a
# test declared outside the map cannot be run without being analyzed.
_ALL_TESTS = _UNIT_TESTS.keys() + ["e2e_runner_test"]

# The same static-analysis bar the production sources are held to, applied to
# the tests. Test sources were never analyzed at all until this existed: a
# `dart_test` compiles its `main` to a kernel, which rejects broken code but is
# indifferent to everything `dart analyze --fatal-infos` reports — two dead
# imports sat in committed test files with every target green.
#
# A test's `main` and its `srcs` helpers belong to no package's `lib/`, so they
# cannot be collected into a `dart_library` (rules_dart rejects `srcs` outside
# `lib/`, since a `package:` URI could never reach them). They reach the
# analyzer through the `dart_test`'s own `DartAnalyzableInfo` instead, which is
# why this is one target per test rather than one for the whole directory.
#
# Generated from `_ALL_TESTS` rather than written out, so a new entry is
# analyzed the day it is added and no test file can be covered by a run target
# but missed by an analysis one.
[dart_analyze_test(
    name = "%s_analyze" % name,
    size = "small",
    target = ":%s" % name,
) for name in _ALL_TESTS]

# The Dart in this package that belongs to no package's `lib/` and to no test
# target: every file under `test/e2e/`, and every script under `tool/` that is
# not already carried by a test's `srcs`. Nothing analyzed any of it. Closing
# the agent-surface work meant running `dart analyze` over
# `test/e2e/agent_e2e_test.dart` by hand, because there was nothing to run
# instead, and an analyzer error had already been found sitting in a test file.
#
# These files are not test targets because they invoke `bazel` themselves — the
# harness shells out to `bazel info`, `bazel build` and a whole `flutter_bazel
# run` — so a `dart_test` over one would nest a Bazel invocation inside a Bazel
# test action. That is a reason they cannot be *run* by Bazel. It is not a
# reason they cannot be *analyzed*: `dart_analyze_test` reads
# `DartAnalyzableInfo` and stages sources, and never asks for its operand's
# compiled output, so a handle that is never run still carries them to the
# analyzer. `e2e/codegen` already does this for its generator scripts —
# existing only to be analyzed is the point.
#
# `main` is `tool/e2e.dart` because a `dart_binary` needs one, and the suite's
# own runner is the non-arbitrary root of everything here. Everything else
# rides in `srcs`: `DartAnalyzableInfo` carries `[main] + srcs`, and the
# analyzer reports on every file staged into the project whether or not `main`
# imports it. One staging, not nineteen. `test_lifetime.dart` and
# `tls_fixture.dart` come along because files under `test/e2e/` reach them by
# relative import (`../test_lifetime.dart`); both are already analyzed through
# their own tests, and staging a file twice costs nothing.
#
# `glob`, where every other list in this file is written out by hand. The
# hand-list is load-bearing for the unit tests: a file there does not *run*
# until someone adds it, so the list cannot fall behind what runs. These files
# are discovered by `dart test` instead, so nothing would ever force a new one
# into a list — a list here would rebuild the exact defect this target closes.
# The glob tracks the discovery mechanism, so the analyzed set follows the run
# set by construction — recursively, because that is what it is tracking:
# `dart test test/e2e/` descends into subdirectories, so a flat `test/e2e/*`
# would leave a test in one of them running with nothing analyzing it.
#
# `compile_mode = "kernel"`: the compile is a byproduct nobody consumes, and
# only `tool/e2e.dart`'s own closure is compiled — the globbed files are
# unimported — so this is the cheapest way to satisfy the rule. A script that
# imports a package missing from `deps` fails this target loudly, as an
# unresolved import, which is the intended way to learn it needs one.
#
# Not a target to run: `bazel run` on it would start the real e2e suite from a
# runfiles directory. Run the suite the documented way, with
# `dart run tools/dev_tool/tool/e2e.dart`.
dart_binary(
    name = "loose_sources",
    srcs = glob(["test/e2e/**/*.dart"]) + glob(
        ["tool/**/*.dart"],
        exclude = ["tool/e2e.dart"],
    ) + [
        "test/test_lifetime.dart",
        "test/tls_fixture.dart",
    ],
    compile_mode = "kernel",
    main = "tool/e2e.dart",
    visibility = ["//visibility:private"],
    deps = _TEST_DEPS + _PATH_DEP + ["@dev_tool_deps//:vm_service"],
)

dart_analyze_test(
    name = "loose_sources_analyze",
    size = "small",
    target = ":loose_sources",
)

# Every `.dart` file in this package, in one target rather than split the way
# the analyze tests above are. `dart_format_test` does have a `target=`
# attribute, but handed files directly it needs no `DartAnalyzableInfo` — so it
# carries none of the reason `:loose_sources` and the per-test analyze loop
# exist: format checking was never blocked on a library or test owning the file.
#
# Four patterns, not `**/*.dart`: `.probes/` sits beside `bin/`, `lib/`,
# `test/`, and `tool/` in this package and is gitignored scratch space (see
# `.gitignore`), never reviewed or committed. A blanket recursive glob would
# pull it under enforcement anyway, since `glob()` does not consult
# `.gitignore` — these four are exactly the trees `:lib`, `:flutter_bazel`,
# the `_UNIT_TESTS` loop, and `:loose_sources` already draw `srcs` from above.
dart_format_test(
    name = "format_test",
    size = "small",
    srcs = glob([
        "bin/**/*.dart",
        "lib/**/*.dart",
        "test/**/*.dart",
        "tool/**/*.dart",
    ]),
    # Matches this package's `pubspec.yaml` (`sdk: ^3.12.0`); the rule's
    # `latest` default would enforce a style `dart format` here cannot
    # produce. See docs/TESTING.md.
    language_version = "3.12",
    options = "//:analysis_options.yaml",
)

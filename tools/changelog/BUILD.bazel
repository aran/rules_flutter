load("@rules_dart//dart:defs.bzl", "dart_binary")
load("@rules_multitool//multitool:workspace_root.bzl", "workspace_root")

# `bazel run //tools/changelog` prints the unreleased release notes;
# `-- --tag vX.Y.Z` previews them under that version.
workspace_root(
    name = "changelog",
    args = [
        "--config",
        "cliff.toml",
        "--unreleased",
        "--strip",
        "header",
    ],
    tool = "@multitool//tools/git-cliff",
)

# Checks commit messages against the commit policy in AGENTS.md:
# `-- <message-file>` from the commit-msg hook, `-- --range A..B` in CI.
dart_binary(
    name = "check",
    main = "check_commit_messages.dart",
)

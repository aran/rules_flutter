load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_dart//dart:defs.bzl", "dart_analysis_options")

# This workspace's one `analysis_options.yaml`, listed by //dev:analysis_config
# for the `dart_analyze` aspect `.bazelrc` enables under `bazel test`.
dart_analysis_options(
    name = "analysis_options",
    src = "analysis_options.yaml",
    visibility = ["//dev:__pkg__"],
)

# `pubspec.lock` is the lock of the tool workspace (`dev_tool_deps` in
# MODULE.bazel); the Maven lock is what consumers get, read by the test that
# keeps its androidx versions together.
exports_files(
    ["pubspec.lock"],
    visibility = ["//visibility:public"],
)

exports_files(
    ["rules_flutter_maven_install.json"],
    visibility = ["//tools/maven_locks:__pkg__"],
)

package_metadata(
    name = "package_metadata",
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
    visibility = ["//visibility:public"],
)

license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:Apache-2.0",
    text = "LICENSE",
)

# The BUILD files and .bzl files of every package a consumer's copy of the
# module has, for //tools/bzl_deps_guard. Each package's `bzl_library_inputs`
# holds its own and those of the packages below it
# (tools/bzl_deps_guard/inputs.bzl). The packages left out are
# those `.gitattributes` keeps out of the release archive; `flutter/tests` is
# left out by //flutter.
filegroup(
    name = "bzl_library_inputs",
    srcs = [
        "//%s:bzl_library_inputs" % package
        for package in subpackages(
            include = ["**"],
            exclude = [
                # Bazel's links into its output trees.
                "bazel-*",
                ".github/**",
                "dev",
                "tools/ci_matrix",
                "tools/e2e_copy_guard",
                "tools/vm",
            ],
        )
    ],
    visibility = ["//tools/bzl_deps_guard:__pkg__"],
)

"""The repository of Flutter's signed FlutterMacOS.xcframework of one mode.

`flutter build macos-framework` copies the engine cache's
`darwin-x64[-<mode>]/framework.zip`, a `FlutterMacOS.xcframework` that Flutter
signed, and keeps that signature. The macOS apps rules_flutter builds use the
bare `FlutterMacOS.framework.zip` instead, so this archive is a repository of
its own, fetched only by a macOS add-to-app build of its mode. The release one
is 165 MB, most of it the engine's dSYM, which upstream ships too.
"""

load(":archives.bzl", "archive", "archive_repo")
load(":artifact_urls.bzl", "engine_artifact_url", "macos_xcframework_artifact_path")

_BUILD = """# Generated by flutter_macos_xcframework_repo.bzl
filegroup(
    name = "xcframework",
    srcs = glob(["FlutterMacOS.xcframework/**"]),
    visibility = ["//visibility:public"],
)

exports_files(
    ["FlutterMacOS.xcframework/macos-arm64_x86_64/FlutterMacOS.framework/Versions/A/FlutterMacOS"],
    visibility = ["//visibility:public"],
)
"""

def flutter_macos_xcframework_repo(name, engine_revision, mode, sha256 = ""):
    """Declares the repository of Flutter's signed FlutterMacOS.xcframework (`framework.zip`) of one build mode.

    Args:
        name: The repository's name.
        engine_revision: The engine commit the artifact is published under.
        mode: `debug`, `profile` or `release`.
        sha256: Expected SHA-256 of `framework.zip`.
    """
    if mode not in ["debug", "profile", "release"]:
        fail("flutter_macos_xcframework_repo `{}`: mode is `debug`, `profile` or `release`, not `{}`".format(name, mode))
    artifact_path = macos_xcframework_artifact_path(mode)
    archive_repo(
        name = name,
        archives = [archive(artifact_path, engine_artifact_url(engine_revision, artifact_path), sha256)],
        files = {"BUILD.bazel": _BUILD},
    )

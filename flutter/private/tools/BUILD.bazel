load("@rules_dart//dart:defs.bzl", "dart_binary", "dart_test")
load("//flutter/private:common.bzl", "HOST_COMPATIBLE")

# The sources of tools built into standalone executables. Exported so their unit
# tests below can import them via `srcs`. Build actions reach them through their
# compiled `dart_binary` targets rather than by file label.
exports_files(
    [
        "android_bundle.dart",
        "generate_asset_manifest.dart",
        "bundle_app.dart",
        "compile_shader.dart",
        "kernel_filter.dart",
        "macho_edit.dart",
        "merge_android_manifests.dart",
        "merge_plists.dart",
        "strip_native_libs.dart",
        "web_template.dart",
        "xtool_pack.dart",
        "flutter_test_runner.dart",
        "bazel_test_protocol.dart",
    ],
    visibility = ["//flutter:__subpackages__"],
)

dart_binary(
    name = "android_bundle",
    compile_mode = "kernel",
    main = "android_bundle.dart",
    modular_kernel = False,
    target_compatible_with = HOST_COMPATIBLE,
    visibility = ["//flutter:__subpackages__"],
)

dart_binary(
    name = "pub_runner",
    compile_mode = "exe",
    main = "pub.dart",
    target_compatible_with = HOST_COMPATIBLE,
    visibility = ["//flutter:__subpackages__"],
    deps = ["@rules_dart//dart/runfiles"],
)


# Guards a web compile's declared sources before `web_template` runs it (see
# `web_guard.dart`): a `dart_binary` rather than part of `web_template`
# because `web_template` compiles with an empty package config and cannot
# import the guard library. `compile_mode = "exe"` keeps the guarded compile's
# inputs minimal: the guard runs as a self-contained native executable, so the
# action stages only the guard and its manifest — never the exec Dart VM's
# snapshots and debug symbols.
dart_binary(
    name = "web_guard",
    srcs = ["directive_guard.dart"],
    compile_mode = "exe",
    main = "web_guard.dart",
    modular_kernel = False,
    target_compatible_with = HOST_COMPATIBLE,
    visibility = ["//flutter:__subpackages__"],
    deps = ["@rules_dart//dart/guard:directive_guard"],
)

dart_binary(
    name = "xtool_pack",
    srcs = [
        "crc32.dart",
        "macho_edit.dart",
        "sha256.dart",
    ],
    compile_mode = "exe",
    main = "xtool_pack.dart",
    target_compatible_with = HOST_COMPATIBLE,
    visibility = ["//flutter:__subpackages__"],
)

# Unit tests for the tools above.
#
# Each test imports its tool by relative path (`../merge_plists.dart`), so the
# tool is a `srcs` entry rather than a dep: these tools are compiled as
# standalone executables for the exec platform, and their unit tests run against
# the source.
#
# A new test file needs an entry here, or nothing runs it.
#
# `@dev_tool_deps//:test` is `package:test` from the one pub hub this workspace
# declares (MODULE.bazel `flutter.pub(name = "dev_tool_deps")`). These tools are
# not part of the dev tool; they share its hub because a second hub would mean a
# second pubspec to resolve and keep pinned for a single test-only dependency.
#
# The value is the tool plus whatever that tool imports beyond `package:test`.
_UNIT_TESTS = {
    "android_bundle_test": ("android_bundle.dart", []),
    "bundle_app_test": ("bundle_app.dart", []),
    "compile_shader_test": ("compile_shader.dart", []),
    "kernel_filter_test": (
        "kernel_filter.dart",
        ["@rules_dart//dart/guard:directive_guard"],
    ),
    "incr_fkc_worker_test": (
        "incr_fkc_worker.dart",
        ["@rules_dart//dart/guard:directive_guard"],
    ),
    "macho_edit_test": ("macho_edit.dart", []),
    "sha256_test": ("sha256.dart", []),
    "generate_asset_manifest_test": ("generate_asset_manifest.dart", []),
    "merge_android_manifests_test": ("merge_android_manifests.dart", []),
    "merge_plists_test": ("merge_plists.dart", []),
    "strip_native_libs_test": ("strip_native_libs.dart", []),
    "chmod_test": ("chmod.dart", []),
    "web_guard_test": (
        "web_guard.dart",
        ["@rules_dart//dart/guard:directive_guard"],
    ),
    "web_template_test": ("web_template.dart", []),
    "xtool_pack_test": ("xtool_pack.dart", []),
    "apk_overlay_test": ("apk_overlay.dart", []),
    "zlib_raw_static_test": ("zlib_raw_trees.dart", []),
    "flutter_test_runner_test": (
        "flutter_test_runner.dart",
        [
            "@dev_tool_deps//:boolean_selector",
            "@rules_dart//dart/runfiles",
        ],
    ),
    "flutter_integration_test_runner_test": (
        "flutter_integration_test_runner.dart",
        [
            "@dev_tool_deps//:boolean_selector",
            "@rules_dart//dart/runfiles",
        ],
    ),
    "bazel_test_protocol_test": (
        "bazel_test_protocol.dart",
        ["@dev_tool_deps//:boolean_selector"],
    ),
    "extract_library_tags_test": ("extract_library_tags.dart", []),
}


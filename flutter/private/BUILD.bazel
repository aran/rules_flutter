load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

# Compilation mode config_settings for select() in macros.
# compilation_mode is preserved across platform transitions (e.g. iOS).
config_setting(
    name = "dbg",
    values = {"compilation_mode": "dbg"},
    visibility = ["//visibility:public"],
)

# Profile mode: `-c opt` with `--@rules_flutter//flutter:profile`. Selects the
# profile engine and gen_snapshot. The flag under any other `-c` matches
# neither this nor `//flutter:release`; `flutter_application` refuses it.
config_setting(
    name = "profile",
    flag_values = {"//flutter:profile": "true"},
    values = {"compilation_mode": "opt"},
    visibility = ["//visibility:public"],
)

# Internal sub-toolchain types so rules only trigger fetching of the lazy
# SDK repositories they actually use (product patched SDK + font-subset,
# AOT gen_snapshot, desktop engine + Linux sysroot, MaterialIcons font).

# Resolved for an x86_64 iOS simulator build (toolchains_repo.bzl).
flutter_missing_slice(
    name = "ios_x86_64_unsupported",
    message = "rules_flutter builds iOS for arm64 only: devices, and the Apple " +
              "Silicon simulator (--ios_multi_cpus=sim_arm64). An x86_64 " +
              "simulator, which an Intel Mac runs, is not supported: " +
              "rules_flutter supports Apple Silicon hosts only.",
    # Analysed only through toolchain resolution: built on its own, it fails.
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# A setting no command line can set, for the two below: what the generated
# registry (toolchains_repo.bzl) selects between to turn a toolchain's
# `target_settings` on or off.
bool_setting(
    name = "never_set",
    build_setting_default = False,
)

config_setting(
    name = "always",
    flag_values = {":never_set": "False"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "never",
    flag_values = {":never_set": "True"},
    visibility = ["//visibility:public"],
)

# What `com.google.guava:listenablefuture` is in `@rules_flutter_maven`: the
# 1.0 jar on the compile classpath only. See the override in MODULE.bazel.
java_library(
    name = "listenablefuture_compile_only",
    neverlink = True,
    visibility = ["//visibility:public"],
    exports = ["@rules_flutter_maven//:original_com_google_guava_listenablefuture"],
)

# Compilation mode config_settings for select() in macros.
# compilation_mode is preserved across platform transitions (e.g. iOS).
config_setting(
    name = "dbg",
    values = {"compilation_mode": "dbg"},
    visibility = ["//visibility:public"],
)

# The configuration a plugin's `Package.swift` calls Release
# (`.when(configuration: .release)`): `flutter build` builds Xcode's Release
# configuration in profile and release mode, and Bazel builds both with `-c opt`.
config_setting(
    name = "swiftpm_release",
    values = {"compilation_mode": "opt"},
    visibility = ["//visibility:public"],
)

# The app a plugin's `Package.swift` is evaluated for, when the manifest decides
# its settings from the app (`swiftpm_app_settings.bzl`): the app's Info.plist
# and the environment the app gives its manifests. An Apple app's plugin
# aggregator sets both, on the edge to the libraries of such plugins only.
label_flag(
    name = "swiftpm_app_info_plist",
    build_setting_default = ":swiftpm_no_app_Info.plist",
    # It describes the app, and no build tool reads it: `scope = "target"`
    # keeps it out of the exec configuration, so setting it rebuilds no tool.
    scope = "target",
    visibility = ["//visibility:public"],
)

string_list_flag(
    name = "swiftpm_app_environment",
    build_setting_default = [],
    # It describes the app, and no build tool reads it: `scope = "target"`
    # keeps it out of the exec configuration, so setting it rebuilds no tool.
    scope = "target",
    visibility = ["//visibility:public"],
)

# Profile mode: `-c opt` with `--@rules_flutter//flutter:profile`. Selects the
# profile engine and gen_snapshot. The flag under any other `-c` matches
# neither this nor `//flutter:release`; `flutter_application` refuses it.
config_setting(
    name = "profile",
    flag_values = {"//flutter:profile": "true"},
    values = {"compilation_mode": "opt"},
    visibility = ["//visibility:public"],
)

# `--apple_generate_dsym`: rules_apple makes an app's dSYMs, and the app takes
# the engine's too.
config_setting(
    name = "apple_generate_dsym",
    values = {"apple_generate_dsym": "true"},
    visibility = ["//visibility:public"],
)

# `--objc_enable_binary_stripping` in `-c opt`: rules_apple strips an app's
# binary, and the native libraries the app bundles beside it are stripped too.
config_setting(
    name = "objc_binary_stripping",
    values = {
        "compilation_mode": "opt",
        "objc_enable_binary_stripping": "true",
    },
)

apple_binary_stripping(
    name = "apple_binary_stripping",
    strip = select({
        ":objc_binary_stripping": True,
        "//conditions:default": False,
    }),
    visibility = ["//visibility:public"],
)

# The dSYM of the macOS engine of the build mode: the release engine's, from
# the engine source's xcframework slice, and none in debug and profile, as
# `flutter build macos` copies it in release only. A macOS app imports it
# only under `--apple_generate_dsym` (`MACOS_ENGINE_DSYM`), so no other build
# reads the xcframework.
flutter_macos_engine_dsym(
    name = "macos_engine_dsym",
    visibility = ["//visibility:public"],
    xcframework = select({
        ":dbg": None,
        ":profile": None,
        "//conditions:default": "@flutter_macos_engine//:xcframework",
    }),
)

# The Android platforms an APK can be built for, for select() in macros. An
# android_binary builds its dependencies once for each of --@rules_android//flags:android_platforms,
# and a dependency picks what it packages by the platform it is built for.
config_setting(
    name = "android_arm",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:armv7",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "android_arm64",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:aarch64",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "android_x64",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//visibility:public"],
)

# The engine a module AAR's Maven repository carries for the ABI of the
# platform it is built for: the stripped jar of an SDK whose engine is not the
# release's, nothing for the release's (flutter_android_aar.bzl). On any other
# platform it is incompatible, so that `bazel build //...` skips it.
alias(
    name = "aar_engine",
    actual = select({
        ":android_arm": "@flutter_android_engine_arm//:aar_engine",
        ":android_arm64": "@flutter_android_engine_arm64//:aar_engine",
        ":android_x64": "@flutter_android_engine_x64//:aar_engine",
        "//conditions:default": ":no_aar_engine",
    }),
)

filegroup(
    name = "no_aar_engine",
    target_compatible_with = ["@platforms//:incompatible"],
)


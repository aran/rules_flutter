"""The repository of the iproxy the dev tool forwards a wired iPhone's VM service through.

Flutter's own build of libimobiledevice's `iproxy` and the libraries it loads,
laid out the way flutter_tools caches them: each archive in a directory named
for it (`libusbmuxd/iproxy`, `libplist/`, `libimobiledeviceglue/`). The
libraries are found the way flutter_tools finds them, through a
`DYLD_LIBRARY_PATH` of those directories, which the binary's entitlements
allow.

The `flutter` extension declares it; it is fetched only when the dev tool is
built for macOS.
"""

load(":archives.bzl", "archive", "archive_repo")
load(":artifact_urls.bzl", "ios_usb_dependency_url")

visibility("//flutter/...")

_BUILD = """# Generated by flutter_ios_usb_repo.bzl

filegroup(
    name = "iproxy",
    srcs = ["libusbmuxd/iproxy"],
    data = glob(["*/*.dylib", "*/COPYING"]),
    visibility = ["//visibility:public"],
)
"""

def flutter_ios_usb_repo(name, dependencies):
    """Declares the repository of iproxy and its libraries.

    Args:
        name: The repository's name.
        dependencies: `IOS_USB_DEPENDENCIES`: each archive's name to its
            `version` and `sha256`.
    """
    archive_repo(
        name = name,
        archives = [
            archive(
                "{}.zip".format(dep),
                ios_usb_dependency_url(dep, pin.version),
                pin.sha256,
                output = dep,
            )
            for dep, pin in sorted(dependencies.items())
        ],
        files = {"BUILD.bazel": _BUILD},
        checks = [{"path": "libusbmuxd/iproxy", "message": "libusbmuxd.zip has no iproxy"}],
    )

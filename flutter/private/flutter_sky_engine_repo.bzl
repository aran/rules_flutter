"""The `sky_engine` package, which is how the analyzer resolves `dart:ui`.

Two different tools need the `dart:` libraries Flutter adds on top of the Dart
SDK, and they need them in two different forms. The compiler reads kernel:
`flutter_patched_sdk.zip` ships `platform_strong.dill`, and that is why
`flutter/extensions.bzl` deliberately drops `sky_engine` from the resolved pub
packages — the compile already has everything it needs. The analyzer reads
sources, and has no way to open a dill at all, so under that arrangement
`dart:ui` resolves for `flutter build` and fails for `dart analyze`.

What the analyzer looks for is narrow and entirely non-negotiable. It resolves
the literal package URI `package:sky_engine/_embedder.yaml` against the
project's `package_config.json`, and builds its SDK from the `embedded_libs`
map in that file (`analyzer`'s `ContextBuilderImpl._createSdk`). The package
must be named `sky_engine`, and the file must sit at `lib/_embedder.yaml` under
the package root; any other name and the lookup silently finds nothing, leaving
the host Dart SDK in place and every `dart:ui` reference undefined.

`sky_engine.zip` is published beside every other engine artifact, at the engine
revision already pinned in `versions.bzl`, and is ~1.5 MB. It gets its own
repository for the same reason the web SDK and the iOS engine do: it is an
engine artifact, fetched only when something actually analyzes Flutter code.
Hanging it off `flutter_dev_root` would have been cheaper to write and much
worse to use — that repository downloads the entire flutter/flutter tag
tarball, and it exists to be fetched only when `@rules_flutter//flutter:pub`
runs.

The generated package uses `dart_library`'s `resources`, which carries a
package's non-Dart `lib/` members and is newer than the `rules_dart 0.4.9` this
module pins. Nothing in rules_flutter references this repository yet, and Bazel
fetches it only on reference, so the pin is not yet a problem — but the analyze
targets that consume it cannot land until rules_dart ships that attribute and
MODULE.bazel moves to it.

`sky_engine.zip` trims seven SDK-internal part files whose `part` directives
remain in the shipped sources (`lib/_http/http.dart` still names
`embedder_config.dart` and `http_testing.dart`, and likewise for
`lib/_interceptors/interceptors.dart`, `lib/developer/developer.dart` and
`lib/internal/internal.dart`). Neither the compiler nor the analyzer reads
those libraries (`dart:_http` and friends resolve from the Dart SDK), so
nothing ever noticed — until rules_dart's staged-source guard started
requiring every relative target to exist in the staged tree, which fails
every Flutter analysis on the missing files. The repo rule plants a
directive-free stub for each one that is still absent, so the guard's
existence check passes and no scan can trip on the stubs. In download mode
the extracted tree is repo-owned, so the stubs land beside it; in
`local_path` mode the lib tree is mirrored file by file (see
`_mirror_local_lib`) so the stubs land in repo-owned directories — writing
one through a directory symlink would write into the user's SDK.
"""

load(":artifact_urls.bzl", "engine_artifact_url", "require_sha256")
load(":download.bzl", "pinned_download_and_extract")
load(":local_sdk.bzl", "link_local_file", "missing_local_source_message", "resolve_local_sdk_root")

_ROOT_BUILD_TEMPLATE = """# Generated by flutter_sky_engine_repo.bzl

alias(
    name = "sky_engine",
    actual = "//sky_engine",
    visibility = ["//visibility:public"],
)
"""

_PACKAGE_BUILD_TEMPLATE = """# Generated by flutter_sky_engine_repo.bzl
load("@rules_dart//dart:defs.bzl", "dart_library")

# `package_name` is not cosmetic and not derived: the analyzer resolves the
# literal `package:sky_engine/_embedder.yaml`, so this exact name is what makes
# the lookup hit. The remainder glob carries `_embedder.yaml` alongside
# `_internal/allowed_experiments.json` and `fix_data/fix_dart_ui.yaml` — the
# package's non-Dart members, listed by exclusion so a future artifact adding
# one more does not quietly ship a package with a hole in it.
dart_library(
    name = "sky_engine",
    srcs = glob(["lib/**/*.dart"]),
    package_name = "sky_engine",
    resources = glob(
        ["lib/**"],
        exclude = ["lib/**/*.dart"],
    ),
    visibility = ["//visibility:public"],
)

# Every mirrored or extracted file stays addressable by label, so tests can
# assert on individual files (for example that a trimmed-part stub was
# planted) without compiling the package.
exports_files(glob(["lib/**"]))
"""

# Backs one dangling `part` directive: `sky_engine.zip` omits SDK-internal
# part files the shipped sources still name (see the module docstring), and
# rules_dart's staged-source guard refuses a relative target no staged file
# backs. The stub carries no directives, so no scan trips on it, and neither
# the compiler nor the analyzer reads these libraries (`dart:_http` and
# friends resolve from the Dart SDK), so its emptiness is never observed.
_TRIMMED_PART_STUB = """\
// Generated by flutter_sky_engine_repo.bzl: `sky_engine.zip` omits this
// file while a shipped `part` directive still names it. Neither the
// compiler nor the analyzer reads it; it exists so the staged-source guard
// finds a staged file behind every relative target.
"""

# SDK-internal part files `sky_engine.zip` omits while the shipped sources
# still name them in `part` directives, relative to the package root.
_TRIMMED_PARTS = [
    "lib/_http/embedder_config.dart",
    "lib/_http/http_testing.dart",
    "lib/_interceptors/js_array.dart",
    "lib/_interceptors/js_number.dart",
    "lib/_interceptors/js_string.dart",
    "lib/developer/http_profiling.dart",
    "lib/internal/patch.dart",
]

def _plant_trimmed_part_stubs(repository_ctx):
    """Plants a stub for every trimmed part file that is still absent.

    See the module docstring for why the package omits these files. A stub
    carries no directives, so no guard scan trips on it, and neither
    the compiler nor the analyzer reads these libraries, so the stubs'
    emptiness is never observed. Written only when missing: a future artifact
    restoring a file keeps its real contents. Callers must plant into
    repo-owned directories, never through a directory symlink into the user's
    SDK (see `_mirror_local_lib`).
    """
    for stub in _TRIMMED_PARTS:
        if not repository_ctx.path("sky_engine/" + stub).exists:
            repository_ctx.file("sky_engine/" + stub, _TRIMMED_PART_STUB)

def _mirror_local_lib(repository_ctx, sdk_root, sdk_rel, repo_rel, what):
    """Mirrors one local SDK directory into the repo file by file.

    The same visible tree `link_local_dir` would link, but as real repo
    directories holding one symlink per file instead of a single directory
    symlink — so the fetch can add repo-owned files (the trimmed-part stubs)
    beside the links without writing through into the user's SDK, which stays
    read-only. The source tree is watched, so an SDK edit refetches the
    repository, exactly as with `link_local_dir`.
    """
    source = sdk_root.get_child(sdk_rel)
    if not source.exists:
        fail(missing_local_source_message(
            sdk_rel,
            what,
            str(repository_ctx.attr.local_path),
        ))
    repository_ctx.watch_tree(source)
    src = str(source)
    if "windows" in repository_ctx.os.name.lower():
        result = repository_ctx.execute([
            "cmd",
            "/c",
            "dir",
            "/s",
            "/b",
            "/a-d",
            src.replace("/", "\\"),
        ])
        if result.return_code != 0:
            fail(
                "flutter local SDK: could not list {what} ({src}); {err}".format(
                    what = what,
                    src = src,
                    err = result.stderr.strip(),
                ),
            )
        raws = [
            line.strip().replace("\\", "/")
            for line in result.stdout.split("\n")
        ]
    else:
        result = repository_ctx.execute([
            "find",
            src,
            "(",
            "-type",
            "f",
            "-o",
            "-type",
            "l",
            ")",
            "-print",
        ])
        if result.return_code != 0:
            fail(
                "flutter local SDK: could not list {what} ({src}); {err}".format(
                    what = what,
                    src = src,
                    err = result.stderr.strip(),
                ),
            )
        raws = [line.strip() for line in result.stdout.split("\n")]
    files = []
    for raw in raws:
        if not raw:
            continue
        if not raw.lower().startswith(src.lower() + "/"):
            fail(
                "flutter local SDK: listing {what} escaped its root: {line}".format(
                    what = what,
                    line = raw,
                ),
            )
        files.append(raw[len(src) + 1:])
    if not files:
        fail((
            "flutter local SDK: listed no files under {what} ({src}); " +
            "refusing to ship an empty package"
        ).format(what = what, src = src))
    for rel in files:
        repository_ctx.symlink(
            repository_ctx.path(src + "/" + rel),
            repo_rel + "/" + rel,
        )

def _flutter_sky_engine_repo_impl(repository_ctx):
    if getattr(repository_ctx.attr, "local_path", ""):
        # A real install materializes the package under bin/cache/pkg; the
        # archive's one-level `sky_engine/` nesting is that same package root.
        # Only `lib/` and the pubspec surface in a real repo directory: the
        # lib tree is mirrored file by file (`_mirror_local_lib`) rather than
        # linked as one directory, so the trimmed-part stubs below land in
        # repo-owned directories — writing one through a directory symlink (or
        # writing the BUILD files inside a linked tree) would write through
        # into the user's SDK. The BUILD files below land in repo-owned
        # directories, so the SDK tree is never written.
        sdk_root = resolve_local_sdk_root(repository_ctx, getattr(repository_ctx.attr, "local_path", ""))
        _mirror_local_lib(
            repository_ctx,
            sdk_root,
            "bin/cache/pkg/sky_engine/lib",
            "sky_engine/lib",
            "the sky_engine analyzer package sources",
        )
        link_local_file(
            repository_ctx,
            sdk_root,
            "bin/cache/pkg/sky_engine/pubspec.yaml",
            "sky_engine/pubspec.yaml",
            "the sky_engine analyzer package pubspec",
        )
        _plant_trimmed_part_stubs(repository_ctx)
        repository_ctx.file("sky_engine/BUILD.bazel", _PACKAGE_BUILD_TEMPLATE)
        repository_ctx.file("BUILD.bazel", _ROOT_BUILD_TEMPLATE)
        return

    # Extracted at the repository root rather than under an `output` directory,
    # because the archive already nests everything one level under
    # `sky_engine/` — which is exactly the package root the analyzer wants, and
    # naming it twice would only bury it deeper. (The archive also carries a
    # stray top-level `LICENSE.zip_old_location.md`, which is why this does not
    # use `stripPrefix`: stripping would silently drop it.)
    url = engine_artifact_url(
        repository_ctx.attr.engine_revision,
        "sky_engine.zip",
        getattr(repository_ctx.attr, "engine_base_url", ""),
    )
    pinned_download_and_extract(
        repository_ctx,
        url = url,
        sha256 = require_sha256(repository_ctx.attr.sha256, url),
    )

    # Plant a stub for every trimmed part file that is still absent, so the
    # staged-source guard finds a staged file behind each dangling `part`
    # directive. Written only when missing: a future artifact restoring a
    # file keeps its real contents.
    _plant_trimmed_part_stubs(repository_ctx)

    # The Bazel package has to sit at `sky_engine/`, not at the repository
    # root: `dart_library` derives its `lib_root` from the label, and requires
    # every source to live under `<lib_root>/lib/`. Declared at the root, the
    # sources would be at `sky_engine/lib/...` against a `lib_root` expecting
    # `lib/...`, and the rule rejects that outright.
    repository_ctx.file("sky_engine/BUILD.bazel", _PACKAGE_BUILD_TEMPLATE)

    # …which would leave consumers writing `@flutter_sky_engine//sky_engine`,
    # naming the package twice. The alias buys back the obvious label.
    repository_ctx.file("BUILD.bazel", _ROOT_BUILD_TEMPLATE)

flutter_sky_engine_repo = repository_rule(
    _flutter_sky_engine_repo_impl,
    doc = "Downloads the `sky_engine` package, whose `lib/_embedder.yaml` is how the analyzer resolves `dart:ui` and the rest of Flutter's `dart:` libraries.",
    attrs = {
        "engine_revision": attr.string(
            doc = "The engine commit hash the artifact is published under. " +
                  "Empty means a local SDK (with `local_path`).",
            default = "",
        ),
        "engine_base_url": attr.string(
            doc = "Optional replacement origin for the engine revision " +
                  "directory (an enterprise build). Empty means the default GCS base.",
            default = "",
        ),
        "local_path": attr.string(
            doc = "Optional path to a pre-extracted Flutter SDK " +
                  "(bin/cache layout) to source every artifact from instead " +
                  "of the network. Mutually exclusive with downloading.",
            default = "",
        ),
        "sha256": attr.string(
            doc = "Expected SHA-256 of `sky_engine.zip`. Unused with `local_path`.",
            default = "",
        ),
    },
)

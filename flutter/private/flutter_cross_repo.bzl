"""The repository of the Android gen_snapshot of one cross-compilation pair.

Downloads the cross-compiling release gen_snapshot that runs on one host and
compiles for one Android ABI. The stock engine source (`flutter_stock_engine_repo.bzl`)
makes it the `gen_snapshot` slice of the target.

(The iOS gen_snapshot is bundled in the iOS engine artifact, so iOS has no repo
of its own.)
"""

load(":archives.bzl", "archive", "archive_repo")
load(":artifact_urls.bzl", "engine_artifact_url", "gen_snapshot_cross_artifact_path")
load(":engine_helpers.bzl", "gen_snapshot_binary_name", "gen_snapshot_host_platform")

visibility("//flutter/...")

def flutter_cross_compilation_repo(name, engine_revision, host_platform, target_platform, gen_snapshot_sha256 = ""):
    """Declares the repository of the release gen_snapshot of one host and Android target.

    Args:
        name: The repository's name.
        engine_revision: The engine commit the artifact is published under.
        host_platform: The platform gen_snapshot runs on.
        target_platform: The Android platform it compiles for.
        gen_snapshot_sha256: SHA-256 of the gen_snapshot archive.
    """
    gen_snapshot_bin = gen_snapshot_binary_name(host_platform)
    artifact_path = gen_snapshot_cross_artifact_path(target_platform, "release", gen_snapshot_host_platform(host_platform))
    archive_repo(
        name = name,
        archives = [archive(artifact_path, engine_artifact_url(engine_revision, artifact_path), gen_snapshot_sha256)],
        # exports_files does not check that the file exists, so a name that
        # misses the download would only fail the first AOT compile.
        checks = [{"path": gen_snapshot_bin, "message": "{} has no {}".format(artifact_path, gen_snapshot_bin)}],
        files = {
            "BUILD.bazel": '# Generated by flutter_cross_repo.bzl\nexports_files(["{}"], visibility = ["//visibility:public"])\n'.format(gen_snapshot_bin),
        },
    )

"""The repository of the Android Flutter engine artifacts of one ABI.

Downloads the Android engine (flutter.jar) which contains the Java
embedding classes (FlutterActivity, FlutterEngine, etc.) and the
native libflutter.so for the target ABI. The release (AOT) and debug (JIT)
jars for an ABI live in one repo, and the profile jar in a repo of its own that
is fetched only by a profile build. The stock engine source's
`android-<arch>/<mode>:engine` slices are over these jars; the stripped copy
`@flutter_android_engine_<arch>//:stripped` follows the build mode and the
selected SDK, and is generated beside the SDKs (flutter_face_repo.bzl).

This is lazy — only fetched when an Android build target is used.
"""

load(":archives.bzl", "archive", "archive_repo")
load(":artifact_urls.bzl", "android_engine_artifact_path", "engine_artifact_url")

visibility("//flutter/...")

def flutter_android_engine_repo(name, engine_revision, android_arch, release_sha256 = "", debug_sha256 = ""):
    """Declares the repository of the Android engine of one ABI, release and debug.

    Args:
        name: The repository's name.
        engine_revision: The engine commit the artifacts are published under.
        android_arch: Android architecture (arm64, x64, arm, x86, riscv64).
        release_sha256: Expected SHA-256 of the release archive.
        debug_sha256: Expected SHA-256 of the debug archive.
    """
    release = android_engine_artifact_path(android_arch, "release")
    debug = android_engine_artifact_path(android_arch, "debug")
    archive_repo(
        name = name,
        archives = [
            # Release engine (AOT) at the repo root.
            archive(release, engine_artifact_url(engine_revision, release), release_sha256),
            # Debug engine (JIT) under debug/ — its flutter.jar would otherwise
            # collide with the release one at the repo root.
            archive(debug, engine_artifact_url(engine_revision, debug), debug_sha256, output = "debug"),
        ],
        files = {"BUILD.bazel": _BUILD},
    )

_BUILD = """# Generated by flutter_android_engine_repo.bzl
#
# flutter.jar is a fat jar containing:
# - Java embedding classes (FlutterActivity, FlutterEngine, etc.)
# - Native libflutter.so for the target ABI at lib/<abi>/libflutter.so
#
# Release (AOT) is `flutter.jar`; debug (JIT) is `debug/flutter.jar`.

exports_files(
    ["flutter.jar", "debug/flutter.jar"],
    visibility = ["//visibility:public"],
)
"""

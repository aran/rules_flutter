"""The repository of the iOS Flutter engine of one build mode.

Downloads the release (AOT, device) or the debug (JIT, simulator) iOS engine
(Flutter.xcframework) into a repository of its own, so a build fetches only the
engine of the mode it builds: a simulator build never downloads the release
engine, nor a release build the debug one. The profile engine lives in its own
repository too. The stock engine source's `ios/<mode>:engine` slices are over
these files; `@flutter_ios_engine//:Flutter_xcframework` follows the build mode
and the selected SDK, and is generated beside the SDKs (flutter_face_repo.bzl).
"""

load(":archives.bzl", "archive", "archive_repo")
load(":artifact_urls.bzl", "engine_artifact_url", "ios_engine_artifact_path")

visibility("//flutter/...")

def flutter_ios_engine_repo(name, engine_revision, mode, sha256 = ""):
    """Declares the repository of the iOS engine (Flutter.xcframework) of one build mode.

    Args:
        name: The repository's name.
        engine_revision: The engine commit the artifact is published under.
        mode: The engine's build mode: `debug` (JIT, simulator) or `release`
            (AOT, device). The release archive also carries the iOS
            gen_snapshot that the macOS-to-iOS cross-compile toolchain uses.
        sha256: Expected SHA-256 of the archive.
    """
    if mode not in ["debug", "release"]:
        fail("flutter_ios_engine_repo `{}`: mode is `debug` or `release`, not `{}`".format(name, mode))
    path = ios_engine_artifact_path(mode)
    archive_repo(
        name = name,
        archives = [archive(path, engine_artifact_url(engine_revision, path), sha256)],
        files = {"BUILD.bazel": _BUILD},
    )

_BUILD = """# Generated by flutter_ios_engine_repo.bzl

filegroup(
    name = "Flutter_xcframework",
    srcs = glob(["Flutter.xcframework/**"]),
    visibility = ["//visibility:public"],
)

exports_files(
    glob(["**"]),
    visibility = ["//visibility:public"],
)
"""

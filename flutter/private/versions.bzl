"""Flutter engine release versions and their metadata.

Each version entry maps a Flutter SDK version string to a struct containing:
- engine_revision: The engine commit hash (used in artifact URLs)
- framework_revision: The commit hash of the release tag, which `FlutterVersion`
  reports (shortened) as the framework revision
- dart_version: The version of the Dart SDK the engine bundles (its
  `dart-sdk/version` file; checked against the downloaded SDK)
- material_fonts_url: GCS path of the Material icon font bundle
- source_sha256: sha256 of the GitHub source tarball for the release tag

`source_sha256` is **required on every entry**, and read only through
`flutter_source_sha256()` below, so that a missing one is a clear error rather
than an unverified download. Three repository rules fetch the framework source
tarball named by `flutter_source_tarball_url()` in
//flutter/private:artifact_urls.bzl, and all of them are pinned against this one
value: `flutter_framework_package` and `flutter_pub_package` (the latter once
per other SDK package in the lock), `flutter_gen_l10n_repo`, and
`flutter_dev_root_repo`.

A mismatch is a loud, intended failure. GitHub's autogenerated tag tarballs
have been re-compressed before, so a break means re-hash the release, not work
around the check. Pinning also lets Bazel's content-addressed repository cache
serve every one of those fetches from a single download; an unpinned fetch can
never be deduplicated that way.

ARTIFACT_CHECKSUMS maps version → artifact_path → sha256.
"""

load("//flutter/private:artifact_urls.bzl", "flutter_source_tarball_url")

FLUTTER_VERSIONS = {
    "3.50.0": struct(
        engine_revision = "371f77202a73e8dff57a8b3bff75bca55c090aee",
        framework_revision = "ab2912035e160d9cad6306df307576da6128ebdb",
        dart_version = "3.14.0",
        material_fonts_url = "flutter_infra_release/flutter/fonts/3012db47f3130e62f7cc0beabff968a33cbec8d8/fonts.zip",
        # sha256 of the GitHub source tarball. Required: every
        # fetch of the framework source is pinned against it.
        source_sha256 = "6a658d110698a5c3db2af7df4f14eab081997a564690df8be3a46bb1ad05cf68",
    ),
}

# The hosted packages the Flutter SDK's own packages depend on at exactly one
# version, per Flutter version and SDK package (the `dependencies:` of
# `packages/*/pubspec.yaml`, `flutter_tools` aside). pub resolves any app that
# uses an SDK package to those versions, so a build with one copy of each
# package must not move a package past one: `flutter_pub.from_lock` fails when a
# lock would. `bazel run //tools/update_flutter_version -- <version>` prints the
# entry.
FLUTTER_SDK_EXACT_PINS = {
    "3.50.0": {
        "flutter": {
            "material_color_utilities": "0.13.0",
        },
        "flutter_test": {
            "matcher": "0.12.20",
            "test_api": "0.7.14",
        },
    },
}

# The packages of each Flutter version's source: the directories of its
# `packages/` with a pubspec. A Flutter SDK package of a lock is extracted from
# that source's `packages/<name>` alone, and a name not listed fails its fetch,
# before any download, saying to re-resolve the lock. `bazel run
# //tools/update_flutter_version -- <version>` prints the entry.
FLUTTER_SDK_PACKAGES = {
    "3.50.0": [
        "flutter",
        "flutter_driver",
        "flutter_goldens",
        "flutter_localizations",
        "flutter_test",
        "flutter_tools",
        "flutter_web_plugins",
        "fuchsia_remote_debug_protocol",
        "integration_test",
    ],
}

def flutter_sdk_packages(flutter_version):
    """Returns the packages of a release's source.

    Args:
        flutter_version: Flutter release tag (e.g. "3.50.0"). Must be a key of
            FLUTTER_VERSIONS.

    Returns:
        The names of the directories of its `packages/` with a pubspec.
    """
    packages = FLUTTER_SDK_PACKAGES.get(flutter_version)
    if packages == None:
        fail((
            "No SDK packages recorded for Flutter {v}.\n" +
            "Add its entry to FLUTTER_SDK_PACKAGES in " +
            "//flutter/private:versions.bzl; " +
            "`bazel run //tools/update_flutter_version -- {v}` prints it."
        ).format(v = flutter_version))
    return packages

def require_supported_flutter_version(flutter_version):
    """Fails, naming the supported releases, unless the release is one.

    Args:
        flutter_version: A Flutter release tag the user asked for.
    """
    if flutter_version not in FLUTTER_VERSIONS:
        fail((
            "Flutter {v} is not supported. Supported versions: {supported}.\n" +
            "Set flutter.toolchain(flutter_version = ...) to one of them."
        ).format(v = flutter_version, supported = ", ".join(FLUTTER_VERSIONS.keys())))

def flutter_sdk_exact_pins(flutter_version):
    """Returns the exact pins of a release's SDK packages.

    Args:
        flutter_version: Flutter release tag (e.g. "3.50.0"). Must be a key of
            FLUTTER_VERSIONS.

    Returns:
        A dict of SDK package name to a dict of the packages it depends on
        exactly and the versions it pins.
    """
    pins = FLUTTER_SDK_EXACT_PINS.get(flutter_version)
    if pins == None:
        fail((
            "No exact SDK pins recorded for Flutter {v}.\n" +
            "Add its entry to FLUTTER_SDK_EXACT_PINS in " +
            "//flutter/private:versions.bzl; " +
            "`bazel run //tools/update_flutter_version -- {v}` prints it."
        ).format(v = flutter_version))
    return pins

def flutter_source_sha256(flutter_version):
    """Returns the recorded sha256 of a release's GitHub source tarball.

    Read through this accessor rather than off the struct directly, so that an
    entry added without a checksum fails at extension evaluation — naming the
    omission — instead of silently producing an unverified download. The check
    is eager because the source tarball is on the critical path of any build
    that uses a Flutter SDK package, which is nearly all of them.

    Args:
        flutter_version: Flutter release tag (e.g. "3.50.0"). Must be a key of
            FLUTTER_VERSIONS.

    Returns:
        The 64-character hex sha256 string.
    """
    meta = FLUTTER_VERSIONS[flutter_version]
    sha256 = getattr(meta, "source_sha256", "")
    if not sha256:
        fail((
            "No source tarball checksum recorded for Flutter {v}, so its " +
            "framework source cannot be fetched safely.\n" +
            "Add `source_sha256` to the {v} entry in " +
            "//flutter/private:versions.bzl. It is the sha256 of\n" +
            "  {url}\n" +
            "which `bazel run //tools/update_flutter_version -- {v}` prints " +
            "along with the rest of the entry."
        ).format(
            v = flutter_version,
            url = flutter_source_tarball_url(flutter_version),
        ))
    return sha256


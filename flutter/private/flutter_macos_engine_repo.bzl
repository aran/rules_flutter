"""Repository rule for macOS Flutter engine alias.

Creates a lightweight repo that aliases to the host platform's engine_library
(FlutterMacOS.framework) from the host artifacts repo. Exposes the release,
debug and profile engines so that flutter_macos_engine() can select() between
them; the profile one lives in the host's lazily fetched profile repo.
Detects host arch at repo-rule time so users can reference a stable
`@flutter_macos_engine` name instead of the host-specific `@flutter_darwin-{arch}`.
"""

def _flutter_macos_engine_repo_impl(repository_ctx):
    # Detect host architecture at repo-rule time.
    arch = repository_ctx.os.arch
    if arch == "arm64" or arch == "aarch64":
        host_arch = "arm64"
    else:
        host_arch = "x64"

    host_repo = repository_ctx.attr.user_repository_name + "_darwin-" + host_arch

    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE.format(
        host_repo = host_repo,
    ))

_BUILD_TEMPLATE = """# Generated by flutter_macos_engine_repo.bzl
# Aliases to the host platform's FlutterMacOS.framework engine libraries.
load("@rules_apple//apple:apple.bzl", "apple_dynamic_framework_import")
load("@rules_flutter//flutter/private:flutter_xtool_bundle.bzl", "flutter_darwin_xcframework_import")

alias(
    name = "engine_library",
    actual = "@{host_repo}//:engine_library",
    visibility = ["//visibility:public"],
)

alias(
    name = "engine_debug_library",
    actual = "@{host_repo}//:engine_debug_library",
    visibility = ["//visibility:public"],
)

alias(
    name = "engine_profile_library",
    actual = "@{host_repo}_profile//:engine_library",
    visibility = ["//visibility:public"],
)

apple_dynamic_framework_import(
    name = "flutter_framework_apple",
    framework_imports = select({{
        "@rules_flutter//flutter/private:dbg": [":engine_debug_library"],
        "@rules_flutter//flutter/private:profile": [":engine_profile_library"],
        "//conditions:default": [":engine_library"],
    }}),
    visibility = ["//visibility:public"],
)

flutter_darwin_xcframework_import(
    name = "flutter_framework_xtool",
    framework_name = "FlutterMacOS",
    xcframework_imports = select({{
        "@rules_flutter//flutter/private:dbg": [":engine_debug_library"],
        "@rules_flutter//flutter/private:profile": [":engine_profile_library"],
        "//conditions:default": [":engine_library"],
    }}),
    visibility = ["//visibility:public"],
)

alias(
    name = "flutter_framework",
    actual = select({{
        "@rules_flutter//flutter/settings:use_xtool_backend": ":flutter_framework_xtool",
        "//conditions:default": ":flutter_framework_apple",
    }}),
    visibility = ["//visibility:public"],
)
"""

flutter_macos_engine_repo = repository_rule(
    _flutter_macos_engine_repo_impl,
    doc = "Creates an alias repo for the macOS Flutter engine (FlutterMacOS.framework).",
    attrs = {
        "user_repository_name": attr.string(
            doc = "Base name for Flutter repos (e.g. 'flutter').",
            mandatory = True,
        ),
    },
)

"""The `libraries.json` that names the dart: libraries Flutter provides.

The engine builds its own libraries spec but does not publish it, and the
bundled Dart SDK's spec has no `flutter` target. Flutter's set is the VM's
common set, less `dart:mirrors` (which the engine refuses to load, even when
nothing reaches the importing library) and plus `dart:ui`.

Only the library names are meaningful. A consumer reads which dart: libraries
a Flutter program may import, to leave out of a compile any library that needs
one Flutter lacks. Compiles resolve dart: libraries from the platform dill and
never read this file.
"""

_DROPPED_LIBRARIES = ["mirrors"]

def _rebase_library(library, prefix):
    rebased = dict(library)
    rebased["uri"] = prefix + library["uri"]
    patches = library.get("patches")
    if type(patches) == "string":
        rebased["patches"] = prefix + patches
    elif patches:
        rebased["patches"] = [prefix + patch for patch in patches]
    return rebased

def flutter_libraries_spec(sdk_spec, sdk_lib_dir):
    """Derives the Flutter libraries spec from the bundled Dart SDK's.

    Args:
        sdk_spec: The decoded `dart-sdk/lib/libraries.json`.
        sdk_lib_dir: The SDK's `lib/` directory relative to the written file,
            with a trailing slash; the SDK's paths are relative to it.

    Returns:
        A dict to encode as `libraries.json`, with a single `flutter` target.
    """
    libraries = {
        name: _rebase_library(library, sdk_lib_dir)
        for name, library in sdk_spec["vm_common"]["libraries"].items()
        if name not in _DROPPED_LIBRARIES
    }

    # dart:ui's source ships in the separate sky_engine artifact; nothing here
    # resolves the URI.
    libraries["ui"] = {"uri": "../sky_engine/lib/ui/ui.dart"}
    return {
        "comment:0": "Generated by rules_flutter from the Dart SDK's libraries.json. " +
                     "Names the dart: libraries a Flutter program can import; not for compiling.",
        "flutter": {"libraries": libraries},
    }

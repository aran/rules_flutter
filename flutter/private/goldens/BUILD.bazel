"""Golden-file comparator for `flutter_test`.

Exports `comparator.dart` for the bootstrap staging in `flutter_test`. Not a
`dart_library`: the source is added to each test's kernel-compile srcs
directly so it resolves `package:flutter_test` through the user's pub-managed
`@deps`, the same arrangement `agent_extensions/agent.dart` uses.
"""

exports_files(
    ["comparator.dart"],
    # Public like rules_dart's `kernel_module` tool and
    # `//flutter/private/tools:kernel_filter`: a rule in another module
    # composing its own test kernel over `@rules_flutter//flutter:utils.bzl`
    # names it through `FLUTTER_TEST_BOOTSTRAP_ATTRS`.
    visibility = ["//visibility:public"],
)

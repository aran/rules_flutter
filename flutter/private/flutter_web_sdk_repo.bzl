"""The repository of the Flutter web SDK.

It holds flutter-web-sdk.zip, which contains the platform dill files web builds
compile against (dart2wasm_platform.dill, dart2js_platform.dill), and beside it
the Dart SDK of the machine Bazel runs on, so that the web SDK's libraries.json
can resolve its `include` of `../dart-sdk/lib/libraries.json` (dart:core,
dart:async, ...).

The Dart SDK archives differ by host (their `lib/_internal` dills are built on
each), so the host is an argument, which the `flutter` extension reads from the
machine it runs on. The repository is a `flutter_archive_repo`: Bazel keeps one
copy of it for each host in its repository contents cache, for every output
base.
"""

load(":archives.bzl", "archive", "archive_repo")
load(":artifact_urls.bzl", "dart_sdk_artifact_path", "engine_artifact_url")

visibility("//flutter/...")

_BUILD_TEMPLATE = """# Generated by flutter_web_sdk_repo.bzl

filegroup(
    name = "web_sdk",
    srcs = glob(["web-sdk/**"]) + glob(["dart-sdk/lib/**"]),
    visibility = ["//visibility:public"],
)

exports_files(
    glob(["web-sdk/**"]) + glob(["dart-sdk/**"]),
    visibility = ["//visibility:public"],
)
"""

def host_platform(os):
    """The engine's name for the machine Bazel runs on, such as `darwin-arm64`.

    Args:
        os: A `repository_os`, from `module_ctx.os` or `repository_ctx.os`.

    Returns:
        The platform, or None on an OS or CPU the engine is not built for.
    """
    name = os.name.lower()
    if "mac" in name:
        prefix = "darwin"
    elif "linux" in name:
        prefix = "linux"
    elif "win" in name:
        prefix = "windows"
    else:
        return None
    if os.arch in ["aarch64", "arm64"]:
        return prefix + "-arm64"
    if os.arch in ["x86_64", "amd64"]:
        return prefix + "-x64"
    return None

def flutter_web_sdk_repo(name, engine_revision, host, sha256 = "", dart_sdk_sha256s = {}):
    """Declares the web SDK of an engine, with the Dart SDK of one host.

    Args:
        name: The repository's name.
        engine_revision: The engine's commit.
        host: The engine's name for the machine Bazel runs on (`darwin-arm64`),
            from `host_platform`, or None where it is not one the engine is
            built for, which fails the fetch.
        sha256: Expected SHA-256 of flutter-web-sdk.zip.
        dart_sdk_sha256s: Host platform to the SHA-256 of its Dart SDK archive.
    """
    if not host:
        # Nothing is downloaded: the check fails the fetch at once.
        archive_repo(
            name = name,
            archives = [],
            checks = [{
                "path": "dart-sdk",
                "message": "The web SDK needs the Dart SDK of the machine Bazel runs on, and Flutter publishes none for this one.",
            }],
            files = {},
        )
        return
    dart_sdk_zip = dart_sdk_artifact_path(host)
    archive_repo(
        name = name,
        archives = [
            archive(
                "flutter-web-sdk.zip",
                engine_artifact_url(engine_revision, "flutter-web-sdk.zip"),
                sha256,
                output = "web-sdk",
            ),
            archive(
                dart_sdk_zip,
                engine_artifact_url(engine_revision, dart_sdk_zip),
                dart_sdk_sha256s.get(host, ""),
                strip_prefix = "dart-sdk",
                output = "dart-sdk",
            ),
        ],
        files = {"BUILD.bazel": _BUILD_TEMPLATE},
    )

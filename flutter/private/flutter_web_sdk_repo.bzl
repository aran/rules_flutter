"""Repository rule for the Flutter web SDK.

Downloads flutter-web-sdk.zip which contains the platform dill files
needed for web builds (dart2wasm_platform.dill, dart2js_platform.dill)
and rewrites web-sdk/libraries.json to reference the shared host Dart SDK.
"""

load(":artifact_urls.bzl", "engine_artifact_url", "require_sha256")

def _detect_host_platform(repository_ctx):
    """Detect the host platform string (e.g. 'darwin-arm64', 'linux-x64')."""
    os_name = repository_ctx.os.name
    arch = repository_ctx.os.arch

    if "mac" in os_name:
        os_prefix = "darwin"
    elif "linux" in os_name:
        os_prefix = "linux"
    elif "win" in os_name:
        os_prefix = "windows"
    else:
        fail("Unsupported host OS: %s" % os_name)

    if arch == "aarch64" or arch == "arm64":
        arch_suffix = "arm64"
    elif arch == "x86_64" or arch == "amd64":
        arch_suffix = "x64"
    else:
        fail("Unsupported host architecture: %s" % arch)

    return os_prefix + "-" + arch_suffix

def _flutter_web_sdk_repo_impl(repository_ctx):
    engine_revision = repository_ctx.attr.engine_revision

    web_url = engine_artifact_url(engine_revision, "flutter-web-sdk.zip")
    repository_ctx.download_and_extract(
        url = web_url,
        sha256 = require_sha256(repository_ctx.attr.sha256, web_url),
        output = "web-sdk",
    )

    host_platform = _detect_host_platform(repository_ctx)
    user_repo_name = repository_ctx.attr.user_repository_name or "flutter"
    host_repo = user_repo_name + "_" + host_platform

    # Derive the sibling host repo's canonical directory name under external/
    # so web-sdk/libraries.json resolves its relative include in both the
    # Bazel sandbox and remote execution without symlinks outside inputs.
    web_repo_basename = repository_ctx.path(".").basename
    if web_repo_basename.endswith("_web_sdk"):
        canonical_host_repo = web_repo_basename[:-len("_web_sdk")] + "_" + host_platform
    elif "+" in web_repo_basename:
        prefix = web_repo_basename.rsplit("+", 1)[0] + "+"
        canonical_host_repo = prefix + host_repo
    else:
        canonical_host_repo = host_repo

    libraries_json_path = repository_ctx.path("web-sdk/libraries.json")
    if libraries_json_path.exists:
        libraries_json = repository_ctx.read(libraries_json_path)
        libraries_json = libraries_json.replace(
            "\"../dart-sdk/",
            "\"../../" + canonical_host_repo + "/dart-sdk/",
        )
        repository_ctx.file("web-sdk/libraries.json", libraries_json)

    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE.format(host_repo = host_repo))

_BUILD_TEMPLATE = """# Generated by flutter_web_sdk_repo.bzl

filegroup(
    name = "web_sdk",
    srcs = glob([
        "web-sdk/canvaskit/**",
        "web-sdk/flutter_js/**",
        "web-sdk/libraries.json",
    ]) + ["@{host_repo}//:dart-sdk/lib/libraries.json"],
    visibility = ["//visibility:public"],
)

alias(
    name = "dart-sdk/lib/dev_compiler/ddc/ddc_module_loader.js",
    actual = "@{host_repo}//:dart-sdk/lib/dev_compiler/ddc/ddc_module_loader.js",
    visibility = ["//visibility:public"],
)

alias(
    name = "dart-sdk/lib/dev_compiler/web/dart_stack_trace_mapper.js",
    actual = "@{host_repo}//:dart-sdk/lib/dev_compiler/web/dart_stack_trace_mapper.js",
    visibility = ["//visibility:public"],
)

exports_files(
    glob(["web-sdk/**"]),
    visibility = ["//visibility:public"],
)
"""

flutter_web_sdk_repo = repository_rule(
    _flutter_web_sdk_repo_impl,
    doc = "Downloads the Flutter web SDK (dart2wasm/dart2js platform dills) and references the shared host Dart SDK.",
    attrs = {
        "engine_revision": attr.string(mandatory = True),
        "sha256": attr.string(doc = "Expected SHA-256 of flutter-web-sdk.zip. Required: an empty value fails the fetch."),
        "user_repository_name": attr.string(
            default = "flutter",
            doc = "Base name for Flutter repositories (e.g. `flutter`).",
        ),
    },
)

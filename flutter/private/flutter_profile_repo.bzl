"""The repositories of the profile-mode engine artifacts.

Profile mode (`-c opt --@rules_flutter//flutter:profile`) needs its own engine
and its own gen_snapshot on every platform: the engine refuses an AOT snapshot
built for another mode ("VM snapshot invalid"). These live in separate repos
from the release and debug artifacts so that a build which never asks for
profile never downloads them; a select() arm that is not taken does not fetch
its repo.
"""

load(":archives.bzl", "archive", "archive_repo")
load(":artifact_urls.bzl", "engine_artifact_url")

visibility("//flutter/...")

def flutter_profile_repo(name, engine_revision, downloads, build_file_content, sha256s = {}):
    """Declares a lazily fetched repository of profile-mode engine artifacts.

    Args:
        name: The repository's name.
        engine_revision: The engine commit the artifacts are published under.
        downloads: Artifact path (relative to the engine revision) to the
            directory to extract it into.
        build_file_content: The repository's `BUILD.bazel`, after a header.
        sha256s: Artifact path to expected SHA-256.
    """
    archive_repo(
        name = name,
        archives = [
            archive(path, engine_artifact_url(engine_revision, path), sha256s.get(path, ""), output = output)
            for path, output in downloads.items()
        ],
        files = {"BUILD.bazel": "# Generated by flutter_profile_repo.bzl\n" + build_file_content},
    )

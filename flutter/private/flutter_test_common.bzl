"""Shared bootstrap and runner wiring for `flutter_test` and `flutter_prebuilt_test`.

Both rules run a test kernel under `flutter_tester` through the same
`flutter_test_runner` binary, the same `FLUTTER_TEST_*` environment contract
and the same runfiles layout. This module holds the one implementation of
that contract: `flutter_test` compiles the kernel it runs while
`flutter_prebuilt_test` runs one built elsewhere, and neither spells the
runner's start-up keys twice.
"""

load("@rules_dart//dart:providers.bzl", "DartInfo")
load("@rules_dart//dart:utils.bzl", "runfiles_path")

def make_bootstrap_content(test_relative_import, golden_comparator_import = None):
    """Generate the per-test bootstrap Dart source.

    The bootstrap is the kernel entry point flutter_tester loads. It calls
    `RemoteListener.start(() => test.main)` to register the user's tests with
    `package:test_api`, then opens a WebSocket back to the harness on
    `FLUTTER_TEST_HARNESS_PORT` and forwards the resulting channel as
    JSON-encoded `[id, data]` tuples (the `package:stream_channel`
    MultiChannel framing the test harness already speaks).

    The golden block is emitted at the same point `flutter test` emits its own
    — inside the `RemoteListener.start` callback, before the user's `main` is
    returned — and, like upstream's, only when the suite actually depends on
    `package:flutter_test`. Upstream guards it with `if (flutterTestDep)` for
    the same reason this takes an import that may be None: a suite carrying
    only `package:test_api` has no `goldenFileComparator` to assign to, and an
    unconditional import would fail its kernel compile over a feature it
    cannot use.

    Args:
        test_relative_import: Path-style import URI from the bootstrap file
            to the user's test source (e.g. `../../e2e/foo/test/widget_test.dart`).
        golden_comparator_import: Import URI for the staged golden comparator,
            or None to emit no golden block (a `test_api`-only suite).

    Returns:
        Dart source string.
    """
    if golden_comparator_import:
        golden_import = "import '{}' as goldens;\n".format(golden_comparator_import)
        golden_install = "    goldens.installBazelGoldenFileComparator();\n"
    else:
        golden_import = ""
        golden_install = ""

    return """// GENERATED by flutter_test — do not edit.
//
// Bootstraps a Flutter widget test under flutter_tester. Connects back to
// the bazel-side harness over WebSocket and drives the test via
// package:test_api/backend.dart RemoteListener — the same surface
// `flutter test` uses.
import 'dart:async';
import 'dart:convert';
import 'dart:io';
import 'dart:isolate';

import 'package:test_api/backend.dart';

import '{test_import}' as test;
{golden_import}
void _catchIsolateErrors() {{
  final errorPort = ReceivePort();
  Isolate.current.setErrorsFatal(false);
  Isolate.current.addErrorListener(errorPort.sendPort);
  errorPort.listen((dynamic message) {{
    final list = message as List;
    final error = IsolateSpawnException(list[0] as String);
    final stack = list[1] == null
        ? StackTrace.empty
        : StackTrace.fromString(list[1] as String);
    Zone.current.handleUncaughtError(error, stack);
  }});
}}

Future<void> _runTestMain() async {{
  await Future(test.main);
}}

Future<void> main() async {{
  final portStr = Platform.environment['FLUTTER_TEST_HARNESS_PORT'];
  if (portStr == null || portStr.isEmpty) {{
    stderr.writeln('flutter_test bootstrap: FLUTTER_TEST_HARNESS_PORT not set');
    exit(64);
  }}
  final port = int.parse(portStr);

  final testChannel = RemoteListener.start(() {{
    _catchIsolateErrors();
{golden_install}    return _runTestMain;
  }});

  // 127.0.0.1 and not `localhost`: deliberately the same address family the
  // harness binds. Read the record on `_Harness.bind` in
  // flutter/private/tools/flutter_test_runner.dart before changing either —
  // the two only make sense together, and changing this one alone is how a
  // dial reaches something other than the harness.
  final ws = await WebSocket.connect('ws://127.0.0.1:$port');
  // Forward harness → testChannel. `pipe` completes when the WebSocket
  // closes; we don't need to await it because the harness side closes the
  // socket once the suite is done.
  unawaited(ws.map<dynamic>((dynamic m) => json.decode(m as String))
      .pipe(testChannel.sink));
  // Forward testChannel events → harness. `addStream` completes when the
  // testChannel's stream is done — that happens after the harness sends
  // a close message and RemoteListener closes the inner controller. At
  // that point we exit the isolate explicitly so flutter_tester shuts
  // down without waiting for the engine to drain its event loop.
  await ws.addStream(testChannel.stream.map<String>((dynamic m) => json.encode(m)));
  exit(0);
}}
""".format(
        test_import = test_relative_import,
        golden_import = golden_import,
        golden_install = golden_install,
    )

def _exposes_package(deps, names):
    """True if any dep transitively exposes one of `names`."""
    for dep in deps:
        if DartInfo not in dep:
            continue
        for pkg in dep[DartInfo].transitive_packages.to_list():
            if pkg.package_name in names:
                return True
    return False

# Two predicates, deliberately not one.
#
# `_can_bootstrap` is what a test rule requires at all: the bootstrap imports
# `package:test_api/backend.dart` for `RemoteListener`, and `package:flutter_test`
# re-exports it, so either package satisfies the compile.
#
# `_has_flutter_test` is narrower and gates only the golden block, which needs
# `goldenFileComparator` and `autoUpdateGoldenFiles` — both `flutter_test`'s.
# Collapsing the two would make a `test_api`-only target (a documented,
# supported configuration) fail its kernel compile on an import it never asked
# for. Upstream draws the same line with its `if (flutterTestDep)` guard.
def can_bootstrap(deps):
    return _exposes_package(deps, ["flutter_test", "test_api"])

def has_flutter_test(deps):
    return _exposes_package(deps, ["flutter_test"])

def flutter_test_bootstrap_action(ctx, test_main_uri, output):
    """Write the bootstrap library a test kernel is compiled from.

    Stages the golden comparator next to `output` (so the bootstrap imports
    it by basename) when the calling target's `deps` expose
    `package:flutter_test`, then writes `output` with `make_bootstrap_content`.
    A `test_api`-only closure gets exactly the bootstrap it got before goldens
    existed: no import, no golden block.

    The caller needs `deps` plus the implicit `_golden_comparator_src` file
    (defaulting to `//flutter/private/goldens:comparator.dart`) for the golden
    block; without either, the bootstrap still works, it just compares no
    goldens. Compile `output` as the kernel entry point — e.g. as `main` to
    `flutter_kernel_compile_action` — and run the resulting dill under
    `flutter_prebuilt_test`.

    Args:
        ctx: The calling rule's context.
        test_main_uri: Import URI from the bootstrap to the test entrypoint
            (e.g. `package:my_app/widget_test.dart`).
        output: The already-declared bootstrap `.dart` File to write.

    Returns:
        The staged golden comparator File, or None when the closure carries
        no `package:flutter_test`. Pass it to the kernel compile alongside
        the bootstrap when present.
    """
    deps = getattr(ctx.attr, "deps", [])
    comparator_src = getattr(ctx.file, "_golden_comparator_src", None)
    staged_comparator = None
    if comparator_src != None and has_flutter_test(deps):
        staged_comparator = ctx.actions.declare_file(
            ctx.label.name + ".golden_comparator.dart",
        )
        ctx.actions.symlink(
            output = staged_comparator,
            target_file = comparator_src,
        )
    ctx.actions.write(output, make_bootstrap_content(
        test_main_uri,
        golden_comparator_import = staged_comparator.basename if staged_comparator else None,
    ))
    return staged_comparator

# Runner-contract keys the test rules reserve for `--test_env` overrides. The
# rules forward `include_tags` / `exclude_tags` under the `_ATTR` names so a
# `--test_env=FLUTTER_TEST_TAGS=...` (or `FLUTTER_TEST_EXCLUDE_TAGS`) value at
# run time overrides the attribute; an `env` entry for any of these is
# rejected in the implementation so the flag stays the one override channel.
_RESERVED_TEST_ENV_KEYS = [
    "FLUTTER_TEST_TAGS",
    "FLUTTER_TEST_EXCLUDE_TAGS",
    "FLUTTER_TEST_TAGS_ATTR",
    "FLUTTER_TEST_EXCLUDE_TAGS_ATTR",
    "FLUTTER_TEST_LIBRARY_TAGS",
]

def _declare_test_executable(ctx):
    """Symlinks the prebuilt runner as the test executable."""
    tool = ctx.attr._tool
    is_windows = ctx.target_platform_has_constraint(
        ctx.attr._windows_constraint[platform_common.ConstraintValueInfo],
    )
    ext = ".exe" if is_windows else ""
    executable = ctx.actions.declare_file(ctx.label.name + ext)
    ctx.actions.symlink(
        output = executable,
        target_file = tool[DefaultInfo].files_to_run.executable,
        is_executable = True,
    )
    return executable, tool

def _base_runner_env(ctx, flutter_sdk_info, dill, assets_dir, base_dill, library_tags, test_path, enable_impeller, include_tags, exclude_tags):
    """Builds the rule-owned `FLUTTER_TEST_*` environment (before user env)."""
    workspace_name = ctx.workspace_name
    env = {
        "FLUTTER_TEST_TESTER": runfiles_path(flutter_sdk_info.flutter_tester, workspace_name),
        "FLUTTER_TEST_ICU": runfiles_path(flutter_sdk_info.icu_data, workspace_name),
        "FLUTTER_TEST_DILL": runfiles_path(dill, workspace_name),
        # Display path for the suite. Used in package:test report output.
        "FLUTTER_TEST_PATH": test_path if test_path else dill.basename,
        "FLUTTER_TEST_IMPELLER": "1" if enable_impeller else "",
    }
    if assets_dir != None:
        env["FLUTTER_TEST_ASSETS"] = runfiles_path(assets_dir, workspace_name)
    if base_dill != None:
        env["FLUTTER_TEST_BASE_DILL"] = runfiles_path(base_dill, workspace_name)

    # Tag selection, as `flutter test --tags` / `--exclude-tags` resolve it.
    # Forwarded under `_ATTR` keys: a `--test_env=FLUTTER_TEST_TAGS=...` (or
    # `FLUTTER_TEST_EXCLUDE_TAGS`) value at run time overrides the attribute,
    # and it can only do that when the rule leaves those keys alone — Bazel
    # lets a rule-set variable win over `--test_env` for the same key. Set
    # only when the attribute names tags.
    if include_tags:
        env["FLUTTER_TEST_TAGS_ATTR"] = ",".join(include_tags)
    if exclude_tags:
        env["FLUTTER_TEST_EXCLUDE_TAGS_ATTR"] = ",".join(exclude_tags)

    # The entrypoint's own `@Tags`, extracted at build time: the runner injects
    # them as the root group's metadata, so they inherit down to every test in
    # the suite. Absent for a prebuilt kernel without library tags, which the
    # runner reads as no tags.
    if library_tags != None:
        env["FLUTTER_TEST_LIBRARY_TAGS"] = runfiles_path(library_tags, workspace_name)
    return env

def _merge_user_env(ctx, env, user_env):
    """Merges user env over the rule env, refusing the rule's own keys.

    The rule's keys are the runner's start-up contract, and a test that
    quietly replaced one would fail far from the cause. The tag keys the
    rule leaves for `--test_env` to override are rejected too, so the flag
    stays the one override channel: an `env` value would bake into the
    target while looking like a run-time choice.
    """
    for key, value in user_env.items():
        if key in env or key in _RESERVED_TEST_ENV_KEYS:
            fail((
                "{label}: env key {key} is set by the rule itself " +
                "and cannot be overridden."
            ).format(label = ctx.label, key = key))
        env[key] = value

def _assemble_test_runfiles(ctx, tool, runtime_files, data, extra_files):
    """Merges kernel/tool/data runfiles for the test run."""
    tool_runfiles = tool[DefaultInfo].default_runfiles
    runfiles = ctx.runfiles(
        files = runtime_files + ctx.files.data + extra_files,
    )
    runfiles = runfiles.merge(tool_runfiles)

    # Merge the runfiles of any `data` targets so cc_library / cc_binary
    # producers (e.g. shared dylibs that the test loads via dart:ffi) and
    # transitively-needed files come along. Mirrors the behavior of
    # rules_dart's dart_binary/dart_test and the standard cc_test/py_test
    # `data` semantics.
    for data_target in data:
        runfiles = runfiles.merge(data_target[DefaultInfo].default_runfiles)
    return runfiles

def flutter_test_runner(
        ctx,
        dill,
        base_dill = None,
        assets_dir = None,
        library_tags = None,
        test_path = "",
        enable_impeller = False,
        include_tags = [],
        exclude_tags = [],
        user_env = {},
        data = [],
        extra_files = []):
    """Set up the shared `flutter_tester` run: executable, env and runfiles.

    The one implementation of the runner contract behind `flutter_test` and
    `flutter_prebuilt_test`: symlinks the prebuilt runner as the test
    executable, builds the `FLUTTER_TEST_*` environment the runner reads at
    start-up, and assembles the runfiles (kernel, engine, ICU data, assets,
    tag file, user `data` plus the tool's own runfiles). The test action's
    cache key is exactly what this names: the kernel dill, the assets tree,
    the runner binary and the env.

    Args:
        ctx: The calling test rule's context. Must declare `_tool` (the
            runner binary) and `_windows_constraint`.
        dill: The test kernel `.dill` File to run.
        base_dill: Optional base dill File the kernel links against at
            run time (`FLUTTER_TEST_BASE_DILL`), or None.
        assets_dir: The `flutter_assets/` tree artifact directory File.
        library_tags: Optional `{"tags": [...]}` JSON File with the suite
            entrypoint's `@Tags`, or None for no library tags.
        test_path: Display path for the suite in `package:test` report
            output. Defaults to the dill's basename.
        enable_impeller: Render with Impeller instead of software Skia.
        include_tags: Run only tests matching every one of these `package:test`
            tag selectors. A `--test_env=FLUTTER_TEST_TAGS=...` value overrides this.
        exclude_tags: Skip tests matching any of these tag selectors. Wins over
            `include_tags`; `--test_env=FLUTTER_TEST_EXCLUDE_TAGS=...`
            overrides this.
        user_env: Extra environment variables for the test process. Values
            are literal; the `FLUTTER_TEST_*` keys the runner reads cannot
            be set here.
        data: `data` targets whose runfiles join the test's.
        extra_files: Additional Files for the test runfiles (e.g. bundled
            native-asset libraries the manifest names).

    Returns:
        A struct with `executable` (the test executable File), `runfiles`
        (the assembled runfiles) and `env` (the `TestEnvironment` provider).
    """
    flutter_toolchain = ctx.toolchains["@rules_flutter//flutter:toolchain_type"]
    flutter_sdk_info = flutter_toolchain.flutter_sdk_info

    if not flutter_sdk_info.flutter_tester:
        fail(
            "a Flutter test requires the active Flutter toolchain to provide a " +
            "flutter_tester binary; the resolved toolchain has none. This is " +
            "typically the case for cross-compile-only configurations — " +
            "build the test target with the host platform.",
        )

    # Symlink the prebuilt runner as the test executable.
    executable, tool = _declare_test_executable(ctx)

    # Runfiles-relative paths the runner reads from env at start-up.
    env = _base_runner_env(ctx, flutter_sdk_info, dill, assets_dir, base_dill, library_tags, test_path, enable_impeller, include_tags, exclude_tags)

    # User-supplied variables, merged last but never over the rule's own keys.
    _merge_user_env(ctx, env, user_env)

    runtime_files = [
        dill,
        flutter_sdk_info.flutter_tester,
        flutter_sdk_info.icu_data,
    ]
    if assets_dir != None:
        runtime_files.append(assets_dir)
    if library_tags != None:
        runtime_files.append(library_tags)
    if base_dill != None:
        runtime_files.append(base_dill)
    runfiles = _assemble_test_runfiles(ctx, tool, runtime_files, data, extra_files)

    return struct(
        executable = executable,
        runfiles = runfiles,
        env = testing.TestEnvironment(env),
    )

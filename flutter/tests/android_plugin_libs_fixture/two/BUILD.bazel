"""Plugin `plugin_two`, which exports two Android libraries: one AAR cannot hold it."""

load("@rules_java//java:java_library.bzl", "java_library")
load("//flutter:defs.bzl", "dart_package_metadata", "flutter_plugin")

package(default_visibility = ["//flutter/tests:__subpackages__"])

java_library(
    name = "lib_one",
    srcs = ["One.java"],
)

java_library(
    name = "lib_two",
    srcs = ["Two.java"],
)

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "plugin_two",
)

flutter_plugin(
    name = "plugin_two",
    srcs = ["lib/plugin_two.dart"],
    package = ":pubspec-metadata",
    tags = ["manual"],
    exports = [
        ":lib_one",
        ":lib_two",
    ],
)

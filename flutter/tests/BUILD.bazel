# Static guards: the download guard discovers every `.bzl` under flutter/
# and every MODULE.bazel at runtime from the workspace root (found through
# the test's own source file in `data`, hence no-sandbox), so there is no
# file list to maintain. The guards read files Bazel does not track as
# their inputs; the `external` tag keeps Bazel from replaying a cached pass
# after an untracked file changed, so each guard re-runs on every
# invocation.
dart_test(
    name = "download_digest_guard_test",
    size = "small",
    data = ["download_digest_guard_test.dart"],
    env = {"GUARD_ROOT_ANCHOR": "$(rlocationpath :download_digest_guard_test.dart)"},
    env_inherit = ["BUILD_WORKSPACE_DIRECTORY"],
    main = "download_digest_guard_test.dart",
    tags = [
        "external",
        "no-sandbox",
    ],
    deps = [
        "@dev_tool_deps//:test",
    ],
)

# Release-archive guard: every e2e workspace except e2e/smoke must be
# export-ignored in .gitattributes. Same discovery mechanism as above.
dart_test(
    name = "e2e_export_ignore_guard_test",
    size = "small",
    data = ["e2e_export_ignore_guard_test.dart"],
    env = {"GUARD_ROOT_ANCHOR": "$(rlocationpath :e2e_export_ignore_guard_test.dart)"},
    env_inherit = ["BUILD_WORKSPACE_DIRECTORY"],
    main = "e2e_export_ignore_guard_test.dart",
    tags = [
        "external",
        "no-sandbox",
    ],
    deps = [
        "@dev_tool_deps//:test",
    ],
)

# Message-formatting guard: no `.format()` call binds to one literal of a
# `+` string join (the placeholders in the other literals would print
# literally). Same discovery mechanism as above.
dart_test(
    name = "format_string_guard_test",
    size = "small",
    data = ["format_string_guard_test.dart"],
    env = {"GUARD_ROOT_ANCHOR": "$(rlocationpath :format_string_guard_test.dart)"},
    env_inherit = ["BUILD_WORKSPACE_DIRECTORY"],
    main = "format_string_guard_test.dart",
    tags = [
        "external",
        "no-sandbox",
    ],
    deps = [
        "@dev_tool_deps//:test",
    ],
)


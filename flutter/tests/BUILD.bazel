# The two web-fixture entrypoints that sit directly in this package (its
# subpackages — `analyze_fixture`, `dart_asset_fixture`, and the rest — carry
# their own `format_test`). Recursive glob because one of the two is under
# `lib/`; it stops at each subpackage's own `BUILD.bazel` regardless.
dart_format_test(
    name = "format_test",
    size = "small",
    srcs = glob(["**/*.dart"]),
    options = "//:analysis_options.yaml",
)

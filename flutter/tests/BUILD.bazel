# Regression: `flutter_aot_target` with obfuscation and split debug info must
# run gen_snapshot successfully and produce the debugging-info output.
flutter_aot_target(
    name = "aot_split_debug_target",
    package_name = "lv_fixture",
    srcs = ["lib/language_version_main.dart"],
    main = "lib/language_version_main.dart",
    obfuscate = True,
    split_debug_info = True,
    target_compatible_with = HOST_COMPATIBLE,
)

build_test(
    name = "aot_split_debug_build_test",
    target_compatible_with = HOST_COMPATIBLE,
    targets = [":aot_split_debug_target"],
)


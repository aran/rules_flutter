load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//flutter:defs.bzl", "flutter_gen_l10n")
load("//flutter/tests:flutter_fonts_test.bzl", "analysis_fails_test")
load("//flutter/tests:gen_l10n_test.bzl", "gen_l10n_outputs_test")

# `es` and `es_419` deliberately both appear: gen-l10n emits one Dart file per
# *primary language subtag*, so these two collapse into a single
# app_localizations_es.dart holding AppLocalizationsEs and AppLocalizationsEs419.
# A rule that declared one output per input arb would promise Bazel a file the
# generator never writes, and this fixture is what catches that.
flutter_gen_l10n(
    name = "l10n",
    arbs = [
        "lib/l10n/app_en.arb",
        "lib/l10n/app_es.arb",
        "lib/l10n/app_es_419.arb",
    ],
    # The path-mapping test reads this target's action.
    visibility = ["//flutter/tests:__pkg__"],
)

build_test(
    name = "gen_l10n_build_test",
    size = "small",
    targets = [":l10n"],
)

# The same arbs written elsewhere, as an `l10n.yaml` with `output-dir:`
# writes them.
flutter_gen_l10n(
    name = "l10n_output_dir",
    arbs = [
        "lib/l10n/app_en.arb",
        "lib/l10n/app_es.arb",
        "lib/l10n/app_es_419.arb",
    ],
    output_dir = "lib/gen_l10n",
)

gen_l10n_outputs_test(
    name = "output_dir_test",
    size = "small",
    expected = [
        "flutter/tests/gen_l10n_fixture/lib/gen_l10n/app_localizations.dart",
        "flutter/tests/gen_l10n_fixture/lib/gen_l10n/app_localizations_en.dart",
        "flutter/tests/gen_l10n_fixture/lib/gen_l10n/app_localizations_es.dart",
    ],
    target_under_test = ":l10n_output_dir",
)

gen_l10n_outputs_test(
    name = "beside_arbs_test",
    size = "small",
    expected = [
        "flutter/tests/gen_l10n_fixture/lib/l10n/app_localizations.dart",
        "flutter/tests/gen_l10n_fixture/lib/l10n/app_localizations_en.dart",
        "flutter/tests/gen_l10n_fixture/lib/l10n/app_localizations_es.dart",
    ],
    target_under_test = ":l10n",
)

# A directory outside the package is refused.
flutter_gen_l10n(
    name = "l10n_outside_package",
    arbs = ["lib/l10n/app_en.arb"],
    output_dir = "../elsewhere",
    tags = ["manual"],
)

analysis_fails_test(
    name = "output_dir_outside_package_test",
    size = "small",
    message = "output_dir must be a directory of the package",
    target_under_test = ":l10n_outside_package",
)

# A second spelling of a directory of the package is refused too, so each
# directory has one.
flutter_gen_l10n(
    name = "l10n_dot_segment",
    arbs = ["lib/l10n/app_en.arb"],
    output_dir = "./lib/gen_l10n",
    tags = ["manual"],
)

analysis_fails_test(
    name = "output_dir_dot_segment_test",
    size = "small",
    message = "output_dir must be a directory of the package",
    target_under_test = ":l10n_dot_segment",
)

flutter_gen_l10n(
    name = "l10n_trailing_slash",
    arbs = ["lib/l10n/app_en.arb"],
    output_dir = "lib/gen_l10n/",
    tags = ["manual"],
)

analysis_fails_test(
    name = "output_dir_trailing_slash_test",
    size = "small",
    message = "output_dir must be a directory of the package",
    target_under_test = ":l10n_trailing_slash",
)

build_test(
    name = "gen_l10n_output_dir_build_test",
    size = "small",
    targets = [":l10n_output_dir"],
)

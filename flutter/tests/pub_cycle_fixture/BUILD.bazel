load("@rules_dart//dart:defs.bzl", "dart_package_metadata")
load("//flutter:defs.bzl", "flutter_plugin_platform")
load("//flutter/private:flutter_pub_library.bzl", "flutter_pub_library", "flutter_pub_member")

package(default_visibility = ["//flutter/tests:__subpackages__"])

# Plugins as the hub builds them: `cycle_a` and `cycle_b`, a dependency
# cycle of pub packages built as one library, and `outside`, which only
# `cycle_b` depends on. `pub_cycle_test.bzl` says what each is held to.

[
    dart_package_metadata(
        name = name + "-metadata",
        package_name = name,
    )
    for name in [
        "cycle_a",
        "cycle_b",
        "outside",
    ]
]

[
    flutter_pub_member(
        name = name + "_member",
        srcs = ["lib/%s.dart" % name],
        package = ":%s-metadata" % name,
        platforms = [":android"],
        tags = ["manual"],
    )
    for name in [
        "cycle_a",
        "cycle_b",
        "outside",
    ]
]

flutter_pub_library(
    name = "outside",
    member_dependencies = {"outside": []},
    members = [":outside_member"],
    tags = ["manual"],
)

# `cycle_a` depends on `cycle_b` alone; `cycle_b` on `cycle_a` and `outside`.
flutter_pub_library(
    name = "cycle",
    member_dependencies = {
        "cycle_a": ["cycle_b"],
        "cycle_b": [
            "cycle_a",
            "outside",
        ],
    },
    members = [
        ":cycle_a_member",
        ":cycle_b_member",
    ],
    tags = ["manual"],
    deps = [":outside"],
)

flutter_plugin_platform(
    name = "android",
    package = "com.example.cycle",
    platform = "android",
    plugin_class = "CyclePlugin",
    tags = ["manual"],
)

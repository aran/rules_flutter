load("@rules_dart//dart:defs.bzl", "dart_library")
load("//flutter:defs.bzl", "dart_package_metadata")

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "shared_a",
    code_assets = ["//flutter/tests/shared_code_asset_fixture:a_own"],
    # Stated, as a pub hub states it, so `a_again` is this package too.
    version = "1.0.0",
)

# A bindings package that declares a standalone library of its own, for its own
# tests. An application can serve its id from another library.
dart_library(
    name = "a",
    srcs = ["lib/a.dart"],
    package = ":pubspec-metadata",
    visibility = ["//flutter/tests:__subpackages__"],
)

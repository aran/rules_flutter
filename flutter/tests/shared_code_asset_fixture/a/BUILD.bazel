load("@rules_dart//dart:defs.bzl", "dart_library")

# A fetcher's declaration, as a pub hub's generated BUILD file loads it.
# buildifier: disable=bzl-visibility
load("@rules_dart//dart/private:fetched_package_metadata.bzl", "fetched_package_metadata")

fetched_package_metadata(
    name = "pubspec-metadata",
    package_name = "shared_a",
    code_assets = ["//flutter/tests/shared_code_asset_fixture:a_own"],
    # Fetched alike, as two pub hubs each fetch one package, so `a_again` is
    # this package too.
    fetched_identity = "pkg:pub/shared_a@1.0.0",
    version = "1.0.0",
)

# A bindings package that declares a standalone library of its own, for its own
# tests. An application can serve its id from another library.
dart_library(
    name = "a",
    srcs = ["lib/a.dart"],
    package = ":pubspec-metadata",
    visibility = ["//flutter/tests:__subpackages__"],
)

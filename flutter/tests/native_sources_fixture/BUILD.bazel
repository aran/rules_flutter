"""Sources for `native_sources_test`: a native library built from checked-in
files, one of its dependencies, one generated file the aspect must leave out,
and the library again behind a wrapper that moves it and as a Dart code
asset."""

load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("@rules_dart//dart:defs.bzl", "dart_code_asset")

package(default_visibility = [
    "//flutter/tests:__pkg__",
    "//flutter/tests/code_asset_fixture:__pkg__",
])

genrule(
    name = "generated",
    outs = ["generated.c"],
    cmd = "echo 'int generated(void) { return 3; }' > $@",
)

cc_library(
    name = "helper",
    srcs = ["helper.c"],
)

cc_library(
    name = "bridge_cc",
    srcs = [
        "bridge.c",
        # A build output: nothing edits it between reloads, and the build that
        # writes it is what the library comparison already sees.
        ":generated",
    ],
    hdrs = ["bridge.h"],
    deps = [":helper"],
)

cc_shared_library(
    name = "bridge",
    deps = [":bridge_cc"],
)

# The library moved under `vendor/lib/` by a wrapper, the way an app bundles one
# that must not sit at its package root. Its sources are the library's own: an
# edit to `bridge.c` changes these bytes as much as the original's.
copy_file(
    name = "vendored_bridge",
    src = ":bridge",
    out = "vendor/lib/libbridge.dylib",
)

# The library as rules_dart's code asset, which takes it as `shared_library`.
dart_code_asset(
    name = "bridge_code_asset",
    asset_id = "package:native_sources_fixture/bridge",
    shared_library = ":bridge",
)

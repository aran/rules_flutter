"""Sources for `native_sources_test`: a native library built from checked-in
files, one of its dependencies, and one generated file the aspect must leave
out."""

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("//flutter/private:common.bzl", "HOST_COMPATIBLE")

package(default_visibility = ["//flutter/tests:__pkg__"])

genrule(
    name = "generated",
    outs = ["generated.c"],
    cmd = "echo 'int generated(void) { return 3; }' > $@",
)

cc_library(
    name = "helper",
    srcs = ["helper.c"],
    target_compatible_with = HOST_COMPATIBLE,
)

cc_library(
    name = "bridge_cc",
    srcs = [
        "bridge.c",
        # A build output: nothing edits it between reloads, and the build that
        # writes it is what the library comparison already sees.
        ":generated",
    ],
    hdrs = ["bridge.h"],
    target_compatible_with = HOST_COMPATIBLE,
    deps = [":helper"],
)

cc_shared_library(
    name = "bridge",
    target_compatible_with = HOST_COMPATIBLE,
    deps = [":bridge_cc"],
)

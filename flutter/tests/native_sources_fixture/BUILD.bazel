"""Sources for `native_sources_test`: a native library built from checked-in
files, one of its dependencies, one generated file the aspect must leave out,
and the library again behind a wrapper that moves it and as a Dart code
asset. `native_link_test` reads the same library's link through those
wrappers and others."""

load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("@rules_dart//dart:defs.bzl", "dart_code_asset")
load(":rust_stand_in.bzl", "rust_stand_in")

package(default_visibility = [
    "//flutter/tests:__pkg__",
    "//flutter/tests/code_asset_fixture:__pkg__",
])

write_file(
    name = "generated",
    out = "generated.c",
    content = [
        "int generated(void) { return 3; }",
        "",
    ],
    newline = "unix",
)

cc_library(
    name = "helper",
    srcs = ["helper.c"],
)

cc_library(
    name = "bridge_cc",
    srcs = [
        "bridge.c",
        # A build output: nothing edits it between reloads, and the build that
        # writes it is what the library comparison already sees.
        ":generated",
    ],
    hdrs = ["bridge.h"],
    deps = [":helper"],
)

cc_shared_library(
    name = "bridge",
    deps = [":bridge_cc"],
)

# The library moved under `vendor/lib/` by a wrapper, the way an app bundles one
# that must not sit at its package root. Its sources are the library's own: an
# edit to `bridge.c` changes these bytes as much as the original's.
copy_file(
    name = "vendored_bridge",
    src = ":bridge",
    out = "vendor/lib/libbridge.dylib",
)

# The library as rules_dart's code asset, which takes it as `file`.
dart_code_asset(
    name = "bridge_code_asset",
    asset_id = "package:native_sources_fixture/bridge",
    file = ":bridge",
)

# For `native_link_test`: the wrappers a library's link is followed through,
# one it is not followed through, and a Rust library's link.

# A filegroup over the copy: two wrappers between the entry and the link.
filegroup(
    name = "bridge_files",
    srcs = [":vendored_bridge"],
)

# A genrule that writes a library from the one it reads: its output need not
# carry the debugging map of what it read, so the link is unknown.
genrule(
    name = "renamed_bridge",
    srcs = [":bridge"],
    outs = ["renamed/libbridge.dylib"],
    cmd = "touch $@",
)

rust_stand_in(
    name = "rust_bridge",
    src = "bridge.c",
    dsym = True,
)

rust_stand_in(
    name = "rust_bridge_without_dsym",
    src = "bridge.c",
    dsym = False,
)

# For `native_libraries_test`: a library that loads `bridge` through
# `dynamic_deps`, and a prebuilt library its `deps` reach, which an app
# bundles beside it; named bare and behind a wrapper. The prebuilt library is
# an empty file, which no linker reads, so the test only analyses them.
cc_import(
    name = "prebuilt",
    shared_library = "prebuilt/libprebuilt.dylib",
    tags = ["manual"],
)

cc_library(
    name = "top_cc",
    srcs = ["top.c"],
    tags = ["manual"],
    deps = [
        ":bridge_cc",
        ":prebuilt",
    ],
)

cc_shared_library(
    name = "top",
    dynamic_deps = [":bridge"],
    tags = ["manual"],
    deps = [":top_cc"],
)

filegroup(
    name = "top_files",
    srcs = [":top"],
    tags = ["manual"],
)

# The Rust library as a code asset, whose objects rules_dart says are gone. The
# stand-in writes a `.dylib`, which a code asset can be only for an Apple
# platform, and the host this is analysed for is macOS there.
dart_code_asset(
    name = "rust_bridge_code_asset",
    asset_id = "package:native_sources_fixture/rust_bridge",
    file = ":rust_bridge_without_dsym",
    target_compatible_with = ["@platforms//os:macos"],
)

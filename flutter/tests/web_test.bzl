def _dump_info_test_impl(ctx):
    """`dump_info` produces a named artifact, and keeps it out of the bundle.

    Three joints: the flag dart2js actually needs, the extraction the bundler
    is told to perform, and the exclusion that stops the same file being
    deployed. The last is the one worth pinning — without it the artifact
    still exists and every other assertion here passes, while every visitor
    downloads a description of the whole program.
    """
    env = analysistest.begin(ctx)
    _assert_argv(
        env,
        _action(env, "FlutterDart2JS"),
        # NOT the bare `--dump-info`, which writes a binary `.info.data`.
        present = ["--stage=dump-info-all"],
    )

    bundle = written_json(env, "_web_bundle_config.json")
    if bundle == None:
        return analysistest.end(env)

    extracts = bundle["extracts"]
    asserts.equals(env, 1, len(extracts), "expected one extract, got %s" % extracts)
    if extracts:
        asserts.true(
            env,
            extracts[0]["src"].endswith("/main.dart.js.info.json"),
            "the extract must name dart2js's own output path, got %r" % extracts[0]["src"],
        )
        asserts.true(
            env,
            extracts[0]["dst"].endswith("_dart2js_info.json"),
            "the extract must land on the declared file, got %r" % extracts[0]["dst"],
        )

    # Asserted to exist before being asserted about: the compile output is
    # copied to the bundle root, and a loop over zero matching entries would
    # pass however the exclusion were configured.
    roots = [e for e in bundle["copy_dirs"] if e["dst"] == "."]
    asserts.equals(env, 1, len(roots), "expected one bundle-root copy_dirs entry")
    for entry in roots:
        asserts.true(
            env,
            "*.info.json" in entry.get("exclude", []),
            "the dump-info JSON must not be deployed: %s" % entry,
        )

    # And it is reachable by name rather than only as a file inside a tree.
    group = analysistest.target_under_test(env)[OutputGroupInfo].dump_info.to_list()
    asserts.equals(env, 1, len(group), "dump_info output group: %s" % group)
    return analysistest.end(env)


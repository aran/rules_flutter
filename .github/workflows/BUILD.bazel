load("@buildifier_prebuilt//:rules.bzl", "buildifier")

buildifier(
    name = "buildifier.check",
    exclude_patterns = [
        "./.git/*",
        # Gitignored scratch checkouts. Linting them means a half-written
        # .bzl in one fails the pre-commit hook of another.
        "./.claude/*",
        "./references/*",
    ],
    lint_mode = "warn",
    mode = "diff",
)
